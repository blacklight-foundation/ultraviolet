|: |= @result
{
    return true
}

#test(name: "coverage order", covers("def.TestName@L28776"), covers("def.TestCoverage@L28791"))
internal procedure sourceNativeNamedCoveredTest() -> bool
|: |= @result
{
    return true
}

#test(covers("req.TestAuthority@L28864"))
internal procedure sourceNativeAuthorityTest(authority: TestAuthority) -> bool
|: |= @result
{
    let time: $Time = authority.time
    let monotonic: $MonotonicTime = time~>monotonic()
    let wall: $WallTime = time~>wall()
    let start: MonotonicInstant = monotonic~>now()
    let end: MonotonicInstant = monotonic~>now()
    let monotonic_resolution: Duration = monotonic~>resolution()
    let elapsed: Outcome<Duration, TimeError> = monotonic~>elapsed(start, end)
    let wall_now: Outcome<UtcInstant, TimeError> = wall~>now_utc()
    let wall_resolution: Outcome<Duration, TimeError> = wall~>resolution()
    return monotonic_resolution.nanoseconds > 0u128 &&
        sourceNativeDurationOutcomeSucceeded(elapsed) &&
        sourceNativeUtcInstantOutcomeSucceeded(wall_now) &&
        sourceNativeDurationOutcomeSucceeded(wall_resolution)
}

#test(covers("req.TestProcedureShape@L28842"))
internal procedure sourceNativeShapeTest() -> bool
|: |= @result
{
    return true
}

#test(covers("conformance.TestAttributeDynamicSemantics@L28884"))
internal procedure sourceNativeDynamicSemanticsTest() -> bool
|: |= @result
{
    return true
}

/// Exercises the Attributes SourceNativeTests reference surface.
public procedure runAttributesSourceNativeTestsReference() -> bool {
    return sourceNativeOrdinaryProcedure() &&
        sourceNativeBareTest() &&
        sourceNativeNamedTest() &&
        sourceNativeCoveredTest() &&
        sourceNativeNamedCoveredTest() &&
        sourceNativeShapeTest() &&
        sourceNativeDynamicSemanticsTest()
}
