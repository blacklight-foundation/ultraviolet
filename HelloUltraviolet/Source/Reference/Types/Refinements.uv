//! Reference specimens for Types / Refinements.

/// Positive integer refinement with a standalone `self` predicate.
public type PositiveI32 = i32 |: { self > 0 }

/// Equivalent positive integer refinement with the same predicate form.
public type PositiveI32Again = i32 |: { self > 0 }

/// Bounded positive integer refinement with a boolean conjunction predicate.
public type BoundedI32 = i32 |: { self > 0 && self < 10 }

/// Nested refinement that normalizes to the bounded positive integer predicate.
public type NestedBoundedI32 = PositiveI32 |: { self < 10 }

internal procedure positiveRefinementReference(value: PositiveI32) -> i32 {
    return value
}

internal procedure boundedRefinementReference(value: BoundedI32) -> i32 {
    return value
}

internal procedure nestedRefinementReference(value: NestedBoundedI32) -> i32 {
    return value
}

internal procedure constrainedParameterRefinementReference(
    value: i32 |: { value > 0 }
) -> i32 {
    return value
}

/// Exercises the Types Refinements reference surface.
public procedure runTypesRefinementsReference() -> bool {
    return true
}
