//! Reference specimens for Parallelism / ParallelBlocks.

internal record GpuSafePayload<TValue> |: GpuSafe(TValue) {
    internal value: TValue
}

internal record ParallelReference {
    internal inline_value: i32
    internal cpu_value: i32
    internal named_value: i32
}

internal procedure parallelReference(
    inline_value: i32,
    cpu_value: i32,
    named_value: i32
) -> ParallelReference {
    return ParallelReference {
        inline_value: inline_value,
        cpu_value: cpu_value,
        named_value: named_value
    }
}

internal procedure parallelReferenceIsCovered(reference: ParallelReference) -> bool {
    return reference.inline_value == 42 &&
        reference.cpu_value == 6 &&
        reference.named_value == 9
}

internal procedure inlineParallelValue(context: Context) -> i32 {
    return parallel context~>inline() {
        40 + 2
    }
}

internal procedure cpuParallelValue(context: Context) -> i32 {
    return parallel context~>cpu() {
        3 + 3
    }
}

internal procedure namedParallelValue(context: Context) -> i32 {
    return parallel context~>inline() [name: "parallel-block-reference"] {
        4 + 5
    }
}

internal procedure optionedParallelValue(context: Context) -> i32 {
    let token: CancelToken@Active = CancelToken::new()
    return parallel context~>inline() [
        name: "parallel-block-options-reference",
        cancel: token,
        workgroup: (1024usize, 1usize, 1usize),
        workgroups: (1usize, 1usize, 1usize),
    ] {
        if token~>is_cancelled() {
            0
        } else {
            16
        }
    }
}

internal procedure domainOrValue(
    context: Context,
    should_return: bool
) -> $ExecutionDomain | i32 {
    if should_return {
        return 29
    }

    return context~>inline()
}

internal procedure parallelBodyControlTarget(context: Context, should_return: bool) -> i32 {
    return parallel context~>inline() {
        if should_return {
            return 23
        }

        5
    }
}

internal procedure parallelDomainControlTarget(context: Context, should_return: bool) -> i32 {
    return parallel domainOrValue(context, should_return)? {
        5
    }
}

internal procedure parallelSpawnInsideBlockValue(context: Context) -> i32 {
    let captured_value: i32 = 8
    return parallel context~>inline() {
        let handle: Spawned<i32> = spawn {
            captured_value + 5
        }
        wait handle
    }
}

internal procedure parallelDispatchInsideBlockValue(context: Context) -> i32 {
    return parallel context~>inline() {
        dispatch index in 0usize..4usize [reduce: +, ordered] {
            index as i32
        }
    }
}

internal procedure parallelBlockWellFormednessReference(context: Context) -> bool {
    return inlineParallelValue(context) == 42 &&
        cpuParallelValue(context) == 6 &&
        namedParallelValue(context) == 9 &&
        optionedParallelValue(context) == 16 &&
        parallelSpawnInsideBlockValue(context) == 13 &&
        parallelDispatchInsideBlockValue(context) == 6
}

internal procedure evalSigmaParallelReference(context: Context) -> bool {
    return inlineParallelValue(context) == 42 &&
        cpuParallelValue(context) == 6
}

internal procedure evalSigmaParallelBodyCtrlReference(context: Context) -> bool {
    return parallelBodyControlTarget(context, false) == 5 &&
        parallelBodyControlTarget(context, true) == 23
}

internal procedure evalSigmaParallelDomainCtrlReference(context: Context) -> bool {
    return parallelDomainControlTarget(context, false) == 5 &&
        parallelDomainControlTarget(context, true) == 29
}

/// Exercises the Parallelism ParallelBlocks reference surface.
public procedure runParallelismParallelBlocksReference(context: Context) -> bool {
    let reference: ParallelReference = parallelReference(
        inlineParallelValue(context),
        cpuParallelValue(context),
        namedParallelValue(context)
    )
    return parallelReferenceIsCovered(reference) &&
        optionedParallelValue(context) == 16 &&
        parallelBlockWellFormednessReference(context) &&
        evalSigmaParallelReference(context) &&
        evalSigmaParallelBodyCtrlReference(context) &&
        evalSigmaParallelDomainCtrlReference(context)
}
