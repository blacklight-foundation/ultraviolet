//! Reference specimens for Parallelism / Dispatch.

internal procedure reducingDispatchReference(context: Context) -> i32 {
    return parallel context~>inline() {
        dispatch index in 0usize..4usize [reduce: +, chunk: 2usize, ordered] {
            index as i32
        }
    }
}

internal procedure keyedDispatchReference(context: Context) -> i32 {
    let partition_key: shared i32 = 7
    return parallel context~>inline() {
        dispatch index in 0usize..4usize key partition_key read [reduce: +, ordered] {
            index as i32
        }
    }
}

internal procedure nonReducingDispatchReference(context: Context) -> bool {
    return parallel context~>inline() {
        dispatch index in 0usize..2usize [ordered] {
            let observed: usize = index
        }
        true
    }
}

internal procedure nonUsizeDispatchIndexReference(context: Context) -> i32 {
    return parallel context~>inline() {
        dispatch index in 0i32..4i32 [reduce: +, ordered] {
            index
        }
    }
}

internal procedure trailingOptionDispatchReference(context: Context) -> i32 {
    return parallel context~>inline() {
        dispatch index in 0usize..3usize [
            reduce: +,
            chunk: 1usize,
            ordered,
        ] {
            index as i32
        }
    }
}

internal procedure dispatchRangeOrValue(should_return: bool) -> Range<usize> | i32 {
    if should_return {
        return 31
    }

    return 0usize..4usize
}

internal procedure dispatchChunkOrValue(should_return: bool) -> usize | i32 {
    if should_return {
        return 37
    }

    return 2usize
}

internal procedure inferredIndexedDispatchReference(context: Context) -> bool {
    var backing: shared [i32; 4] = [0, 0, 0, 0]
    let values: shared [i32] = backing[..]
    parallel context~>inline() {
        dispatch index in 0usize..4usize [ordered] {
            values[index] = index as i32
        }
    }

    var observed: i32 = 0
    %read values[0usize], values[1usize], values[2usize], values[3usize] [ordered] {
        observed = values[0usize] + values[1usize] + values[2usize] + values[3usize]
    }
    return observed == 6
}

internal procedure dispatchReductionAssociativityReference(context: Context) -> bool {
    return reducingDispatchReference(context) == 6 &&
        nonUsizeDispatchIndexReference(context) == 6
}

internal procedure dispatchChunkSemanticsStaticReference(context: Context) -> bool {
    return reducingDispatchReference(context) == 6 &&
        trailingOptionDispatchReference(context) == 3
}

internal procedure evalSigmaDispatchReference(context: Context) -> bool {
    return reducingDispatchReference(context) == 6 &&
        keyedDispatchReference(context) == 6 &&
        nonReducingDispatchReference(context)
}

internal procedure evalSigmaDispatchRangeCtrlReference(context: Context) -> bool {
    return dispatchRangeControlTarget(context, false) == 6 &&
        dispatchRangeControlTarget(context, true) == 31
}

internal procedure evalSigmaDispatchChunkCtrlReference(context: Context) -> bool {
    return dispatchChunkControlTarget(context, false) == 6 &&
        dispatchChunkControlTarget(context, true) == 37
}

internal procedure dispatchRangeControlTarget(context: Context, should_return: bool) -> i32 {
    return parallel context~>inline() {
        dispatch index in dispatchRangeOrValue(should_return)? [reduce: +, ordered] {
            index as i32
        }
    }
}

internal procedure dispatchChunkControlTarget(context: Context, should_return: bool) -> i32 {
    return parallel context~>inline() {
        dispatch index in 0usize..4usize [
            reduce: +,
            chunk: dispatchChunkOrValue(should_return)?,
            ordered
        ] {
            index as i32
        }
    }
}

/// Exercises the Parallelism Dispatch reference surface.
public procedure runParallelismDispatchReference(context: Context) -> bool {
    return reducingDispatchReference(context) == 6 &&
        keyedDispatchReference(context) == 6 &&
        nonReducingDispatchReference(context) &&
        nonUsizeDispatchIndexReference(context) == 6 &&
        trailingOptionDispatchReference(context) == 3 &&
        inferredIndexedDispatchReference(context) &&
        dispatchReductionAssociativityReference(context) &&
        dispatchChunkSemanticsStaticReference(context) &&
        evalSigmaDispatchReference(context) &&
        evalSigmaDispatchRangeCtrlReference(context) &&
        evalSigmaDispatchChunkCtrlReference(context)
}
