//! Reference specimens for DataTypes / TypeAliases.

public type ReferenceCount = usize
public type ReferenceRecordAlias = RecordReference

public procedure referenceCount(value: usize) -> ReferenceCount {
    return value
}

internal procedure sizeAliasReference() -> bool {
    return sizeof(ReferenceCount) == sizeof(usize) &&
        sizeof(ReferenceRecordAlias) == sizeof(RecordReference)
}

internal procedure alignAliasReference() -> bool {
    return alignof(ReferenceCount) == alignof(usize) &&
        alignof(ReferenceRecordAlias) == alignof(RecordReference)
}

internal procedure layoutAliasReference() -> bool {
    return sizeAliasReference() && alignAliasReference()
}

/// Exercises the DataTypes TypeAliases reference surface.
public procedure runDataTypesTypeAliasesReference() -> bool {
    let count: ReferenceCount = referenceCount(5usize)
    let alias_value: ReferenceRecordAlias = recordReference("alias", count, true)
    return alias_value.is_active &&
        alias_value.count == 5usize &&
        sizeAliasReference() &&
        alignAliasReference() &&
        layoutAliasReference()
}
