//! Reference specimens for Authority / BuiltinTypeNames.

internal type BuiltinIOCapabilityName = $IO

internal type BuiltinOpenReadResultName = Outcome<File@Read, IoError>

internal type BuiltinOpenWriteResultName = Outcome<File@Write, IoError>

internal type BuiltinOpenAppendResultName = Outcome<File@Append, IoError>

internal type BuiltinOpenDirResultName = Outcome<DirIter@Open, IoError>

internal type BuiltinDirEntryName = DirEntry

internal type BuiltinFileReadName = File@Read

internal type BuiltinDirIterOpenName = DirIter@Open

internal type BuiltinFileKindName = FileKind

internal type BuiltinIoErrorName = IoError

internal type BuiltinAllocationErrorName = AllocationError

internal type BuiltinTimeErrorName = TimeError

internal type BuiltinDurationName = Duration

internal type BuiltinMonotonicInstantName = MonotonicInstant

internal type BuiltinUtcInstantName = UtcInstant

internal type BuiltinContextName = Context

internal type BuiltinSystemName = $System

internal type BuiltinCpuSetName = CpuSet

internal type BuiltinPriorityName = Priority

internal procedure ioErrorVariantIsKnown(error: BuiltinIoErrorName) -> bool {
    return if error is {
        IoError::NotFound {
            true
        }
        IoError::PermissionDenied {
            true
        }
        IoError::AlreadyExists {
            true
        }
        IoError::InvalidPath {
            true
        }
        IoError::Busy {
            true
        }
        IoError::IoFailure {
            true
        }
        IoError::DirectoryNotEmpty {
            true
        }
    }
}

internal procedure fileKindVariantIsKnown(kind: BuiltinFileKindName) -> bool {
    return if kind is {
        FileKind::File {
            true
        }
        FileKind::Dir {
            true
        }
        FileKind::Other {
            true
        }
    }
}

internal procedure allocationErrorVariantIsKnown(error: BuiltinAllocationErrorName) -> bool {
    return if error is {
        AllocationError::OutOfMemory(size) {
            size == 1usize
        }
        AllocationError::QuotaExceeded(size) {
            size == 2usize
        }
    }
}

internal procedure timeErrorVariantIsKnown(error: BuiltinTimeErrorName) -> bool {
    return if error is {
        TimeError::Unsupported {
            true
        }
        TimeError::ClockUnavailable {
            true
        }
        TimeError::OutOfRange {
            true
        }
        TimeError::InvalidResolution {
            true
        }
        TimeError::ClockMismatch {
            true
        }
    }
}

internal procedure priorityVariantIsKnown(priority: BuiltinPriorityName) -> bool {
    return if priority is {
        Priority::Low {
            true
        }
        Priority::Normal {
            true
        }
        Priority::High {
            true
        }
    }
}

internal procedure timeErrorDeclarationObserved() -> bool {
    return timeErrorVariantIsKnown(TimeError::Unsupported) &&
        timeErrorVariantIsKnown(TimeError::ClockUnavailable) &&
        timeErrorVariantIsKnown(TimeError::OutOfRange) &&
        timeErrorVariantIsKnown(TimeError::InvalidResolution) &&
        timeErrorVariantIsKnown(TimeError::ClockMismatch)
}

internal procedure durationDeclarationObserved() -> bool {
    let duration: BuiltinDurationName = Duration { nanoseconds: 7u128 }
    return duration.nanoseconds == 7u128
}

internal procedure utcInstantDeclarationObserved() -> bool {
    let instant: BuiltinUtcInstantName = UtcInstant { unix_nanoseconds: 0i128 }
    return instant.unix_nanoseconds == 0i128
}

internal procedure monotonicInstantDeclarationObserved(
    instant: BuiltinMonotonicInstantName
) -> bool {
    let _ = instant
    return sizeof(BuiltinMonotonicInstantName) > 0usize
}

internal procedure allocationErrorDeclarationObserved() -> bool {
    return allocationErrorVariantIsKnown(AllocationError::OutOfMemory(1usize)) &&
        allocationErrorVariantIsKnown(AllocationError::QuotaExceeded(2usize))
}

internal procedure priorityDeclarationObserved() -> bool {
    return priorityVariantIsKnown(Priority::Low) &&
        priorityVariantIsKnown(Priority::Normal) &&
        priorityVariantIsKnown(Priority::High)
}

internal procedure ioCapabilityCanSeePath(
    io: BuiltinIOCapabilityName,
    path: string@View
) -> bool {
    return io~>exists(path)
}

internal procedure builtinFileReadObserved(
    move result: Outcome<unique BuiltinFileReadName, BuiltinIoErrorName>
) -> bool {
    return if move result is {
        @Value { value } {
            let text: Outcome<unique string@Managed, BuiltinIoErrorName> =
                value~>read_all()
            let closed: File@Closed = value~>close()
            let _ = closed
            readableTextObserved(move text)
        }
        @Error { error } {
            ioErrorVariantIsKnown(error)
        }
    }
}

internal procedure builtinDirIterObserved(
    move result: Outcome<unique BuiltinDirIterOpenName, BuiltinIoErrorName>
) -> bool {
    return if move result is {
        @Value { value } {
            let first: Outcome<BuiltinDirEntryName | (), BuiltinIoErrorName> =
                value~>next()
            let closed: DirIter@Closed = value~>close()
            let _ = closed
            return if first is {
                @Value { value: first_value } {
                    return if first_value is {
                        entry: BuiltinDirEntryName {
                            string::length(string::as_view(entry.name)) > 0usize &&
                                string::length(string::as_view(entry.path)) > 0usize &&
                                fileKindVariantIsKnown(entry.kind)
                        }
                        empty: () {
                            false
                        }
                    }
                }
                @Error { error } {
                    ioErrorVariantIsKnown(error)
                }
            }
        }
        @Error { error } {
            ioErrorVariantIsKnown(error)
        }
    }
}

internal procedure readableTextObserved(
    move result: Outcome<unique string@Managed, BuiltinIoErrorName>
) -> bool {
    return if move result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            string::length(text) > 0usize
        }
        @Error { error } {
            ioErrorVariantIsKnown(error)
        }
    }
}

internal procedure missingTextObserved(
    move result: Outcome<unique string@Managed, BuiltinIoErrorName>
) -> bool {
    return if move result is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorVariantIsKnown(error)
        }
    }
}

internal procedure durationIsResolved(duration: BuiltinDurationName) -> bool {
    return duration.nanoseconds >= 0u128
}

internal procedure elapsedOutcomeObserved(
    result: Outcome<BuiltinDurationName, BuiltinTimeErrorName>
) -> bool {
    return if result is {
        @Value { value } {
            durationIsResolved(value)
        }
        @Error { error } {
            timeErrorVariantIsKnown(error)
        }
    }
}

internal procedure wallInstantOutcomeObserved(
    result: Outcome<BuiltinUtcInstantName, BuiltinTimeErrorName>
) -> bool {
    return if result is {
        @Value {
            true
        }
        @Error { error } {
            timeErrorVariantIsKnown(error)
        }
    }
}

internal procedure wallCoarsenOutcomeObserved(
    result: Outcome<$WallTime, BuiltinTimeErrorName>
) -> bool {
    return if result is {
        @Value {
            true
        }
        @Error { error } {
            timeErrorVariantIsKnown(error)
        }
    }
}

internal procedure builtinSystemDeclarationObserved(sys: BuiltinSystemName) -> bool {
    return string::length(sys~>current_directory()) > 0usize
}

internal procedure builtinContextDeclarationObserved(context: BuiltinContextName) -> bool {
    let sys: BuiltinSystemName = context.sys
    let affinity: BuiltinCpuSetName = 1u64
    let priority: BuiltinPriorityName = Priority::Normal
    let domain: $ExecutionDomain = context~>cpu(affinity, priority)
    let _ = context.io
    let _ = context.net
    let _ = context.heap
    let _ = context.reactor
    let _ = context.time
    return builtinSystemDeclarationObserved(sys) &&
        priorityVariantIsKnown(priority) &&
        string::length(domain~>name()) > 0usize
}

/// Exercises the Authority built-in IO and time type-name surface.
public procedure runAuthorityBuiltinTypeNamesReference(context: BuiltinContextName) -> bool {
    let io: BuiltinIOCapabilityName = context.io
    let readable: Outcome<unique string@Managed, BuiltinIoErrorName> = io~>read_file(
        "HelloUltraviolet/Source/Reference/Authority/Time.uv"
    )
    let open_read: Outcome<unique BuiltinFileReadName, BuiltinIoErrorName> =
        io~>open_read("HelloUltraviolet/Source/Reference/Authority/Time.uv")
    let open_dir: Outcome<unique BuiltinDirIterOpenName, BuiltinIoErrorName> =
        io~>open_dir("HelloUltraviolet/Source/Reference/Authority")
    let missing: Outcome<unique string@Managed, BuiltinIoErrorName> = io~>read_file(
        "HelloUltraviolet/Source/Reference/Authority/__MissingBuiltinTypeNames.uv"
    )

    let monotonic: $MonotonicTime = context.time~>monotonic()
    let wall: $WallTime = context.time~>wall()
    let start: BuiltinMonotonicInstantName = monotonic~>now()
    let end: BuiltinMonotonicInstantName = monotonic~>now()
    let resolution: BuiltinDurationName = monotonic~>resolution()
    let elapsed: Outcome<BuiltinDurationName, BuiltinTimeErrorName> =
        monotonic~>elapsed(start, end)
    let wall_now: Outcome<BuiltinUtcInstantName, BuiltinTimeErrorName> =
        wall~>now_utc()
    let coarsened_wall: Outcome<$WallTime, BuiltinTimeErrorName> =
        wall~>coarsen(resolution)

    return ioCapabilityCanSeePath(io, "HelloUltraviolet") &&
        readableTextObserved(move readable) &&
        builtinFileReadObserved(move open_read) &&
        builtinDirIterObserved(move open_dir) &&
        missingTextObserved(move missing) &&
        fileKindVariantIsKnown(FileKind::File) &&
        fileKindVariantIsKnown(FileKind::Dir) &&
        fileKindVariantIsKnown(FileKind::Other) &&
        ioErrorVariantIsKnown(IoError::DirectoryNotEmpty) &&
        allocationErrorDeclarationObserved() &&
        timeErrorDeclarationObserved() &&
        durationDeclarationObserved() &&
        monotonicInstantDeclarationObserved(start) &&
        utcInstantDeclarationObserved() &&
        priorityDeclarationObserved() &&
        builtinContextDeclarationObserved(context) &&
        durationIsResolved(resolution) &&
        elapsedOutcomeObserved(elapsed) &&
        wallInstantOutcomeObserved(wall_now) &&
        wallCoarsenOutcomeObserved(coarsened_wall)
}
