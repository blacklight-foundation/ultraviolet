//! Reference specimens for Authority / System.

internal record SystemAuthorityReference {
    internal can_read_environment: bool
    internal can_spawn_process: bool
    internal requires_capability: bool
}

internal procedure systemAuthorityReference(
    can_read_environment: bool,
    can_spawn_process: bool,
    requires_capability: bool
) -> SystemAuthorityReference {
    return SystemAuthorityReference {
        can_read_environment: can_read_environment,
        can_spawn_process: can_spawn_process,
        requires_capability: requires_capability
    }
}

internal procedure systemAuthorityCanObserveHost(
    reference: SystemAuthorityReference
) -> bool {
    return reference.requires_capability &&
        (reference.can_read_environment || reference.can_spawn_process)
}

internal procedure systemExecutablePathIsAvailable(sys: System) -> bool {
    let executable_path: string@View = sys~>executable_path()
    return string::length(executable_path) > 0usize
}

internal procedure systemMissingEnvironmentIsEmpty(sys: System) -> bool {
    let missing_value: string@View =
        sys~>get_env("HUV_REFERENCE_ENVIRONMENT_KEY_SHOULD_NOT_EXIST")
    return auditTextEquals(missing_value, "")
}

internal procedure systemCurrentDirectoryIsAvailable(sys: System) -> bool {
    let current_directory: string@View = sys~>current_directory()
    return string::length(current_directory) > 0usize
}

internal procedure systemArgumentSurfaceIsAvailable(sys: System) -> bool {
    let count: usize = sys~>argument_count()
    if count == 0usize {
        return true
    }
    let first_argument: string@View = sys~>argument(0usize)
    return string::length(first_argument) > 0usize
}

/// Exercises the Authority System reference surface.
public procedure runAuthoritySystemReference(context: Context) -> bool {
    let environment: SystemAuthorityReference =
        systemAuthorityReference(true, false, true)
    let process: SystemAuthorityReference =
        systemAuthorityReference(false, true, true)
    return systemAuthorityCanObserveHost(environment) &&
        systemAuthorityCanObserveHost(process) &&
        systemExecutablePathIsAvailable(context.sys) &&
        systemMissingEnvironmentIsEmpty(context.sys) &&
        systemCurrentDirectoryIsAvailable(context.sys) &&
        systemArgumentSurfaceIsAvailable(context.sys)
}
