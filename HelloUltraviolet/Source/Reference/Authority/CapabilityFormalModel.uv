//! Reference models for authority capability and observable-behavior obligations.

internal record CapabilityTokenSetReference {
    internal has_io: bool
    internal has_network: bool
    internal has_heap_allocator: bool
    internal has_reactor: bool
    internal has_execution_domain: bool
    internal has_system: bool
    internal has_time: bool
}

internal record SequencePointReference {
    internal prior_effects_complete: bool
    internal later_effects_unstarted: bool
    internal machine_state_determined: bool
}

internal record CanonicalSequencePointSetReference {
    internal after_terminated_statement: bool
    internal before_callee_entry: bool
    internal after_logical_left_operand: bool
    internal after_if_condition: bool
    internal after_if_is_scrutinee: bool
    internal before_key_block_acquire_or_commit: bool
    internal before_scope_cleanup: bool
}

internal enum ObservableEffectReferenceKind {
    Host
    Ffi
    Panic
    Drop
    Key
}

internal enum ObservableOutcomeReferenceKind {
    Normal
    Panic
    Abort
}

internal procedure observableEffectIsHost(
    value: ObservableEffectReferenceKind
) -> bool {
    return if value is ObservableEffectReferenceKind::Host { true } else { false }
}

internal procedure observableEffectIsFfi(
    value: ObservableEffectReferenceKind
) -> bool {
    return if value is ObservableEffectReferenceKind::Ffi { true } else { false }
}

internal procedure observableEffectIsPanic(
    value: ObservableEffectReferenceKind
) -> bool {
    return if value is ObservableEffectReferenceKind::Panic { true } else { false }
}

internal procedure observableEffectIsDrop(
    value: ObservableEffectReferenceKind
) -> bool {
    return if value is ObservableEffectReferenceKind::Drop { true } else { false }
}

internal procedure observableEffectIsKey(
    value: ObservableEffectReferenceKind
) -> bool {
    return if value is ObservableEffectReferenceKind::Key { true } else { false }
}

internal procedure observableOutcomeIsNormal(
    value: ObservableOutcomeReferenceKind
) -> bool {
    return if value is ObservableOutcomeReferenceKind::Normal { true } else { false }
}

internal procedure observableOutcomeIsPanic(
    value: ObservableOutcomeReferenceKind
) -> bool {
    return if value is ObservableOutcomeReferenceKind::Panic { true } else { false }
}

internal procedure observableOutcomeIsAbort(
    value: ObservableOutcomeReferenceKind
) -> bool {
    return if value is ObservableOutcomeReferenceKind::Abort { true } else { false }
}

internal procedure capabilityTokenSetReference(
    has_io: bool,
    has_network: bool,
    has_heap_allocator: bool,
    has_reactor: bool,
    has_execution_domain: bool,
    has_system: bool,
    has_time: bool
) -> CapabilityTokenSetReference {
    return CapabilityTokenSetReference {
        has_io: has_io,
        has_network: has_network,
        has_heap_allocator: has_heap_allocator,
        has_reactor: has_reactor,
        has_execution_domain: has_execution_domain,
        has_system: has_system,
        has_time: has_time
    }
}

internal procedure capabilityTokenSetEmptyReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, false, false, false, false, false, false)
}

internal procedure capabilityTokenSetUnionReference(
    left: CapabilityTokenSetReference,
    right: CapabilityTokenSetReference
) -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(
        left.has_io || right.has_io,
        left.has_network || right.has_network,
        left.has_heap_allocator || right.has_heap_allocator,
        left.has_reactor || right.has_reactor,
        left.has_execution_domain || right.has_execution_domain,
        left.has_system || right.has_system,
        left.has_time || right.has_time
    )
}

internal procedure capabilityTokenSetEqualsReference(
    left: CapabilityTokenSetReference,
    right: CapabilityTokenSetReference
) -> bool {
    return left.has_io == right.has_io &&
        left.has_network == right.has_network &&
        left.has_heap_allocator == right.has_heap_allocator &&
        left.has_reactor == right.has_reactor &&
        left.has_execution_domain == right.has_execution_domain &&
        left.has_system == right.has_system &&
        left.has_time == right.has_time
}

internal procedure capabilityTokenSetSubsetReference(
    left: CapabilityTokenSetReference,
    right: CapabilityTokenSetReference
) -> bool {
    return (!left.has_io || right.has_io) &&
        (!left.has_network || right.has_network) &&
        (!left.has_heap_allocator || right.has_heap_allocator) &&
        (!left.has_reactor || right.has_reactor) &&
        (!left.has_execution_domain || right.has_execution_domain) &&
        (!left.has_system || right.has_system) &&
        (!left.has_time || right.has_time)
}

internal procedure capabilityTokenSetCountReference(
    value: CapabilityTokenSetReference
) -> usize {
    var count: usize = 0usize
    if value.has_io {
        count = count + 1usize
    }
    if value.has_network {
        count = count + 1usize
    }
    if value.has_heap_allocator {
        count = count + 1usize
    }
    if value.has_reactor {
        count = count + 1usize
    }
    if value.has_execution_domain {
        count = count + 1usize
    }
    if value.has_system {
        count = count + 1usize
    }
    if value.has_time {
        count = count + 1usize
    }
    return count
}

internal procedure capabilityRootContextReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(true, true, true, true, true, true, true)
}

internal procedure capabilityRootIOReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(true, false, false, false, false, false, false)
}

internal procedure capabilityRootNetworkReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, true, false, false, false, false, false)
}

internal procedure capabilityRootHeapReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, false, true, false, false, false, false)
}

internal procedure capabilityRootReactorReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, false, false, true, false, false, false)
}

internal procedure capabilityRootExecutionDomainReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, false, false, false, true, false, false)
}

internal procedure capabilityRootSystemReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, false, false, false, false, true, false)
}

internal procedure capabilityRootTimeReference() -> CapabilityTokenSetReference {
    return capabilityTokenSetReference(false, false, false, false, false, false, true)
}

public procedure capabilityTokenUniverseReference() -> bool {
    let tokens: CapabilityTokenSetReference = capabilityRootContextReference()
    return capabilityTokenSetCountReference(tokens) == 7usize &&
        tokens.has_io &&
        tokens.has_network &&
        tokens.has_heap_allocator &&
        tokens.has_reactor &&
        tokens.has_execution_domain &&
        tokens.has_system &&
        tokens.has_time
}

public procedure capInTypeSignatureReference() -> bool {
    let empty: CapabilityTokenSetReference = capabilityTokenSetEmptyReference()
    let io_only: CapabilityTokenSetReference = capabilityRootIOReference()
    return capabilityTokenSetCountReference(empty) == 0usize &&
        capabilityTokenSetCountReference(io_only) == 1usize &&
        io_only.has_io
}

public procedure capInTypeRootMappingsReference() -> bool {
    return capabilityTokenSetEqualsReference(
        capabilityRootContextReference(),
        capabilityTokenSetReference(true, true, true, true, true, true, true)
    ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootSystemReference(),
            capabilityTokenSetReference(false, false, false, false, false, true, false)
        ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootIOReference(),
            capabilityTokenSetReference(true, false, false, false, false, false, false)
        ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootNetworkReference(),
            capabilityTokenSetReference(false, true, false, false, false, false, false)
        ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootHeapReference(),
            capabilityTokenSetReference(false, false, true, false, false, false, false)
        ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootReactorReference(),
            capabilityTokenSetReference(false, false, false, true, false, false, false)
        ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootExecutionDomainReference(),
            capabilityTokenSetReference(false, false, false, false, true, false, false)
        ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootTimeReference(),
            capabilityTokenSetReference(false, false, false, false, false, false, true)
        )
}

public procedure capInTypePermissionReference() -> bool {
    return capabilityTokenSetEqualsReference(
        capabilityRootIOReference(),
        capabilityRootIOReference()
    ) &&
        capabilityTokenSetEqualsReference(
            capabilityRootContextReference(),
            capabilityRootContextReference()
        )
}

public procedure capInTypeStructuralCollectionsReference() -> bool {
    let tuple_tokens: CapabilityTokenSetReference = capabilityTokenSetUnionReference(
        capabilityRootIOReference(),
        capabilityRootSystemReference()
    )
    let array_tokens: CapabilityTokenSetReference = capabilityRootNetworkReference()
    let slice_tokens: CapabilityTokenSetReference = capabilityRootHeapReference()
    return capabilityTokenSetEqualsReference(
        tuple_tokens,
        capabilityTokenSetReference(true, false, false, false, false, true, false)
    ) &&
        capabilityTokenSetEqualsReference(array_tokens, capabilityRootNetworkReference()) &&
        capabilityTokenSetEqualsReference(slice_tokens, capabilityRootHeapReference())
}

public procedure capInTypeStructuralNominalReference(context: Context) -> bool {
    let composite_tokens: CapabilityTokenSetReference = capabilityRootContextReference()
    return capabilityStructuralTypeRequirements(context) &&
        capabilityTokenSetEqualsReference(
            composite_tokens,
            capabilityTokenSetReference(true, true, true, true, true, true, true)
        )
}

public procedure capInTypeLeastFixedPointAllowedReference(context: Context) -> bool {
    let carrier: CapabilityRecursiveCarrier = CapabilityRecursiveCarrier {
        io: context.io,
        next: null
    }
    return capabilityFromRecursiveNominal(carrier) &&
        capabilityTokenSetEqualsReference(
            capabilityRootIOReference(),
            capabilityTokenSetReference(true, false, false, false, false, false, false)
        )
}

public procedure capInTypeCyclesTerminateReference(context: Context) -> bool {
    let recursive_carrier: CapabilityRecursiveCarrier = CapabilityRecursiveCarrier {
        io: context.io,
        next: null
    }
    return capabilityFromRecursiveNominal(recursive_carrier)
}

public procedure capabilityRequirementSetReference(context: Context) -> bool {
    let source_requirement: CapabilityTokenSetReference = capabilityRootContextReference()
    let io_requirement: CapabilityTokenSetReference = capabilityRootIOReference()
    let composite_requirement: CapabilityTokenSetReference = capabilityRootContextReference()
    return capabilityTokenSetSubsetReference(io_requirement, source_requirement) &&
        capabilityTokenSetSubsetReference(composite_requirement, source_requirement) &&
        capabilityDirectCallRequirementsSatisfied(context)
}

internal procedure cancelTokenChildOperationalReference() -> bool {
    let token: CancelToken@Active = CancelToken::new()
    let child: CancelToken@Active = token~>child()
    token~>cancel()
    return child~>is_cancelled()
}

internal procedure cancelTokenChildDropDoesNotDiminishParentReference() -> bool {
    let token: CancelToken@Active = CancelToken::new()
    let child_observed: bool = {
        let child: CancelToken@Active = token~>child()
        !child~>is_cancelled()
    }
    token~>cancel()
    return child_observed && token~>is_cancelled()
}

public procedure attenuationOperationsReference(context: Context) -> bool {
    return capabilityIOCanAttenuate(context.io) &&
        authorityNetworkRestrictionRuntimeStateReference(context) &&
        capabilityHeapCanAttenuate(context.heap) &&
        capabilityContextAttenuationOperations(context) &&
        capabilityTimeCanAttenuate(context.time) &&
        cancelTokenChildOperationalReference()
}

public procedure attenuationMonotoneAuthorityReference(context: Context) -> bool {
    return capabilityIOCanAttenuate(context.io) &&
        authorityNetworkRestrictionRuntimeStateReference(context) &&
        capabilityHeapCanAttenuate(context.heap) &&
        capabilityTimeCanAttenuate(context.time) &&
        capabilityContextAttenuationOperations(context) &&
        cancelTokenChildOperationalReference()
}

public procedure attenuationChildLivenessReference(context: Context) -> bool {
    return capabilityIOCanAttenuate(context.io) &&
        authorityNetworkRestrictionRuntimeStateReference(context) &&
        capabilityHeapCanAttenuate(context.heap) &&
        capabilityTimeCanAttenuate(context.time) &&
        capabilityContextAttenuationOperations(context) &&
        cancelTokenChildOperationalReference()
}

public procedure attenuationChildDropDoesNotDiminishParentReference(
    context: Context
) -> bool {
    return capabilityIOCanAttenuate(context.io) &&
        capabilityNetworkCanAttenuate(context.net) &&
        capabilityHeapCanAttenuate(context.heap) &&
        capabilityTimeCanAttenuate(context.time) &&
        capabilityContextAttenuationOperations(context) &&
        cancelTokenChildDropDoesNotDiminishParentReference()
}

public procedure attenuationDelegationSubsetRoutingReference(context: Context) -> bool {
    return capabilityIOCanAttenuate(context.io) &&
        authorityNetworkRestrictionRuntimeStateReference(context) &&
        capabilityHeapCanAttenuate(context.heap) &&
        capabilityTimeCanAttenuate(context.time) &&
        capabilityContextAttenuationOperations(context) &&
        cancelTokenChildOperationalReference()
}

public procedure observableEffectVariantsReference() -> bool {
    let host: ObservableEffectReferenceKind = ObservableEffectReferenceKind::Host
    let ffi: ObservableEffectReferenceKind = ObservableEffectReferenceKind::Ffi
    let panic: ObservableEffectReferenceKind = ObservableEffectReferenceKind::Panic
    let drop: ObservableEffectReferenceKind = ObservableEffectReferenceKind::Drop
    let key: ObservableEffectReferenceKind = ObservableEffectReferenceKind::Key
    return observableEffectIsHost(host) &&
        observableEffectIsFfi(ffi) &&
        observableEffectIsPanic(panic) &&
        observableEffectIsDrop(drop) &&
        observableEffectIsKey(key)
}

public procedure observableEventDefinitionReference() -> bool {
    return observableEffectVariantsReference()
}

public procedure observableBehaviorDefinitionReference() -> bool {
    let normal: ObservableOutcomeReferenceKind = ObservableOutcomeReferenceKind::Normal
    let panic: ObservableOutcomeReferenceKind = ObservableOutcomeReferenceKind::Panic
    let abort: ObservableOutcomeReferenceKind = ObservableOutcomeReferenceKind::Abort
    return observableEffectVariantsReference() &&
        observableOutcomeIsNormal(normal) &&
        observableOutcomeIsPanic(panic) &&
        observableOutcomeIsAbort(abort)
}

public procedure sequencePointDefinitionReference() -> bool {
    let point: SequencePointReference = SequencePointReference {
        prior_effects_complete: true,
        later_effects_unstarted: true,
        machine_state_determined: true
    }
    return point.prior_effects_complete &&
        point.later_effects_unstarted &&
        point.machine_state_determined
}

public procedure canonicalSequencePointsReference() -> bool {
    let points: CanonicalSequencePointSetReference =
        CanonicalSequencePointSetReference {
            after_terminated_statement: true,
            before_callee_entry: true,
            after_logical_left_operand: true,
            after_if_condition: true,
            after_if_is_scrutinee: true,
            before_key_block_acquire_or_commit: true,
            before_scope_cleanup: true
        }
    return points.after_terminated_statement &&
        points.before_callee_entry &&
        points.after_logical_left_operand &&
        points.after_if_condition &&
        points.after_if_is_scrutinee &&
        points.before_key_block_acquire_or_commit &&
        points.before_scope_cleanup
}

public procedure sequencePointLTRPreservationReference(context: Context) -> bool {
    return capabilityObservableSequenceReference(context)
}

public procedure asIfObservablePreservationReference(context: Context) -> bool {
    return observableBehaviorDefinitionReference() &&
        sequencePointDefinitionReference() &&
        canonicalSequencePointsReference() &&
        capabilityObservableSequenceReference(context)
}

public procedure asIfForbiddenObservableChangesReference(context: Context) -> bool {
    return asIfObservablePreservationReference(context) &&
        sequencePointLTRPreservationReference(context)
}
