//! Reference specimens for Authority / IO.

using HelloUltraviolet::Audit::{ auditTextEquals }

internal record IOAuthorityReference {
    internal can_read: bool
    internal can_write: bool
    internal requires_capability: bool
}

internal procedure ioAuthorityReference(
    can_read: bool,
    can_write: bool,
    requires_capability: bool
) -> IOAuthorityReference {
    return IOAuthorityReference {
        can_read: can_read,
        can_write: can_write,
        requires_capability: requires_capability
    }
}

internal procedure ioAuthorityCanObserveHost(
    reference: IOAuthorityReference
) -> bool {
    return reference.requires_capability && (reference.can_read || reference.can_write)
}

internal procedure ioUnitSucceeded(result: Outcome<(), IoError>) -> bool {
    return if result is {
        @Value {
            true
        }
        @Error {
            false
        }
    }
}

internal procedure ioErrorIsInvalidPath(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            true
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioErrorIsNotFound(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            true
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioErrorIsPermissionDenied(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            true
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioErrorIsAlreadyExists(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            true
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioErrorIsDirectoryNotEmpty(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            true
        }
    }
}

internal procedure ioErrorIsBusy(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            true
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioErrorIsIoFailure(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            true
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioOutcomeErrorIsInvalidPath<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsInvalidPath(error)
        }
    }
}

internal procedure ioOutcomeErrorIsNotFound<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsNotFound(error)
        }
    }
}

internal procedure ioOutcomeErrorIsPermissionDenied<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsPermissionDenied(error)
        }
    }
}

internal procedure ioOutcomeErrorIsAlreadyExists<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsAlreadyExists(error)
        }
    }
}

