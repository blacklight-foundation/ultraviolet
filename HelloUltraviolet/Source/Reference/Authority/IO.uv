internal procedure ioErrorIsBusy(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            true
        }
        IoError::IoFailure {
            false
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal procedure ioErrorIsIoFailure(error: IoError) -> bool {
    return if error is {
        IoError::NotFound {
            false
        }
        IoError::PermissionDenied {
            false
        }
        IoError::AlreadyExists {
            false
        }
        IoError::InvalidPath {
            false
        }
        IoError::Busy {
            false
        }
        IoError::IoFailure {
            true
        }
        IoError::DirectoryNotEmpty {
            false
        }
    }
}

internal enum IOPathFailureReference {
    None
    PermissionDenied
    Busy
    OtherFailure
}

internal record IOPathPredicateReference {
    internal is_invalid: bool
    internal exists: bool
    internal failure: IOPathFailureReference
}

internal procedure ioPathPredicateReference(
    is_invalid: bool,
    exists: bool,
    failure: IOPathFailureReference
) -> IOPathPredicateReference {
    return IOPathPredicateReference {
        is_invalid: is_invalid,
        exists: exists,
        failure: failure
    }
}

internal procedure ioPathPredicatePermissionDeniedReference(
    value: IOPathPredicateReference
) -> bool {
    return if value.failure is IOPathFailureReference::PermissionDenied {
        true
    } else {
        false
    }
}

internal procedure ioPathPredicateBusyReference(
    value: IOPathPredicateReference
) -> bool {
    return if value.failure is IOPathFailureReference::Busy {
        true
    } else {
        false
    }
}

internal procedure ioPathPredicateOtherFailureReference(
    value: IOPathPredicateReference
) -> bool {
    return if value.failure is IOPathFailureReference::OtherFailure {
        true
    } else {
        false
    }
}

internal procedure ioOutcomeErrorIsInvalidPath<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsInvalidPath(error)
        }
    }
}

internal procedure ioOutcomeErrorIsNotFound<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsNotFound(error)
        }
    }
}

internal procedure ioOutcomeErrorIsPermissionDenied<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsPermissionDenied(error)
        }
    }
}

internal procedure ioOutcomeErrorIsAlreadyExists<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsAlreadyExists(error)
        }
    }
}

internal procedure ioOutcomeErrorIsBusy<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsBusy(error)
        }
    }
}

internal procedure ioOutcomeErrorIsDirectoryNotEmpty<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsDirectoryNotEmpty(error)
        }
    }
}

internal procedure ioOutcomeErrorIsIoFailure<TValue>(
    move outcome: Outcome<TValue, IoError>
) -> bool {
    return if move outcome is {
        @Value {
            false
        }
        @Error { error } {
            ioErrorIsIoFailure(error)
        }
    }
}

internal procedure ioTextEquals(
    move result: Outcome<unique string@Managed, IoError>,
    expected: string@View
) -> bool {
    return if move result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            auditTextEquals(text, expected)
        }
        @Error {
            false
        }
    }
}

internal procedure ioBytesLengthEquals(
    move result: Outcome<unique bytes@Managed, IoError>,
    expected: usize
) -> bool {
    return if move result is {
        @Value { value } {
            let view: bytes@View = bytes::as_view(value)
            bytes::length(view) == expected
        }
        @Error {
            false
        }
    }
}

internal procedure ioFileKindIsFile(result: Outcome<FileKind, IoError>) -> bool {
    return if result is {
        @Value { value } {
            return if value is {
                FileKind::File {
                    true
                }
                FileKind::Dir {
                    false
                }
                FileKind::Other {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure ioFileKindIsDir(result: Outcome<FileKind, IoError>) -> bool {
    return if result is {
        @Value { value } {
            return if value is {
                FileKind::File {
                    false
                }
                FileKind::Dir {
                    true
                }
                FileKind::Other {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure ioFileKindIsOther(result: Outcome<FileKind, IoError>) -> bool {
    return if result is {
        @Value { value } {
            return if value is {
                FileKind::File {
                    false
                }
                FileKind::Dir {
                    false
                }
                FileKind::Other {
                    true
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleTextEquals(
    move result: Outcome<unique File@Read, IoError>,
    expected: string@View
) -> bool {
    return if move result is {
        @Value { value } {
            let read_result: Outcome<unique string@Managed, IoError> = value~>read_all()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioTextEquals(move read_result, expected)
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleTextFailsWithIoFailure(
    move result: Outcome<unique File@Read, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let read_result: Outcome<unique string@Managed, IoError> = value~>read_all()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioOutcomeErrorIsIoFailure(move read_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleClosedTextFailsWithIoFailure(
    move result: Outcome<unique File@Read, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let handle: usize =
                unsafe { transmute<unique File@Read, usize>(move value) }
            // Unsafe harness only: the handle came from this file value, is closed
            // through the real transition, and is reused only on this thread to
            // verify the runtime closed-handle error path.
            let close_target: unique File@Read =
                unsafe { transmute<usize, unique File@Read>(handle) }
            let closed: File@Closed = close_target~>close()
            let _ = closed
            let stale: unique File@Read =
                unsafe { transmute<usize, unique File@Read>(handle) }
            let read_result: Outcome<unique string@Managed, IoError> =
                stale~>read_all()
            ioOutcomeErrorIsIoFailure(move read_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleBytesLengthEquals(
    move result: Outcome<unique File@Read, IoError>,
    expected: usize
) -> bool {
    return if move result is {
        @Value { value } {
            let read_result: Outcome<unique bytes@Managed, IoError> =
                value~>read_all_bytes()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioBytesLengthEquals(move read_result, expected)
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleTextAdvancesToEnd(
    move result: Outcome<unique File@Read, IoError>,
    expected: string@View
) -> bool {
    return if move result is {
        @Value { value } {
            let first_result: Outcome<unique string@Managed, IoError> =
                value~>read_all()
            let second_result: Outcome<unique string@Managed, IoError> =
                value~>read_all()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioTextEquals(move first_result, expected) &&
                ioTextEquals(move second_result, "")
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleBytesAdvancesToEnd(
    move result: Outcome<unique File@Read, IoError>,
    expected: usize
) -> bool {
    return if move result is {
        @Value { value } {
            let first_result: Outcome<unique bytes@Managed, IoError> =
                value~>read_all_bytes()
            let second_result: Outcome<unique bytes@Managed, IoError> =
                value~>read_all_bytes()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioBytesLengthEquals(move first_result, expected) &&
                ioBytesLengthEquals(move second_result, 0usize)
        }
        @Error {
            false
        }
    }
}

internal procedure ioReadHandleClosedBytesFailsWithIoFailure(
    move result: Outcome<unique File@Read, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let handle: usize =
                unsafe { transmute<unique File@Read, usize>(move value) }
            // Unsafe harness only: the handle came from this file value, is closed
            // through the real transition, and is reused only on this thread to
            // verify the runtime closed-handle error path.
            let close_target: unique File@Read =
                unsafe { transmute<usize, unique File@Read>(handle) }
            let closed: File@Closed = close_target~>close()
            let _ = closed
            let stale: unique File@Read =
                unsafe { transmute<usize, unique File@Read>(handle) }
            let read_result: Outcome<unique bytes@Managed, IoError> =
                stale~>read_all_bytes()
            ioOutcomeErrorIsIoFailure(move read_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioWriteHandleAcceptsPayload(
    move result: Outcome<unique File@Write, IoError>,
    payload: string@View
) -> bool {
    return if move result is {
        @Value { value } {
            let payload_view: bytes@View = bytes::view_string(payload)
            let write_result: Outcome<(), IoError> = value~>write(payload_view)
            let flush_result: Outcome<(), IoError> = value~>flush()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioUnitSucceeded(write_result) && ioUnitSucceeded(flush_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioWriteHandleClosedOperationsFailWithIoFailure(
    move result: Outcome<unique File@Write, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let handle: usize =
                unsafe { transmute<unique File@Write, usize>(move value) }
            // Unsafe harness only: the handle came from this file value, is closed
            // through the real transition, and is reused only on this thread to
            // verify the runtime closed-handle error path.
            let close_target: unique File@Write =
                unsafe { transmute<usize, unique File@Write>(handle) }
            let closed: File@Closed = close_target~>close()
            let _ = closed
            let stale: unique File@Write =
                unsafe { transmute<usize, unique File@Write>(handle) }
            let payload: bytes@View = bytes::view_string("closed")
            let write_result: Outcome<(), IoError> = stale~>write(payload)
            let flush_result: Outcome<(), IoError> = stale~>flush()
            ioOutcomeErrorIsIoFailure(move write_result) &&
                ioOutcomeErrorIsIoFailure(move flush_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioWriteHandleBusyWhileOpen(
    io: $IO,
    path: string@View
) -> bool {
    let created: Outcome<unique File@Write, IoError> = io~>create_write(path)
    return if move created is {
        @Value { value } {
            let blocked: Outcome<unique File@Write, IoError> = io~>open_write(path)
            let closed: File@Closed = value~>close()
            let _ = closed
            ioOutcomeErrorIsBusy(move blocked)
        }
        @Error {
            false
        }
    }
}

internal procedure ioWriteHandlePositionAndLengthReference(
    io: $IO,
    path: string@View
) -> bool {
    let created: Outcome<unique File@Write, IoError> = io~>create_write(path)
    return if move created is {
        @Value { value } {
            let first_payload: bytes@View = bytes::view_string("abc")
            let second_payload: bytes@View = bytes::view_string("def")
            let first_write: Outcome<(), IoError> = value~>write(first_payload)
            let second_write: Outcome<(), IoError> = value~>write(second_payload)
            let flush_result: Outcome<(), IoError> = value~>flush()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioUnitSucceeded(first_write) &&
                ioUnitSucceeded(second_write) &&
                ioUnitSucceeded(flush_result) &&
                ioTextEquals(io~>read_file(path), "abcdef") &&
                ioBytesLengthEquals(io~>read_bytes(path), 6usize)
        }
        @Error {
            false
        }
    }
}

internal procedure ioOtherEntryRemoveReference(
    sys: System,
    io: $IO,
    target_root: string@View,
    target_child_path: string@View,
    link_path: string@View
) -> bool {
    let _ = io~>remove(link_path)
    let _ = io~>remove(target_child_path)
    let _ = io~>remove(target_root)

    let target_ready: Outcome<(), IoError> = io~>ensure_dir(target_root)
    let target_child_ready: Outcome<(), IoError> =
        io~>write_file(target_child_path, bytes::view_string("junction-target"))
    let target_profile: string@View = auditTargetProfile(sys)
    let create_other_command: string@View =
        if auditTargetProfileIsWindows(target_profile) {
            "cmd /C mklink /J HelloUltraviolet\\Build\\IOOtherLink HelloUltraviolet\\Build\\IOOtherTarget >NUL"
        } else {
            "ln -s HelloUltraviolet/Build/IOOtherTarget HelloUltraviolet/Build/IOOtherLink"
        }
    let command_status: i32 = sys~>run(create_other_command)
    let kind_other: bool = ioFileKindIsOther(io~>kind(link_path))
    let remove_link: Outcome<(), IoError> = io~>remove(link_path)
    let link_removed: bool = !io~>exists(link_path)
    let target_survived: bool = io~>exists(target_child_path)
    let remove_target_child: Outcome<(), IoError> = io~>remove(target_child_path)
    let remove_target_root: Outcome<(), IoError> = io~>remove(target_root)

    return ioUnitSucceeded(target_ready) &&
        ioUnitSucceeded(target_child_ready) &&
        command_status == 0 &&
        kind_other &&
        ioUnitSucceeded(remove_link) &&
        link_removed &&
        target_survived &&
        ioUnitSucceeded(remove_target_child) &&
        ioUnitSucceeded(remove_target_root)
}

internal procedure ioAppendHandleAcceptsPayload(
    move result: Outcome<unique File@Append, IoError>,
    payload: string@View
) -> bool {
    return if move result is {
        @Value { value } {
            let payload_view: bytes@View = bytes::view_string(payload)
            let write_result: Outcome<(), IoError> = value~>write(payload_view)
            let flush_result: Outcome<(), IoError> = value~>flush()
            let closed: File@Closed = value~>close()
            let _ = closed
            ioUnitSucceeded(write_result) && ioUnitSucceeded(flush_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioAppendHandleClosedOperationsFailWithIoFailure(
    move result: Outcome<unique File@Append, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let handle: usize =
                unsafe { transmute<unique File@Append, usize>(move value) }
            // Unsafe harness only: the handle came from this file value, is closed
            // through the real transition, and is reused only on this thread to
            // verify the runtime closed-handle error path.
            let close_target: unique File@Append =
                unsafe { transmute<usize, unique File@Append>(handle) }
            let closed: File@Closed = close_target~>close()
            let _ = closed
            let stale: unique File@Append =
                unsafe { transmute<usize, unique File@Append>(handle) }
            let payload: bytes@View = bytes::view_string("closed")
            let write_result: Outcome<(), IoError> = stale~>write(payload)
            let flush_result: Outcome<(), IoError> = stale~>flush()
            ioOutcomeErrorIsIoFailure(move write_result) &&
                ioOutcomeErrorIsIoFailure(move flush_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioDirEntryNameEquals(
    result: Outcome<DirEntry | (), IoError>,
    expected: string@View
) -> bool {
    return if result is {
        @Value { value } {
            return if value is {
                entry: DirEntry {
                    let name: string@View = string::as_view(entry.name)
                    auditTextEquals(name, expected)
                }
                empty_value: () {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure ioDirEntryIsEnd(result: Outcome<DirEntry | (), IoError>) -> bool {
    return if result is {
        @Value { value } {
            return if value is {
                entry: DirEntry {
                    false
                }
                empty_value: () {
                    true
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure ioDirIterClosedNextFailsWithIoFailure(
    move result: Outcome<unique DirIter@Open, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let handle: usize =
                unsafe { transmute<unique DirIter@Open, usize>(move value) }
            // Unsafe harness only: the handle came from this iterator value, is
            // closed through the real transition, and is reused only on this
            // thread to verify the runtime closed-iterator error path.
            let close_target: unique DirIter@Open =
                unsafe { transmute<usize, unique DirIter@Open>(handle) }
            let closed: DirIter@Closed = close_target~>close()
            let _ = closed
            let stale: unique DirIter@Open =
                unsafe { transmute<usize, unique DirIter@Open>(handle) }
            let next_result: Outcome<DirEntry | (), IoError> = stale~>next()
            ioOutcomeErrorIsIoFailure(move next_result)
        }
        @Error {
            false
        }
    }
}

internal procedure ioDirectoryIterationReference(
    move result: Outcome<unique DirIter@Open, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let first: Outcome<DirEntry | (), IoError> = value~>next()
            let second: Outcome<DirEntry | (), IoError> = value~>next()
            let third: Outcome<DirEntry | (), IoError> = value~>next()
            let end: Outcome<DirEntry | (), IoError> = value~>next()
            let closed: DirIter@Closed = value~>close()
            let _ = closed
            ioDirEntryNameEquals(first, "IOA.txt") &&
                ioDirEntryNameEquals(second, "IOB.txt") &&
                ioDirEntryNameEquals(third, "IOC.txt") &&
                ioDirEntryIsEnd(end)
        }
        @Error {
            false
        }
    }
}

internal procedure ioDirectoryOrderingReference(
    move result: Outcome<unique DirIter@Open, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let first: Outcome<DirEntry | (), IoError> = value~>next()
            let second: Outcome<DirEntry | (), IoError> = value~>next()
            let third: Outcome<DirEntry | (), IoError> = value~>next()
            let end: Outcome<DirEntry | (), IoError> = value~>next()
            let closed: DirIter@Closed = value~>close()
            let _ = closed
            ioDirEntryNameEquals(first, "OrderA.txt") &&
                ioDirEntryNameEquals(second, "OrderB.txt") &&
                ioDirEntryNameEquals(third, "OrderC.txt") &&
                ioDirEntryIsEnd(end)
        }
        @Error {
            false
        }
    }
}

internal procedure ioDirectorySnapshotAfterRemovalReference(
    io: $IO,
    root: string@View,
    snapshot_path: string@View
) -> bool {
    let opened: Outcome<unique DirIter@Open, IoError> = io~>open_dir(root)
    let removed: Outcome<(), IoError> = io~>remove(snapshot_path)

    return if move opened is {
        @Value { value } {
            let first: Outcome<DirEntry | (), IoError> = value~>next()
            let end: Outcome<DirEntry | (), IoError> = value~>next()
            let closed: DirIter@Closed = value~>close()
            let _ = closed
            ioUnitSucceeded(removed) &&
                ioDirEntryNameEquals(first, "Snapshot.txt") &&
                ioDirEntryIsEnd(end)
        }
        @Error {
            false
        }
    }
}

internal procedure ioPrimitiveOpenDirReachesEnd(
    move result: Outcome<unique DirIter@Open, IoError>
) -> bool {
    return if move result is {
        @Value { value } {
            let first: Outcome<DirEntry | (), IoError> = value~>next()
            let closed: DirIter@Closed = value~>close()
            let _ = closed
            ioDirEntryIsEnd(first)
        }
        @Error {
            false
        }
    }
}

internal procedure ioPrimitiveOpenDirReadsSingleEntry(
    move result: Outcome<unique DirIter@Open, IoError>,
    expected_name: string@View
) -> bool {
    return if move result is {
        @Value { value } {
            let first: Outcome<DirEntry | (), IoError> = value~>next()
            let end: Outcome<DirEntry | (), IoError> = value~>next()
            let closed: DirIter@Closed = value~>close()
            let _ = closed
            ioDirEntryNameEquals(first, expected_name) &&
                ioDirEntryIsEnd(end)
        }
        @Error {
            false
        }
    }
}

public procedure authorityIOPrimitiveCallsReference(context: Context) -> bool {
    let io: $IO = context.io
    let root: string@View = "HelloUltraviolet/Build/IOPrimitiveReference"
    let file_path: string@View =
        "HelloUltraviolet/Build/IOPrimitiveReference/Payload.txt"
    let handle_path: string@View =
        "HelloUltraviolet/Build/IOPrimitiveReference/Handle.txt"
    let dir_path: string@View =
        "HelloUltraviolet/Build/IOPrimitiveReference/Directory"

    let _ = io~>remove(file_path)
    let _ = io~>remove(handle_path)
    let _ = io~>remove(dir_path)
    let _ = io~>remove(root)

    let create_root: Outcome<(), IoError> = io~>ensure_dir(root)
    let payload: bytes@View = bytes::view_string("primitive-io")
    let write_file: Outcome<(), IoError> = io~>write_file(file_path, payload)
    let exists_after_write: bool = io~>exists(file_path)
    let read_file: Outcome<unique string@Managed, IoError> = io~>read_file(file_path)
    let read_bytes: Outcome<unique bytes@Managed, IoError> = io~>read_bytes(file_path)
    let kind_file: Outcome<FileKind, IoError> = io~>kind(file_path)

    let create_write: bool = ioWriteHandleAcceptsPayload(
        io~>create_write(handle_path),
        "open-write"
    )
    let open_write: bool = ioWriteHandleAcceptsPayload(
        io~>open_write(handle_path),
        "open-write"
    )
    let open_append: bool = ioAppendHandleAcceptsPayload(
        io~>open_append(handle_path),
        "-append"
    )
    let open_read: bool = ioReadHandleTextEquals(
        io~>open_read(handle_path),
        "open-write-append"
    )

    let create_dir: Outcome<(), IoError> = io~>create_dir(dir_path)
    let ensure_dir: Outcome<(), IoError> = io~>ensure_dir(dir_path)
    let kind_dir: Outcome<FileKind, IoError> = io~>kind(dir_path)
    let open_dir: bool = ioPrimitiveOpenDirReachesEnd(io~>open_dir(dir_path))

    let write_stdout: Outcome<(), IoError> = io~>write_stdout("")
    let write_stderr: Outcome<(), IoError> = io~>write_stderr("")

    let restricted: $IO = io~>restrict(root)
    let restricted_exists: bool = restricted~>exists("Payload.txt") &&
        !restricted~>exists("../README.md")

    let remove_file: Outcome<(), IoError> = io~>remove(file_path)
    let file_removed: bool = !io~>exists(file_path)
    let remove_handle: Outcome<(), IoError> = io~>remove(handle_path)
    let remove_dir: Outcome<(), IoError> = io~>remove(dir_path)
    let remove_root: Outcome<(), IoError> = io~>remove(root)

    return ioUnitSucceeded(create_root) &&
        ioUnitSucceeded(write_file) &&
        exists_after_write &&
        ioTextEquals(move read_file, "primitive-io") &&
        ioBytesLengthEquals(move read_bytes, 12usize) &&
        ioFileKindIsFile(kind_file) &&
        create_write &&
        open_write &&
        open_append &&
        open_read &&
        ioUnitSucceeded(create_dir) &&
        ioUnitSucceeded(ensure_dir) &&
        ioFileKindIsDir(kind_dir) &&
        open_dir &&
        ioUnitSucceeded(write_stdout) &&
        ioUnitSucceeded(write_stderr) &&
        restricted_exists &&
        ioUnitSucceeded(remove_file) &&
        file_removed &&
        ioUnitSucceeded(remove_handle) &&
        ioUnitSucceeded(remove_dir) &&
        ioUnitSucceeded(remove_root)
}

public procedure authorityFileDirPrimitiveCallsReference(context: Context) -> bool {
    let io: $IO = context.io
    let root: string@View = "HelloUltraviolet/Build/FileDirPrimitiveReference"
    let read_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/Read.txt"
    let write_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/Write.txt"
    let append_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/Append.txt"
    let write_closed_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/WriteClosed.txt"
    let append_closed_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/AppendClosed.txt"
    let dir_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/Directory"
    let dir_child_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/Directory/Entry.txt"
    let closed_dir_path: string@View =
        "HelloUltraviolet/Build/FileDirPrimitiveReference/ClosedDirectory"

    let _ = io~>remove(read_path)
    let _ = io~>remove(write_path)
    let _ = io~>remove(append_path)
    let _ = io~>remove(write_closed_path)
    let _ = io~>remove(append_closed_path)
    let _ = io~>remove(dir_child_path)
    let _ = io~>remove(dir_path)
    let _ = io~>remove(closed_dir_path)
    let _ = io~>remove(root)

    let create_root: Outcome<(), IoError> = io~>ensure_dir(root)
    let read_ready: Outcome<(), IoError> =
        io~>write_file(read_path, bytes::view_string("readable"))
    let read_all_text: bool =
        ioReadHandleTextAdvancesToEnd(io~>open_read(read_path), "readable")
    let read_all_bytes: bool =
        ioReadHandleBytesAdvancesToEnd(io~>open_read(read_path), 8usize)
    let close_read_blocks: bool =
        ioReadHandleClosedTextFailsWithIoFailure(io~>open_read(read_path))

    let write_result: bool =
        ioWriteHandleAcceptsPayload(io~>create_write(write_path), "write")
    let write_observed: bool = ioTextEquals(io~>read_file(write_path), "write")
    let write_closed_ready: Outcome<(), IoError> =
        io~>write_file(write_closed_path, bytes::view_string(""))
    let close_write_blocks: bool = ioUnitSucceeded(write_closed_ready) &&
        ioWriteHandleClosedOperationsFailWithIoFailure(io~>open_write(write_closed_path))

    let append_base: bool =
        ioWriteHandleAcceptsPayload(io~>create_write(append_path), "base")
    let append_result: bool =
        ioAppendHandleAcceptsPayload(io~>open_append(append_path), "-tail")
    let append_observed: bool =
        ioTextEquals(io~>read_file(append_path), "base-tail")
    let append_closed_ready: Outcome<(), IoError> =
        io~>write_file(append_closed_path, bytes::view_string("append"))
    let close_append_blocks: bool = ioUnitSucceeded(append_closed_ready) &&
        ioAppendHandleClosedOperationsFailWithIoFailure(io~>open_append(append_closed_path))

    let create_dir: Outcome<(), IoError> = io~>create_dir(dir_path)
    let create_dir_child: Outcome<(), IoError> =
        io~>write_file(dir_child_path, bytes::view_string("entry"))
    let dir_next_and_close: bool =
        ioPrimitiveOpenDirReadsSingleEntry(io~>open_dir(dir_path), "Entry.txt")
    let create_closed_dir: Outcome<(), IoError> = io~>create_dir(closed_dir_path)
    let close_dir_blocks: bool =
        ioDirIterClosedNextFailsWithIoFailure(io~>open_dir(closed_dir_path))

    let remove_read: Outcome<(), IoError> = io~>remove(read_path)
    let remove_write: Outcome<(), IoError> = io~>remove(write_path)
    let remove_append: Outcome<(), IoError> = io~>remove(append_path)
    let remove_write_closed: Outcome<(), IoError> = io~>remove(write_closed_path)
    let remove_append_closed: Outcome<(), IoError> = io~>remove(append_closed_path)
    let remove_dir_child: Outcome<(), IoError> = io~>remove(dir_child_path)
    let remove_dir: Outcome<(), IoError> = io~>remove(dir_path)
    let remove_closed_dir: Outcome<(), IoError> = io~>remove(closed_dir_path)
    let remove_root: Outcome<(), IoError> = io~>remove(root)

    return ioUnitSucceeded(create_root) &&
        ioUnitSucceeded(read_ready) &&
        read_all_text &&
        read_all_bytes &&
        close_read_blocks &&
        write_result &&
        write_observed &&
        close_write_blocks &&
        append_base &&
        append_result &&
        append_observed &&
        close_append_blocks &&
        ioUnitSucceeded(create_dir) &&
        ioUnitSucceeded(create_dir_child) &&
        dir_next_and_close &&
        ioUnitSucceeded(create_closed_dir) &&
        close_dir_blocks &&
        ioUnitSucceeded(remove_read) &&
        ioUnitSucceeded(remove_write) &&
        ioUnitSucceeded(remove_append) &&
        ioUnitSucceeded(remove_write_closed) &&
        ioUnitSucceeded(remove_append_closed) &&
        ioUnitSucceeded(remove_dir_child) &&
        ioUnitSucceeded(remove_dir) &&
        ioUnitSucceeded(remove_closed_dir) &&
        ioUnitSucceeded(remove_root)
}

public procedure authorityIOFileHandleSemanticsReference(context: Context) -> bool {
    let io: $IO = context.io
    let root: string@View = "HelloUltraviolet/Build/IOFileHandleReference"
    let read_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/Read.txt"
    let write_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/Write.txt"
    let append_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/Append.txt"
    let position_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/Position.txt"
    let invalid_utf8_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/InvalidUtf8.bin"
    let write_closed_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/WriteClosed.txt"
    let append_closed_path: string@View =
        "HelloUltraviolet/Build/IOFileHandleReference/AppendClosed.txt"

    let _ = io~>remove(read_path)
    let _ = io~>remove(write_path)
    let _ = io~>remove(append_path)
    let _ = io~>remove(position_path)
    let _ = io~>remove(invalid_utf8_path)
    let _ = io~>remove(write_closed_path)
    let _ = io~>remove(append_closed_path)
    let _ = io~>remove(root)

    let create_root: Outcome<(), IoError> = io~>ensure_dir(root)
    let read_ready: Outcome<(), IoError> =
        io~>write_file(read_path, bytes::view_string("readable"))
    let io_read_file_delegates: bool =
        ioTextEquals(io~>read_file(read_path), "readable")
    let io_read_bytes_delegates: bool =
        ioBytesLengthEquals(io~>read_bytes(read_path), 8usize)
    let read_all_text_advances: bool =
        ioReadHandleTextAdvancesToEnd(io~>open_read(read_path), "readable")
    let read_all_bytes_advances: bool =
        ioReadHandleBytesAdvancesToEnd(io~>open_read(read_path), 8usize)
    let closed_read_text_fails: bool =
        ioReadHandleClosedTextFailsWithIoFailure(io~>open_read(read_path))
    let closed_read_bytes_fails: bool =
        ioReadHandleClosedBytesFailsWithIoFailure(io~>open_read(read_path))

    let invalid_utf8_bytes: [u8; 1] = [255u8]
    let invalid_utf8_slice: const [u8] = invalid_utf8_bytes[0usize..1usize]
    let invalid_utf8_view: bytes@View = bytes::view(invalid_utf8_slice)
    let invalid_utf8_ready: Outcome<(), IoError> =
        io~>write_file(invalid_utf8_path, invalid_utf8_view)
    let io_read_invalid_utf8: bool =
        ioOutcomeErrorIsIoFailure(io~>read_file(invalid_utf8_path))
    let file_read_invalid_utf8: bool =
        ioReadHandleTextFailsWithIoFailure(io~>open_read(invalid_utf8_path))

    let create_write_handle: bool =
        ioWriteHandleAcceptsPayload(io~>create_write(write_path), "write")
    let write_content_observed: bool = ioTextEquals(io~>read_file(write_path), "write")
    let open_write_handle: bool =
        ioWriteHandleAcceptsPayload(io~>open_write(write_path), "open")
    let write_closed_ready: Outcome<(), IoError> =
        io~>write_file(write_closed_path, bytes::view_string(""))
    let closed_write_fails: bool = ioUnitSucceeded(write_closed_ready) &&
        ioWriteHandleClosedOperationsFailWithIoFailure(io~>open_write(write_closed_path))

    let append_base: bool =
        ioWriteHandleAcceptsPayload(io~>create_write(append_path), "base")
    let open_append_handle: bool =
        ioAppendHandleAcceptsPayload(io~>open_append(append_path), "-tail")
    let append_content_observed: bool =
        ioTextEquals(io~>read_file(append_path), "base-tail")
    let append_closed_ready: Outcome<(), IoError> =
        io~>write_file(append_closed_path, bytes::view_string("append"))
    let closed_append_fails: bool = ioUnitSucceeded(append_closed_ready) &&
        ioAppendHandleClosedOperationsFailWithIoFailure(io~>open_append(append_closed_path))

    let write_position_and_length: bool =
        ioWriteHandlePositionAndLengthReference(io, position_path)

    let remove_read: Outcome<(), IoError> = io~>remove(read_path)
    let remove_write: Outcome<(), IoError> = io~>remove(write_path)
    let remove_append: Outcome<(), IoError> = io~>remove(append_path)
    let remove_position: Outcome<(), IoError> = io~>remove(position_path)
    let remove_invalid_utf8: Outcome<(), IoError> = io~>remove(invalid_utf8_path)
    let remove_write_closed: Outcome<(), IoError> = io~>remove(write_closed_path)
    let remove_append_closed: Outcome<(), IoError> = io~>remove(append_closed_path)
    let remove_root: Outcome<(), IoError> = io~>remove(root)

    return ioUnitSucceeded(create_root) &&
        ioUnitSucceeded(read_ready) &&
        io_read_file_delegates &&
        io_read_bytes_delegates &&
        read_all_text_advances &&
        read_all_bytes_advances &&
        closed_read_text_fails &&
        closed_read_bytes_fails &&
        ioUnitSucceeded(invalid_utf8_ready) &&
        io_read_invalid_utf8 &&
        file_read_invalid_utf8 &&
        create_write_handle &&
        write_content_observed &&
        open_write_handle &&
        closed_write_fails &&
        append_base &&
        open_append_handle &&
        append_content_observed &&
        closed_append_fails &&
        write_position_and_length &&
        ioUnitSucceeded(remove_read) &&
        ioUnitSucceeded(remove_write) &&
        ioUnitSucceeded(remove_append) &&
        ioUnitSucceeded(remove_position) &&
        ioUnitSucceeded(remove_invalid_utf8) &&
        ioUnitSucceeded(remove_write_closed) &&
        ioUnitSucceeded(remove_append_closed) &&
        ioUnitSucceeded(remove_root)
}

public procedure authorityIORestrictionAndPathSemanticsReference(context: Context) -> bool {
    let io: $IO = context.io
    let root: string@View = "HelloUltraviolet/Build/IOPathReference"
    let file_path: string@View =
        "HelloUltraviolet/Build/IOPathReference/Payload.txt"
    let dir_path: string@View =
        "HelloUltraviolet/Build/IOPathReference/Directory"
    let restricted_write_path: string@View =
        "HelloUltraviolet/Build/IOPathReference/RestrictedWrite.txt"
    let busy_path: string@View =
        "HelloUltraviolet/Build/IOPathReference/Busy.txt"

    let _ = io~>remove(file_path)
    let _ = io~>remove(restricted_write_path)
    let _ = io~>remove(busy_path)
    let _ = io~>remove(dir_path)
    let _ = io~>remove(root)

    let create_root: Outcome<(), IoError> = io~>ensure_dir(root)
    let create_file: Outcome<(), IoError> =
        io~>write_file(file_path, bytes::view_string("path-payload"))
    let create_dir: Outcome<(), IoError> = io~>ensure_dir(dir_path)
    let kind_file: Outcome<FileKind, IoError> = io~>kind(file_path)
    let kind_dir: Outcome<FileKind, IoError> = io~>kind(dir_path)
    let exists_true: bool = io~>exists(file_path)
    let exists_false: bool = !io~>exists("HelloUltraviolet/Build/IOPathReference/Missing.txt")

    let restricted: $IO = io~>restrict(root)
    let delegate_read: bool =
        ioTextEquals(restricted~>read_file("Payload.txt"), "path-payload")
    let delegate_write: Outcome<(), IoError> =
        restricted~>write_file("RestrictedWrite.txt", bytes::view_string("restricted"))
    let delegate_write_observed: bool =
        ioTextEquals(io~>read_file(restricted_write_path), "restricted")
    let invalid_no_data: bool =
        ioOutcomeErrorIsInvalidPath(restricted~>open_read("../README.md"))
    let invalid_data: bool = ioOutcomeErrorIsInvalidPath(
        restricted~>write_file("../Outside.txt", bytes::view_string("blocked"))
    )
    let invalid_exists_false: bool = !restricted~>exists("../README.md")
    let missing_errors: bool =
        ioOutcomeErrorIsNotFound(restricted~>open_read("Missing.txt")) &&
        ioOutcomeErrorIsNotFound(restricted~>open_dir("MissingDirectory")) &&
        ioOutcomeErrorIsNotFound(restricted~>kind("Missing.txt"))

    let create_write_existing: bool =
        ioOutcomeErrorIsAlreadyExists(io~>create_write(file_path))
    let create_dir_on_file: bool =
        ioOutcomeErrorIsAlreadyExists(io~>create_dir(file_path))
    let ensure_dir_on_file: bool =
        ioOutcomeErrorIsAlreadyExists(io~>ensure_dir(file_path))
    let open_dir_on_file: bool =
        ioOutcomeErrorIsInvalidPath(io~>open_dir(file_path))
    let open_read_directory: bool =
        ioOutcomeErrorIsPermissionDenied(io~>open_read(root))
    let busy_write: bool = ioWriteHandleBusyWhileOpen(io, busy_path)

    let remove_file: Outcome<(), IoError> = io~>remove(file_path)
    let remove_restricted_write: Outcome<(), IoError> = io~>remove(restricted_write_path)
    let remove_busy: Outcome<(), IoError> = io~>remove(busy_path)
    let remove_dir: Outcome<(), IoError> = io~>remove(dir_path)
    let remove_root: Outcome<(), IoError> = io~>remove(root)

    return ioUnitSucceeded(create_root) &&
        ioUnitSucceeded(create_file) &&
        ioUnitSucceeded(create_dir) &&
        ioFileKindIsFile(kind_file) &&
        ioFileKindIsDir(kind_dir) &&
        exists_true &&
        exists_false &&
        delegate_read &&
        ioUnitSucceeded(delegate_write) &&
        delegate_write_observed &&
        invalid_no_data &&
        invalid_data &&
        invalid_exists_false &&
        missing_errors &&
        create_write_existing &&
        create_dir_on_file &&
        ensure_dir_on_file &&
        open_dir_on_file &&
        open_read_directory &&
        busy_write &&
        ioUnitSucceeded(remove_file) &&
        ioUnitSucceeded(remove_restricted_write) &&
        ioUnitSucceeded(remove_busy) &&
        ioUnitSucceeded(remove_dir) &&
        ioUnitSucceeded(remove_root)
}

public procedure authorityIOPathErrorOperationSetsReference(context: Context) -> bool {
    let io: $IO = context.io
    let missing_path: string@View =
        "HelloUltraviolet/Build/IOPathErrorOperationSets/Missing.txt"
    let missing_dir_path: string@View =
        "HelloUltraviolet/Build/IOPathErrorOperationSets/MissingDirectory"
    let invalid_path: string@View =
        "HelloUltraviolet/Build/IOPathErrorOperationSets/Invalid\0Path.txt"
    let payload: bytes@View = bytes::view_string("invalid-path")

    let _ = io~>remove(missing_path)
    let _ = io~>remove(missing_dir_path)

    let invalid_no_data_operations: bool =
        ioOutcomeErrorIsInvalidPath(io~>open_read(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>open_write(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>open_append(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>create_write(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>read_file(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>read_bytes(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>remove(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>open_dir(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>create_dir(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>ensure_dir(invalid_path)) &&
        ioOutcomeErrorIsInvalidPath(io~>kind(invalid_path))
    let invalid_data_operation: bool =
        ioOutcomeErrorIsInvalidPath(io~>write_file(invalid_path, payload))
    let requires_existing_operations: bool =
        ioOutcomeErrorIsNotFound(io~>open_read(missing_path)) &&
        ioOutcomeErrorIsNotFound(io~>open_write(missing_path)) &&
        ioOutcomeErrorIsNotFound(io~>open_append(missing_path)) &&
        ioOutcomeErrorIsNotFound(io~>read_file(missing_path)) &&
        ioOutcomeErrorIsNotFound(io~>read_bytes(missing_path)) &&
        ioOutcomeErrorIsNotFound(io~>open_dir(missing_dir_path)) &&
        ioOutcomeErrorIsNotFound(io~>kind(missing_path)) &&
        ioOutcomeErrorIsNotFound(io~>remove(missing_path))

    return invalid_no_data_operations &&
        invalid_data_operation &&
        requires_existing_operations
}

public procedure authorityIOPathErrorPredicatesReference() -> bool {
    let invalid: IOPathPredicateReference =
        ioPathPredicateReference(true, false, IOPathFailureReference::None)
    let existing: IOPathPredicateReference =
        ioPathPredicateReference(false, true, IOPathFailureReference::None)
    let permission_denied: IOPathPredicateReference =
        ioPathPredicateReference(
            false,
            true,
            IOPathFailureReference::PermissionDenied
        )
    let busy: IOPathPredicateReference =
        ioPathPredicateReference(false, true, IOPathFailureReference::Busy)
    let other_failure: IOPathPredicateReference =
        ioPathPredicateReference(false, true, IOPathFailureReference::OtherFailure)
    return invalid.is_invalid &&
        !invalid.exists &&
        existing.exists &&
        !existing.is_invalid &&
        ioPathPredicatePermissionDeniedReference(permission_denied) &&
        !ioPathPredicateBusyReference(permission_denied) &&
        ioPathPredicateBusyReference(busy) &&
        !ioPathPredicateOtherFailureReference(busy) &&
        ioPathPredicateOtherFailureReference(other_failure)
}

public procedure authorityIORemoveSemanticsReference(context: Context) -> bool {
    let io: $IO = context.io
    let root: string@View = "HelloUltraviolet/Build/IORemoveReference"
    let file_path: string@View =
        "HelloUltraviolet/Build/IORemoveReference/RemoveFile.txt"
    let empty_dir_path: string@View =
        "HelloUltraviolet/Build/IORemoveReference/EmptyDir"
    let nonempty_root: string@View =
        "HelloUltraviolet/Build/IORemoveReference/NonEmptyDir"
    let nonempty_child_path: string@View =
        "HelloUltraviolet/Build/IORemoveReference/NonEmptyDir/Child.txt"
    let other_target_root: string@View = "HelloUltraviolet/Build/IOOtherTarget"
    let other_target_child_path: string@View =
        "HelloUltraviolet/Build/IOOtherTarget/Child.txt"
    let other_link_path: string@View = "HelloUltraviolet/Build/IOOtherLink"

    let _ = io~>remove(file_path)
    let _ = io~>remove(empty_dir_path)
    let _ = io~>remove(nonempty_child_path)
    let _ = io~>remove(nonempty_root)
    let _ = io~>remove(root)

    let create_root: Outcome<(), IoError> = io~>ensure_dir(root)
    let file_ready: Outcome<(), IoError> =
        io~>write_file(file_path, bytes::view_string("remove-file"))
    let remove_file: Outcome<(), IoError> = io~>remove(file_path)
    let file_removed: bool = !io~>exists(file_path)

    let empty_dir_ready: Outcome<(), IoError> = io~>ensure_dir(empty_dir_path)
    let remove_empty_dir: Outcome<(), IoError> = io~>remove(empty_dir_path)
    let empty_dir_removed: bool = !io~>exists(empty_dir_path)

    let nonempty_ready: Outcome<(), IoError> = io~>ensure_dir(nonempty_root)
    let nonempty_child_ready: Outcome<(), IoError> =
        io~>write_file(nonempty_child_path, bytes::view_string("child"))
    let remove_nonempty_root: Outcome<(), IoError> = io~>remove(nonempty_root)
    let nonempty_survived: bool =
        io~>exists(nonempty_root) && io~>exists(nonempty_child_path)
    let remove_nonempty_child: Outcome<(), IoError> = io~>remove(nonempty_child_path)
    let remove_empty_nonempty_root: Outcome<(), IoError> = io~>remove(nonempty_root)

    let other_entry_remove: bool = ioOtherEntryRemoveReference(
        context.sys,
        io,
        other_target_root,
        other_target_child_path,
        other_link_path
    )
    let remove_root: Outcome<(), IoError> = io~>remove(root)

    return ioUnitSucceeded(create_root) &&
        ioUnitSucceeded(file_ready) &&
        ioUnitSucceeded(remove_file) &&
        file_removed &&
        ioUnitSucceeded(empty_dir_ready) &&
        ioUnitSucceeded(remove_empty_dir) &&
        empty_dir_removed &&
        ioUnitSucceeded(nonempty_ready) &&
        ioUnitSucceeded(nonempty_child_ready) &&
        ioOutcomeErrorIsDirectoryNotEmpty(move remove_nonempty_root) &&
        nonempty_survived &&
        ioUnitSucceeded(remove_nonempty_child) &&
        ioUnitSucceeded(remove_empty_nonempty_root) &&
        other_entry_remove &&
        ioUnitSucceeded(remove_root)
}

public procedure authorityIODirectoryIteratorSemanticsReference(context: Context) -> bool {
    let io: $IO = context.io
    let iter_root: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorReference"
    let iter_a_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorReference/IOA.txt"
    let iter_b_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorReference/IOB.txt"
    let iter_c_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorReference/IOC.txt"
    let ordering_root: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorOrdering"
    let ordering_a_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorOrdering/OrderA.txt"
    let ordering_b_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorOrdering/OrderB.txt"
    let ordering_c_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorOrdering/OrderC.txt"
    let snapshot_root: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorSnapshot"
    let snapshot_path: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorSnapshot/Snapshot.txt"
    let empty_root: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorEmpty"
    let closed_root: string@View =
        "HelloUltraviolet/Build/IODirectoryIteratorClosed"

    let _ = io~>remove(iter_a_path)
    let _ = io~>remove(iter_b_path)
    let _ = io~>remove(iter_c_path)
    let _ = io~>remove(ordering_a_path)
    let _ = io~>remove(ordering_b_path)
    let _ = io~>remove(ordering_c_path)
    let _ = io~>remove(snapshot_path)
    let _ = io~>remove(iter_root)
    let _ = io~>remove(ordering_root)
    let _ = io~>remove(snapshot_root)
    let _ = io~>remove(empty_root)
    let _ = io~>remove(closed_root)

    let create_iter_root: Outcome<(), IoError> = io~>ensure_dir(iter_root)
    let create_ordering_root: Outcome<(), IoError> = io~>ensure_dir(ordering_root)
    let create_snapshot_root: Outcome<(), IoError> = io~>ensure_dir(snapshot_root)
    let create_empty_root: Outcome<(), IoError> = io~>ensure_dir(empty_root)
    let create_closed_root: Outcome<(), IoError> = io~>ensure_dir(closed_root)

    let write_iter_c: Outcome<(), IoError> =
        io~>write_file(iter_c_path, bytes::view_string("c"))
    let write_iter_a: Outcome<(), IoError> =
        io~>write_file(iter_a_path, bytes::view_string("a"))
    let write_iter_b: Outcome<(), IoError> =
        io~>write_file(iter_b_path, bytes::view_string("b"))
    let iterator_yields_and_exhausts: bool =
        ioDirectoryIterationReference(io~>open_dir(iter_root))

    let write_ordering_c: Outcome<(), IoError> =
        io~>write_file(ordering_c_path, bytes::view_string("c"))
    let write_ordering_a: Outcome<(), IoError> =
        io~>write_file(ordering_a_path, bytes::view_string("a"))
    let write_ordering_b: Outcome<(), IoError> =
        io~>write_file(ordering_b_path, bytes::view_string("b"))
    let ordered_entries: bool =
        ioDirectoryOrderingReference(io~>open_dir(ordering_root))

    let write_snapshot: Outcome<(), IoError> =
        io~>write_file(snapshot_path, bytes::view_string("snapshot"))
    let snapshot_entries: bool =
        ioDirectorySnapshotAfterRemovalReference(io, snapshot_root, snapshot_path)
    let empty_directory_reaches_end: bool =
        ioPrimitiveOpenDirReachesEnd(io~>open_dir(empty_root))
    let closed_next_fails: bool =
        ioDirIterClosedNextFailsWithIoFailure(io~>open_dir(closed_root))

    let remove_iter_a: Outcome<(), IoError> = io~>remove(iter_a_path)
    let remove_iter_b: Outcome<(), IoError> = io~>remove(iter_b_path)
    let remove_iter_c: Outcome<(), IoError> = io~>remove(iter_c_path)
    let remove_ordering_a: Outcome<(), IoError> = io~>remove(ordering_a_path)
    let remove_ordering_b: Outcome<(), IoError> = io~>remove(ordering_b_path)
    let remove_ordering_c: Outcome<(), IoError> = io~>remove(ordering_c_path)
    let remove_iter_root: Outcome<(), IoError> = io~>remove(iter_root)
    let remove_ordering_root: Outcome<(), IoError> = io~>remove(ordering_root)
    let remove_snapshot_root: Outcome<(), IoError> = io~>remove(snapshot_root)
    let remove_empty_root: Outcome<(), IoError> = io~>remove(empty_root)
    let remove_closed_root: Outcome<(), IoError> = io~>remove(closed_root)

    return ioUnitSucceeded(create_iter_root) &&
        ioUnitSucceeded(create_ordering_root) &&
        ioUnitSucceeded(create_snapshot_root) &&
        ioUnitSucceeded(create_empty_root) &&
        ioUnitSucceeded(create_closed_root) &&
        ioUnitSucceeded(write_iter_c) &&
        ioUnitSucceeded(write_iter_a) &&
        ioUnitSucceeded(write_iter_b) &&
        iterator_yields_and_exhausts &&
        ioUnitSucceeded(write_ordering_c) &&
        ioUnitSucceeded(write_ordering_a) &&
        ioUnitSucceeded(write_ordering_b) &&
        ordered_entries &&
        ioUnitSucceeded(write_snapshot) &&
        snapshot_entries &&
        empty_directory_reaches_end &&
        closed_next_fails &&
        ioUnitSucceeded(remove_iter_a) &&
        ioUnitSucceeded(remove_iter_b) &&
        ioUnitSucceeded(remove_iter_c) &&
        ioUnitSucceeded(remove_ordering_a) &&
        ioUnitSucceeded(remove_ordering_b) &&
        ioUnitSucceeded(remove_ordering_c) &&
        ioUnitSucceeded(remove_iter_root) &&
        ioUnitSucceeded(remove_ordering_root) &&
        ioUnitSucceeded(remove_snapshot_root) &&
        ioUnitSucceeded(remove_empty_root) &&
        ioUnitSucceeded(remove_closed_root)
}

public procedure authorityIOPrimitiveSemanticModelReference(context: Context) -> bool {
    return authorityIOPrimitiveCallsReference(context) &&
        authorityFileDirPrimitiveCallsReference(context) &&
        authorityIOFileHandleSemanticsReference(context) &&
        authorityIODirectoryIteratorSemanticsReference(context) &&
        authorityIOPathErrorOperationSetsReference(context) &&
        authorityIORestrictionAndPathSemanticsReference(context) &&
        authorityIORemoveSemanticsReference(context)
}

public procedure authorityIOHostPrimitiveSetsReference(context: Context) -> bool {
    return authorityIOPrimitiveCallsReference(context) &&
        authorityFileDirPrimitiveCallsReference(context)
}

/// Exercises the Authority IO reference surface.
public procedure runAuthorityIOReference(context: Context) -> bool {
    let read_only: IOAuthorityReference =
        ioAuthorityReference(true, false, true)
    let write_only: IOAuthorityReference =
        ioAuthorityReference(false, true, true)

    let io: $IO = context.io
    let root: string@View = "HelloUltraviolet/Build/IOAuthorityReference"
    let file_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReference/IOFile.txt"
    let handle_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReference/IOHandle.txt"
    let busy_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReference/IOBusy.txt"
    let position_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReference/IOPosition.txt"
    let invalid_utf8_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReference/InvalidUtf8.bin"
    let dir_root: string@View = "HelloUltraviolet/Build/IOAuthorityReferenceDir"
    let first_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceDir/IOA.txt"
    let second_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceDir/IOB.txt"
    let third_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceDir/IOC.txt"
    let snapshot_root: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceSnapshot"
    let snapshot_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceSnapshot/Snapshot.txt"
    let nonempty_root: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceNonEmpty"
    let nonempty_child_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceNonEmpty/Child.txt"
    let ordering_root: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceOrdering"
    let ordering_a_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceOrdering/OrderA.txt"
    let ordering_b_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceOrdering/OrderB.txt"
    let ordering_c_path: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceOrdering/OrderC.txt"
    let empty_remove_root: string@View =
        "HelloUltraviolet/Build/IOAuthorityReferenceEmptyRemove"
    let other_target_root: string@View = "HelloUltraviolet/Build/IOOtherTarget"
    let other_target_child_path: string@View =
        "HelloUltraviolet/Build/IOOtherTarget/Child.txt"
    let other_link_path: string@View = "HelloUltraviolet/Build/IOOtherLink"

    let _ = io~>remove(file_path)
    let _ = io~>remove(handle_path)
    let _ = io~>remove(busy_path)
    let _ = io~>remove(position_path)
    let _ = io~>remove(invalid_utf8_path)
    let _ = io~>remove(first_path)
    let _ = io~>remove(second_path)
    let _ = io~>remove(third_path)
    let _ = io~>remove(snapshot_path)
    let _ = io~>remove(nonempty_child_path)
    let _ = io~>remove(ordering_a_path)
    let _ = io~>remove(ordering_b_path)
    let _ = io~>remove(ordering_c_path)
    let _ = io~>remove(root)
    let _ = io~>remove(dir_root)
    let _ = io~>remove(snapshot_root)
    let _ = io~>remove(nonempty_root)
    let _ = io~>remove(ordering_root)
    let _ = io~>remove(empty_remove_root)
    let _ = io~>remove(other_link_path)
    let _ = io~>remove(other_target_child_path)
    let _ = io~>remove(other_target_root)

    let create_root: Outcome<(), IoError> = io~>ensure_dir(root)
    let create_dir_root: Outcome<(), IoError> = io~>ensure_dir(dir_root)
    let create_snapshot_root: Outcome<(), IoError> = io~>ensure_dir(snapshot_root)
    let create_nonempty_root: Outcome<(), IoError> = io~>ensure_dir(nonempty_root)
    let create_ordering_root: Outcome<(), IoError> = io~>ensure_dir(ordering_root)
    let create_empty_remove_root: Outcome<(), IoError> = io~>ensure_dir(empty_remove_root)
    let write_payload: bytes@View = bytes::view_string("hello-io")
    let invalid_utf8_bytes: [u8; 1] = [255u8]
    let invalid_utf8_slice: const [u8] = invalid_utf8_bytes[0usize..1usize]
    let invalid_utf8_view: bytes@View = bytes::view(invalid_utf8_slice)
    let create_file: Outcome<(), IoError> = io~>write_file(file_path, write_payload)
    let create_invalid_utf8: Outcome<(), IoError> =
        io~>write_file(invalid_utf8_path, invalid_utf8_view)
    let read_file: Outcome<unique string@Managed, IoError> = io~>read_file(file_path)
    let read_bytes: Outcome<unique bytes@Managed, IoError> = io~>read_bytes(file_path)
    let read_invalid_utf8: Outcome<unique string@Managed, IoError> =
        io~>read_file(invalid_utf8_path)
    let read_text_advances: bool =
        ioReadHandleTextAdvancesToEnd(io~>open_read(file_path), "hello-io")
    let read_bytes_advances: bool =
        ioReadHandleBytesAdvancesToEnd(io~>open_read(file_path), 8usize)
    let kind_file: Outcome<FileKind, IoError> = io~>kind(file_path)
    let kind_dir: Outcome<FileKind, IoError> = io~>kind(root)
    let open_read_directory: Outcome<unique File@Read, IoError> =
        io~>open_read(root)
    let create_dir_on_file: Outcome<(), IoError> = io~>create_dir(file_path)
    let ensure_dir_on_file: Outcome<(), IoError> = io~>ensure_dir(file_path)
    let open_dir_on_file: Outcome<unique DirIter@Open, IoError> =
        io~>open_dir(file_path)

    let write_handle: bool = ioWriteHandleAcceptsPayload(
        io~>create_write(handle_path),
        "handle-write"
    )
    let append_handle: bool = ioAppendHandleAcceptsPayload(
        io~>open_append(handle_path),
        "-append"
    )
    let read_handle: bool = ioReadHandleTextEquals(
        io~>open_read(handle_path),
        "handle-write-append"
    )
    let open_write_handle: bool = ioWriteHandleAcceptsPayload(
        io~>open_write(handle_path),
        "open-write"
    )
    let read_bytes_handle: bool = ioReadHandleBytesLengthEquals(
        io~>open_read(handle_path),
        string::length("handle-write-append")
    )
    let invalid_utf8_handle_read: bool =
        ioReadHandleTextFailsWithIoFailure(io~>open_read(invalid_utf8_path))
    let closed_read_text: bool =
        ioReadHandleClosedTextFailsWithIoFailure(io~>open_read(handle_path))
    let closed_read_bytes: bool =
        ioReadHandleClosedBytesFailsWithIoFailure(io~>open_read(handle_path))
    let closed_write: bool =
        ioWriteHandleClosedOperationsFailWithIoFailure(io~>open_write(handle_path))
    let busy_write: bool = ioWriteHandleBusyWhileOpen(io, busy_path)
    let write_position_and_length: bool =
        ioWriteHandlePositionAndLengthReference(io, position_path)
    let write_stdout_empty: Outcome<(), IoError> =
        io~>write_stdout("")
    let write_stderr_empty: Outcome<(), IoError> =
        io~>write_stderr("")

    let _ = io~>write_file(first_path, bytes::view_string("1"))
    let _ = io~>write_file(second_path, bytes::view_string("2"))
    let _ = io~>write_file(third_path, bytes::view_string("3"))
    let dir_entries: bool = ioDirectoryIterationReference(io~>open_dir(dir_root))
    let closed_dir_next: bool =
        ioDirIterClosedNextFailsWithIoFailure(io~>open_dir(dir_root))
    let write_ordering_c: Outcome<(), IoError> =
        io~>write_file(ordering_c_path, bytes::view_string("c"))
    let write_ordering_a: Outcome<(), IoError> =
        io~>write_file(ordering_a_path, bytes::view_string("a"))
    let write_ordering_b: Outcome<(), IoError> =
        io~>write_file(ordering_b_path, bytes::view_string("b"))
    let ordering_entries: bool =
        ioDirectoryOrderingReference(io~>open_dir(ordering_root))
    let _ = io~>write_file(snapshot_path, bytes::view_string("snapshot"))
    let snapshot_entries: bool =
        ioDirectorySnapshotAfterRemovalReference(io, snapshot_root, snapshot_path)
    let write_nonempty_child: Outcome<(), IoError> =
        io~>write_file(nonempty_child_path, bytes::view_string("child"))
    let remove_nonempty_root: Outcome<(), IoError> = io~>remove(nonempty_root)
    let remove_empty_root: Outcome<(), IoError> = io~>remove(empty_remove_root)
    let empty_root_removed: bool = !io~>exists(empty_remove_root)
    let other_entry_remove: bool = ioOtherEntryRemoveReference(
        context.sys,
        io,
        other_target_root,
        other_target_child_path,
        other_link_path
    )

    let restricted: $IO = io~>restrict(root)
    let restricted_exists: bool = restricted~>exists("IOFile.txt") &&
        !restricted~>exists("../README.md")
    let restricted_invalid: bool =
        ioOutcomeErrorIsInvalidPath(restricted~>open_read("../README.md"))
    let restricted_missing: bool =
        ioOutcomeErrorIsNotFound(restricted~>open_read("missing.txt")) &&
        ioOutcomeErrorIsNotFound(restricted~>open_dir("missing")) &&
        ioOutcomeErrorIsNotFound(restricted~>kind("missing.txt"))

    let remove_file: Outcome<(), IoError> = io~>remove(file_path)
    let remove_handle: Outcome<(), IoError> = io~>remove(handle_path)
    let remove_busy: Outcome<(), IoError> = io~>remove(busy_path)
    let remove_position: Outcome<(), IoError> = io~>remove(position_path)
    let remove_invalid_utf8: Outcome<(), IoError> = io~>remove(invalid_utf8_path)
    let remove_first: Outcome<(), IoError> = io~>remove(first_path)
    let remove_second: Outcome<(), IoError> = io~>remove(second_path)
    let remove_third: Outcome<(), IoError> = io~>remove(third_path)
    let remove_nonempty_child: Outcome<(), IoError> = io~>remove(nonempty_child_path)
    let remove_empty_nonempty_root: Outcome<(), IoError> = io~>remove(nonempty_root)
    let remove_ordering_a: Outcome<(), IoError> = io~>remove(ordering_a_path)
    let remove_ordering_b: Outcome<(), IoError> = io~>remove(ordering_b_path)
    let remove_ordering_c: Outcome<(), IoError> = io~>remove(ordering_c_path)
    let remove_root: Outcome<(), IoError> = io~>remove(root)
    let remove_dir_root: Outcome<(), IoError> = io~>remove(dir_root)
    let remove_snapshot_root: Outcome<(), IoError> = io~>remove(snapshot_root)
    let remove_ordering_root: Outcome<(), IoError> = io~>remove(ordering_root)

    return authorityIOPrimitiveSemanticModelReference(context) &&
        authorityIOHostPrimitiveSetsReference(context) &&
        authorityIOPathErrorPredicatesReference() &&
        ioAuthorityCanObserveHost(read_only) &&
        ioAuthorityCanObserveHost(write_only) &&
        ioUnitSucceeded(create_root) &&
        ioUnitSucceeded(create_dir_root) &&
        ioUnitSucceeded(create_snapshot_root) &&
        ioUnitSucceeded(create_nonempty_root) &&
        ioUnitSucceeded(create_ordering_root) &&
        ioUnitSucceeded(create_empty_remove_root) &&
        ioUnitSucceeded(create_file) &&
        ioUnitSucceeded(create_invalid_utf8) &&
        ioTextEquals(move read_file, "hello-io") &&
        ioBytesLengthEquals(move read_bytes, 8usize) &&
        ioOutcomeErrorIsIoFailure(move read_invalid_utf8) &&
        read_text_advances &&
        read_bytes_advances &&
        ioFileKindIsFile(kind_file) &&
        ioFileKindIsDir(kind_dir) &&
        ioOutcomeErrorIsPermissionDenied(move open_read_directory) &&
        ioOutcomeErrorIsAlreadyExists(move create_dir_on_file) &&
        ioOutcomeErrorIsAlreadyExists(move ensure_dir_on_file) &&
        ioOutcomeErrorIsInvalidPath(move open_dir_on_file) &&
        write_handle &&
        append_handle &&
        read_handle &&
        open_write_handle &&
        read_bytes_handle &&
        invalid_utf8_handle_read &&
        closed_read_text &&
        closed_read_bytes &&
        closed_write &&
        busy_write &&
        write_position_and_length &&
        ioUnitSucceeded(write_stdout_empty) &&
        ioUnitSucceeded(write_stderr_empty) &&
        dir_entries &&
        closed_dir_next &&
        ioUnitSucceeded(write_ordering_c) &&
        ioUnitSucceeded(write_ordering_a) &&
        ioUnitSucceeded(write_ordering_b) &&
        ordering_entries &&
        snapshot_entries &&
        ioUnitSucceeded(write_nonempty_child) &&
        ioOutcomeErrorIsDirectoryNotEmpty(move remove_nonempty_root) &&
        ioUnitSucceeded(remove_empty_root) &&
        empty_root_removed &&
        other_entry_remove &&
        restricted_exists &&
        restricted_invalid &&
        restricted_missing &&
        ioUnitSucceeded(remove_file) &&
        ioUnitSucceeded(remove_handle) &&
        ioUnitSucceeded(remove_busy) &&
        ioUnitSucceeded(remove_position) &&
        ioUnitSucceeded(remove_invalid_utf8) &&
        ioUnitSucceeded(remove_first) &&
        ioUnitSucceeded(remove_second) &&
        ioUnitSucceeded(remove_third) &&
        ioUnitSucceeded(remove_nonempty_child) &&
        ioUnitSucceeded(remove_empty_nonempty_root) &&
        ioUnitSucceeded(remove_ordering_a) &&
        ioUnitSucceeded(remove_ordering_b) &&
        ioUnitSucceeded(remove_ordering_c) &&
        ioUnitSucceeded(remove_root) &&
        ioUnitSucceeded(remove_dir_root) &&
        ioUnitSucceeded(remove_snapshot_root) &&
        ioUnitSucceeded(remove_ordering_root)
}
