//! Reference specimens for Conformance / BehaviorClassification.

internal enum BehaviorReferenceKind {
    Accepted
    Rejected
    Diagnostic
    Unspecified
}

internal procedure behaviorRequiresDiagnostic(kind: BehaviorReferenceKind) -> bool {
    return if kind is {
        BehaviorReferenceKind::Accepted {
            false
        }
        BehaviorReferenceKind::Rejected {
            true
        }
        BehaviorReferenceKind::Diagnostic {
            true
        }
        BehaviorReferenceKind::Unspecified {
            false
        }
    }
}

internal procedure behaviorIsExecutableReference(kind: BehaviorReferenceKind) -> bool {
    return if kind is {
        BehaviorReferenceKind::Accepted {
            true
        }
        BehaviorReferenceKind::Rejected {
            false
        }
        BehaviorReferenceKind::Diagnostic {
            false
        }
        BehaviorReferenceKind::Unspecified {
            false
        }
    }
}

internal record JudgmentReference {
    internal environment: string@View
    internal subject: string@View
}

internal procedure judgmentSubject(reference: JudgmentReference) -> string@View {
    return reference.subject
}

internal procedure judgmentEnvironment(reference: JudgmentReference) -> string@View {
    return reference.environment
}

internal enum RuntimeCheckReferenceKind {
    IntegerOverflow
    SliceBounds
    IntDivisionByZero
}

internal enum RuntimeBehaviorReferenceKind {
    Panic
}

internal procedure runtimeCheckPanics(kind: RuntimeCheckReferenceKind) -> bool {
    let behavior: RuntimeBehaviorReferenceKind = if kind is {
        RuntimeCheckReferenceKind::IntegerOverflow {
            RuntimeBehaviorReferenceKind::Panic
        }
        RuntimeCheckReferenceKind::SliceBounds {
            RuntimeBehaviorReferenceKind::Panic
        }
        RuntimeCheckReferenceKind::IntDivisionByZero {
            RuntimeBehaviorReferenceKind::Panic
        }
    }
    return if behavior is {
        RuntimeBehaviorReferenceKind::Panic {
            true
        }
    }
}

/// Exercises Subject and EnvOf extraction for a concrete judgment specimen.
public procedure judgmentSubjectAndEnvironmentReference() -> bool {
    let reference: JudgmentReference = JudgmentReference {
        environment: "Gamma",
        subject: "LowerStaticDeinit"
    }
    return judgmentSubject(reference) == "LowerStaticDeinit" &&
        judgmentEnvironment(reference) == "Gamma"
}

/// Exercises the required runtime check set.
public procedure runtimeCheckReference() -> bool {
    let overflow: RuntimeCheckReferenceKind =
        RuntimeCheckReferenceKind::IntegerOverflow
    let slice_bounds: RuntimeCheckReferenceKind =
        RuntimeCheckReferenceKind::SliceBounds
    let division_by_zero: RuntimeCheckReferenceKind =
        RuntimeCheckReferenceKind::IntDivisionByZero
    return runtimeCheckPanics(overflow) &&
        runtimeCheckPanics(slice_bounds) &&
        runtimeCheckPanics(division_by_zero)
}

/// Exercises the RuntimeBehavior mapping for every runtime check.
public procedure runtimeCheckBehaviorReference() -> bool {
    return runtimeCheckReference()
}

/// Exercises the Conformance BehaviorClassification reference surface.
public procedure runConformanceBehaviorClassificationReference() -> bool {
    let accepted: BehaviorReferenceKind = BehaviorReferenceKind::Accepted
    let rejected: BehaviorReferenceKind = BehaviorReferenceKind::Rejected
    let diagnostic: BehaviorReferenceKind = BehaviorReferenceKind::Diagnostic
    let unspecified: BehaviorReferenceKind = BehaviorReferenceKind::Unspecified
    return behaviorIsExecutableReference(accepted) &&
        !behaviorRequiresDiagnostic(accepted) &&
        behaviorRequiresDiagnostic(rejected) &&
        behaviorRequiresDiagnostic(diagnostic) &&
        !behaviorIsExecutableReference(unspecified) &&
        judgmentSubjectAndEnvironmentReference() &&
        runtimeCheckReference() &&
        runtimeCheckBehaviorReference()
}
