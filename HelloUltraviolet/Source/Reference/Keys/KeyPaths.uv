//! Reference specimens for Keys / KeyPaths.

internal record KeyLeaf {
    internal value: i32
}

internal record KeyContainer {
    internal leaf: KeyLeaf
    internal values: [i32; 4]
}

internal record KeyPointerBox {
    internal pointer: Ptr<KeyLeaf>@Valid
}

internal record KeyPointerAliasBox {
    internal first: Ptr<KeyLeaf>@Valid
    internal second: Ptr<KeyLeaf>@Valid
}

internal record KeyBoundaryContainer {
    internal #leaf: KeyLeaf
    internal value: i32
}

internal record KeyBoundaryLeaf {
    internal left: i32
    internal right: i32
}

internal record KeyBoundaryPair {
    internal #leaf: KeyBoundaryLeaf
}

internal class SharedDynamicKeyReadable {
    internal procedure readKeyValue(~) -> i32
}

internal record SharedDynamicKeyOwner <: SharedDynamicKeyReadable {
    internal value: i32

    internal procedure readKeyValue(~) -> i32 {
        return self.value
    }
}

internal record SharedDynamicKeyBox {
    internal owner: $SharedDynamicKeyReadable
}

internal procedure fieldBoundaryKeyPathValue() -> i32 {
    var container: shared KeyBoundaryContainer =
        KeyBoundaryContainer {
            leaf: KeyLeaf { value: 11 },
            value: 6
        }
    var observed: i32 = 0
    %read container {
        observed = container.leaf.value + container.value
    }
    return observed
}

internal procedure fieldKeyBoundaryReference() -> bool {
    var container: shared KeyBoundaryPair =
        KeyBoundaryPair {
            leaf: KeyBoundaryLeaf {
                left: 17,
                right: 19
            }
        }
    var observed: i32 = 0
    %read container.leaf.left {
        observed = container.leaf.left + container.leaf.right
    }
    return observed == 36
}

internal procedure pointerDereferenceKeyPathValue() -> i32 {
    var leaf: KeyLeaf = KeyLeaf { value: 13 }
    var pointer_box: shared KeyPointerBox =
        KeyPointerBox { pointer: &leaf }
    var observed: i32 = 0
    %read pointer_box.pointer {
        observed = (*pointer_box.pointer).value
    }
    return observed
}

internal procedure pointerDereferenceKeyAccessReference() -> bool {
    return pointerDereferenceKeyPathValue() == 13
}

/// Exercises pointer-derived object identity through overlapping referent storage.
internal procedure objectIdentityReference() -> bool {
    var leaf: KeyLeaf = KeyLeaf { value: 21 }
    var aliases: shared KeyPointerAliasBox =
        KeyPointerAliasBox {
            first: &leaf,
            second: &leaf
        }
    var before: i32 = 0
    var after: i32 = 0

    %read aliases.first, aliases.second {
        before = (*aliases.first).value + (*aliases.second).value
    }
    %write aliases.first {
        (*aliases.first).value = 34
    }
    %read aliases.second {
        after = (*aliases.second).value
    }

    return before == 42 && after == 34
}

internal procedure runtimeKeyRootIdentityConstraintsReference() -> bool {
    var left: KeyLeaf = KeyLeaf { value: 23 }
    var right: KeyLeaf = KeyLeaf { value: 29 }
    var aliases: shared KeyPointerAliasBox =
        KeyPointerAliasBox {
            first: &left,
            second: &right
        }
    var observed: i32 = 0

    %write aliases.first {
        (*aliases.first).value = 41
    }
    %read aliases.second {
        observed = (*aliases.second).value
    }

    return objectIdentityReference() && observed == 29
}

internal procedure sharedDynamicMethodKeyPathValue() -> i32 {
    let owner: SharedDynamicKeyOwner = SharedDynamicKeyOwner { value: 15 }
    var dynamic_box: shared SharedDynamicKeyBox =
        SharedDynamicKeyBox { owner: owner as $SharedDynamicKeyReadable }
    var observed: i32 = 0
    %read dynamic_box.owner {
        observed = dynamic_box.owner~>readKeyValue()
    }
    return observed
}

internal procedure sharedDynamicClassObjectsReference() -> bool {
    return sharedDynamicMethodKeyPathValue() == 15
}

internal procedure nestedKeyPathValue() -> i32 {
    var container: shared KeyContainer =
        KeyContainer {
            leaf: KeyLeaf { value: 7 },
            values: [1, 2, 3, 4]
        }
    var observed: i32 = 0
    %read container.leaf.value {
        observed = observed + container.leaf.value
    }
    %read container.values[1usize] {
        observed = observed + container.values[1usize]
    }
    return observed
}

internal procedure keyPathWellFormednessReference() -> bool {
    return nestedKeyPathValue() == 9 &&
        fieldKeyBoundaryReference()
}

internal procedure rootKeyPathValue() -> i32 {
    var shared_value: shared i32 = 5
    var observed: i32 = 0
    %read shared_value {
        observed = shared_value + 0
    }
    return observed
}

internal procedure keyAnalysisSharedOnlyReference() -> bool {
    var unique_leaf: unique KeyLeaf = KeyLeaf { value: 4 }
    let local_leaf: KeyLeaf = KeyLeaf { value: 3 }
    return rootKeyPathValue() == 5 &&
        unique_leaf.value == 4 &&
        local_leaf.value == 3
}

/// Exercises the Keys KeyPaths reference surface.
public procedure runKeysKeyPathsReference() -> bool {
    return keyPathWellFormednessReference() &&
        keyAnalysisSharedOnlyReference() &&
        fieldBoundaryKeyPathValue() == 17 &&
        fieldKeyBoundaryReference() &&
        pointerDereferenceKeyAccessReference() &&
        objectIdentityReference() &&
        runtimeKeyRootIdentityConstraintsReference() &&
        sharedDynamicClassObjectsReference()
}
