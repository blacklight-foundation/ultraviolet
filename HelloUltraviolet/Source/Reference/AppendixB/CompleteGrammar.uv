/// Exercises Appendix B.1 lexical grammar through all source-text reference surfaces.
public procedure runAppendixBLexicalGrammarReference(context: Context) -> bool {
    return runSourceTextUnicodeNormalizationReference() &&
        runSourceTextLogicalLinesReference() &&
        runSourceTextIdentifiersReference() &&
        runSourceTextLiteralsReference() &&
        runSourceTextOperatorsAndPunctuationReference()
}

/// Exercises Appendix B.2 type grammar through type, permission, and modal references.
public procedure runAppendixBTypeGrammarReference(context: Context) -> bool {
    return runPermissionsPermissionFormsReference() &&
        runDataTypesPrimitivesReference() &&
        runDataTypesTuplesReference() &&
        runDataTypesArraysReference() &&
        runDataTypesSlicesReference() &&
        runDataTypesUnionsReference() &&
        runDataTypesRecordsReference() &&
        runDataTypesEnumsReference() &&
        runDataTypesTypeAliasesReference() &&
        runModalTypesStringsReference(context.heap) &&
        runModalTypesBytesReference(context.heap) &&
        runModalTypesPointersReference() &&
        runModalTypesFunctionTypesReference() &&
        runModalTypesClosuresReference() &&
        runPolymorphismGenericParametersReference() &&
        runTypesRefinementsReference() &&
        runModalTypesModalDeclarationsReference() &&
        runModalTypesStateFieldsReference() &&
        runModalTypesStateMethodsReference() &&
        runModalTypesTransitionsReference()
}

/// Exercises Appendix B.2 generic, refinement, and modal state-specific grammar.
public procedure runAppendixBGenericRefinementModalTypeGrammarReference(
    context: Context
) -> bool {
    return runPolymorphismGenericParametersReference() &&
        runTypesRefinementsReference() &&
        runModalTypesModalDeclarationsReference() &&
        runModalTypesStateFieldsReference() &&
        runModalTypesStateMethodsReference() &&
        runModalTypesTransitionsReference()
}

/// Exercises Appendix B.3 expression grammar through all expression references.
public procedure runAppendixBExpressionGrammarReference(context: Context) -> bool {
    return runExpressionsLiteralsAndNamesReference() &&
        runExpressionsAccessAndPlacesReference() &&
        runExpressionsCallsReference() &&
        runExpressionsOperatorsReference() &&
        runExpressionsCastsAndTransmutesReference() &&
        runExpressionsConstructionReference() &&
        runExpressionsControlSurfaceReference() &&
        runExpressionsEffectfulCoreReference() &&
        runExpressionsClosuresAndPipelinesReference()
}

/// Exercises Appendix B.3 control and special expression grammar.
public procedure runAppendixBControlAndSpecialExpressionGrammarReference(
    context: Context
) -> bool {
    return runExpressionsControlSurfaceReference() &&
        runExpressionsIfControlReference() &&
        runExpressionsIfIsControlReference() &&
        runExpressionsIfCaseControlReference() &&
        runExpressionsBlockControlReference() &&
        runExpressionsLoopControlReference() &&
        runExpressionsIteratorLoopControlReference() &&
        runExpressionsEffectfulCoreReference() &&
        runModalTypesWideningReference() &&
        runModalTypesPointersReference() &&
        runExpressionsCastsAndTransmutesReference()
}

/// Exercises Appendix B.4 pattern grammar through every pattern reference group.
public procedure runAppendixBPatternGrammarReference(context: Context) -> bool {
    return runPatternsBasicPatternsReference() &&
        runPatternsTupleRecordPatternsReference() &&
        runPatternsEnumModalPatternsReference() &&
        runPatternsRangePatternsReference() &&
        runPatternsCaseClausesReference() &&
        runPatternsExhaustivenessReference()
}

/// Exercises Appendix B.5 statement grammar through all statement reference groups.
public procedure runAppendixBStatementGrammarReference(context: Context) -> bool {
    return runStatementsBlocksReference() &&
        runStatementsBindingsReference() &&
        runStatementsLocalUsingReference() &&
        runStatementsAssignmentReference() &&
        runStatementsExpressionStatementsReference() &&
        runStatementsDeferReference() &&
        runStatementsRegionReference() &&
        runStatementsFrameReference() &&
        runStatementsControlTransferReference() &&
        runStatementsUnsafeReference() &&
        runKeysAcquisitionBlocksReference() &&
        runComptimeCompileTimeFormsReference()
}

/// Exercises Appendix B.6 declaration grammar through declaration-bearing references.
public procedure runAppendixBDeclarationGrammarReference(context: Context) -> bool {
    return runModulesImportsReference() &&
        runModulesUsingsReference() &&
        runModulesStaticsReference() &&
        runModulesAggregationReference() &&
        runModulesExternBlocksReference() &&
        runProceduresDeclarationsReference() &&
        runProceduresReceiversReference() &&
        runPolymorphismGenericProceduresReference() &&
        runDataTypesRecordsReference() &&
        runDataTypesEnumsReference() &&
        runDataTypesTypeAliasesReference() &&
        runModalTypesModalDeclarationsReference() &&
        runPolymorphismClassesReference() &&
        runPolymorphismAssociatedTypesReference() &&
        runFFIExternProceduresReference() &&
        runComptimeCompileTimeFormsReference() &&
        runComptimeDeriveTargetsReference()
}

/// Exercises Appendix B.7 contract grammar through contract and invariant references.
public procedure runAppendixBContractGrammarReference(context: Context) -> bool {
    return runProceduresContractsReference() &&
        runProceduresPreconditionsReference() &&
        runProceduresPostconditionsReference() &&
        runProceduresInvariantsReference() &&
        runProceduresVerificationReference() &&
        runExpressionsLoopControlReference()
}

/// Exercises Appendix B.8 attribute grammar through all attribute reference surfaces.
public procedure runAppendixBAttributeGrammarReference(context: Context) -> bool {
    return runAttributesGeneralAttributesReference() &&
        runAttributesSourceNativeTestsReference() &&
        runAttributesDiagnosticAttributesReference() &&
        runAttributesLayoutAttributesReference() &&
        runAttributesOptimizationAttributesReference() &&
        runAttributesVendorAttributesReference() &&
        runFFIAttributesReference() &&
        runFFIExportedProceduresReference() &&
        runFFIBoundaryUnwindingReference() &&
        runFFIFfiSafeReference() &&
        runComptimeDeriveTargetsReference()
}

/// Exercises Appendix B.9 key-system grammar through every key reference group.
public procedure runAppendixBKeySystemGrammarReference(context: Context) -> bool {
    return runKeysKeyPathsReference() &&
        runKeysAcquisitionBlocksReference() &&
        runKeysConflictDetectionReference() &&
        runKeysNestedReleaseReference() &&
        runKeysSpeculativeExecutionReference() &&
        runKeysDynamicVerificationReference(context) &&
        runKeysMemoryOrderingReference()
}

/// Exercises Appendix B.10 structured-concurrency grammar.
public procedure runAppendixBConcurrencyGrammarReference(context: Context) -> bool {
    return runParallelismParallelBlocksReference(context) &&
        runParallelismExecutionDomainsReference(context) &&
        runParallelismCaptureSemanticsReference(context) &&
        runParallelismSpawnReference(context) &&
        runParallelismDispatchReference(context) &&
        runParallelismCancellationReference(context) &&
        runParallelismPanicHandlingReference(context) &&
        runParallelismDeterminismReference(context) &&
        runKeysMemoryOrderingReference()
}

/// Exercises Appendix B.11 async grammar through async type, forms, and runtime references.
public procedure runAppendixBAsyncGrammarReference(context: Context) -> bool {
    return runAsyncAsyncTypeReference() &&
        runAsyncSuspensionFormsReference(context) &&
        runAsyncCompositionFormsReference() &&
        runAsyncCompositionCombinatorsReference() &&
        runAsyncStateMachineReference() &&
        runAsyncAsyncKeyIntegrationReference()
}

/// Exercises Appendix B.12 compile-time and metaprogramming grammar.
public procedure runAppendixBMetaprogrammingGrammarReference(context: Context) -> bool {
    return runComptimeCompileTimeFormsReference() &&
        runComptimeCompileTimeCapabilitiesReference() &&
        runComptimeReflectionReference() &&
        runComptimeQuoteSpliceEmissionReference() &&
        runComptimeDeriveTargetsReference()
}

/// Exercises Appendix B.13 FFI grammar through FFI declaration and contract references.
public procedure runAppendixBFFIGrammarReference(context: Context) -> bool {
    return runFFIFfiSafeReference() &&
        runFFIExternProceduresReference() &&
        runFFIExportedProceduresReference() &&
        runFFIAttributesReference() &&
        runFFICapabilityIsolationReference() &&
        runFFIForeignContractsReference() &&
        runFFIBoundaryUnwindingReference()
}

/// Exercises Appendix B.14 region and frame grammar.
public procedure runAppendixBRegionGrammarReference(context: Context) -> bool {
    return runStatementsRegionReference() &&
        runStatementsFrameReference()
}
