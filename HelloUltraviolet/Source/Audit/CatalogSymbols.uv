//! Compiled symbol checks for source references named by catalog rows.

using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteAudit }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceAppendixB }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceAsync }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceAttributes }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceAuthority }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceComptime }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceConformance }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceDataTypes }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceDiagnostics }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceExpressions }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceFFI }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceKeys }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceLowering }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceModalTypes }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceModules }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceNames }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceParallelism }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferencePatterns }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferencePermissions }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferencePolymorphism }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceProcedures }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceProjects }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceSourceText }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceStatements }
using HelloUltraviolet::Audit::SymbolExecutions::{ catalogCompiledSymbolsExecuteReferenceTypes }

public procedure expectedCatalogCompiledSymbolCount() -> usize {
    return 168usize
}

public procedure catalogCompiledSymbolCount() -> usize {
    return 168usize
}

public procedure expectedCatalogCompiledSymbolTargetDigest() -> usize {
    return 185875296usize
}

public procedure catalogCompiledSymbolTargetDigest() -> usize {
    return 185875296usize
}

public procedure catalogCompiledSymbolTargetsAreIndexed() -> bool {
    return catalogCompiledSymbolCount() == expectedCatalogCompiledSymbolCount() &&
        catalogCompiledSymbolTargetDigest() ==
            expectedCatalogCompiledSymbolTargetDigest()
}

public procedure catalogCompiledSymbolsExecute(context: Context) -> bool {
    var passed: bool = true
    passed = catalogCompiledSymbolsExecuteAudit(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceAppendixB(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceAsync(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceAttributes(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceAuthority(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceComptime(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceConformance(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceDataTypes(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceDiagnostics(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceExpressions(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceFFI(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceKeys(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceLowering(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceModalTypes(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceModules(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceNames(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceParallelism(context) && passed
    passed = catalogCompiledSymbolsExecuteReferencePatterns(context) && passed
    passed = catalogCompiledSymbolsExecuteReferencePermissions(context) && passed
    passed = catalogCompiledSymbolsExecuteReferencePolymorphism(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceProcedures(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceProjects(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceSourceText(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceStatements(context) && passed
    passed = catalogCompiledSymbolsExecuteReferenceTypes(context) && passed
    return passed
}
