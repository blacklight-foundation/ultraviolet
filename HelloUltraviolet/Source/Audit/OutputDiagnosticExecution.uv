//! Source-native compiler execution checks for output-diagnostic fixtures.

using HelloUltraviolet::Audit::FixtureCatalog::OutputDiagnostics::{
    expectedOutputDiagnosticFixtureCount
}

internal enum OutputDiagnosticConformanceCheck {
    None
    LlvmTool
    EmitLLVM
    LlvmTypeMapping
    LinkerTool
    ArchiverTool
    LinkFailure
    ArchiveFailure
    RuntimeMissing
    RuntimeIncompatible
    HostedImportGraph
    ManifestMissing
    DirSeqReadFailure
    ManifestRequiredTypes
    ManifestOutDirType
    ManifestEmitIRType
    ManifestLinkKindType
    ManifestLinkKindValue
    ManifestLinkKindUse
    ManifestToolchain
    ManifestEmitIRValue
    ManifestOutDirPath
    DirectoryPreparation
    ObjectWrite
    IRWrite
}

internal enum OutputDiagnosticFilesystemSetup {
    None
    DirectoryPreparationFailure
    ObjectWriteFailure
    IRWriteFailure
}

internal procedure outputDiagnosticObjectFileExtension(
    authority: TestAuthority
) -> string@View {
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        return ".obj"
    }
    return ".o"
}

internal procedure outputDiagnosticExpectedDirectiveCount(expected_text: string@View) -> usize {
    let text_length: usize = string::length(expected_text)
    let name_length: usize = string::length(EXPECTED_DIAGNOSTIC_NAME)
    var position: usize = 0usize
    var directive_count: usize = 0usize
    loop position < text_length {
        let name_start: usize =
            diagnosticFindFrom(expected_text, EXPECTED_DIAGNOSTIC_NAME, position)
        if name_start == text_length {
            return directive_count
        }

        let name_end: usize = name_start + name_length
        let quote_start: usize = diagnosticFindByteFrom(expected_text, 34u8, name_end)
        if quote_start == text_length {
            return 0usize
        }
        let code_start: usize = quote_start + 1usize
        let code_end: usize = diagnosticFindByteFrom(expected_text, 34u8, code_start)
        if code_end == text_length {
            return 0usize
        }

        directive_count = directive_count + 1usize
        position = code_end + 1usize
    }
    return directive_count
}

internal procedure outputDiagnosticExpectedDirectiveCountFromReadResult(
    move read_result: Outcome<unique string@Managed, IoError>
) -> usize {
    return if move read_result is {
        @Value { value } {
            let expected_text: string@View = string::as_view(value)
            outputDiagnosticExpectedDirectiveCount(expected_text)
        }
        @Error {
            0usize
        }
    }
}

internal procedure outputDiagnosticExpectedDirectiveCountFromFile(
    authority: TestAuthority,
    expected_path: string@View
) -> usize {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticAppendProjectPath(value, authority, expected_path) {
                0usize
            } else {
                let expected_text_path: string@View = string::as_view(value)
                let read_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(expected_text_path)
                outputDiagnosticExpectedDirectiveCountFromReadResult(move read_result)
            }
        }
        @Error {
            0usize
        }
    }
}

internal procedure outputDiagnosticActualTextMatchesExpected(
    authority: TestAuthority,
    expected_text: string@View,
    move actual_result: Outcome<unique string@Managed, IoError>
) -> usize {
    return if move actual_result is {
        @Value { value } {
            let actual_text: string@View = string::as_view(value)
            if diagnosticExpectedCodesMatch(authority, expected_text, actual_text) {
                1usize
            } else {
                0usize
            }
        }
        @Error {
            0usize
        }
    }
}

internal procedure outputDiagnosticExpectedReadMatchesActual(
    authority: TestAuthority,
    expected_count: usize,
    move expected_result: Outcome<unique string@Managed, IoError>,
    move actual_result: Outcome<unique string@Managed, IoError>
) -> usize {
    return if move expected_result is {
        @Value { value } {
            let expected_text: string@View = string::as_view(value)
            if outputDiagnosticActualTextMatchesExpected(
                authority,
                expected_text,
                move actual_result
            ) == 1usize {
                expected_count
            } else {
                0usize
            }
        }
        @Error {
            0usize
        }
    }
}

internal procedure outputDiagnosticActualMatchesExpected(
    authority: TestAuthority,
    expected_path: string@View,
    actual_path: string@View
) -> usize {
    let expected_count: usize =
        outputDiagnosticExpectedDirectiveCountFromFile(authority, expected_path)
    if expected_count == 0usize {
        return 0usize
    }

    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticAppendProjectPath(value, authority, expected_path) {
                0usize
            } else {
                let expected_text_path: string@View = string::as_view(value)
                let expected_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(expected_text_path)
                let actual_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(actual_path)
                outputDiagnosticExpectedReadMatchesActual(
                    authority,
                    expected_count,
                    move expected_result,
                    move actual_result
                )
            }
        }
        @Error {
            0usize
        }
    }
}

internal procedure outputDiagnosticSkipCarriageBeforeLineFeed(
    text: string@View,
    index: usize
) -> usize {
    let length: usize = string::length(text)
    if index + 1usize < length &&
        auditTextByte(text, index) == 13u8 &&
        auditTextByte(text, index + 1usize) == 10u8 {
        return index + 1usize
    }
    return index
}

internal procedure outputDiagnosticTextEqualsWithHostLineEndings(
    expected_text: string@View,
    actual_text: string@View
) -> bool {
    let expected_length: usize = string::length(expected_text)
    let actual_length: usize = string::length(actual_text)
    var expected_index: usize = 0usize
    var actual_index: usize = 0usize
    loop true {
        expected_index =
            outputDiagnosticSkipCarriageBeforeLineFeed(expected_text, expected_index)
        actual_index =
            outputDiagnosticSkipCarriageBeforeLineFeed(actual_text, actual_index)
        if expected_index >= expected_length || actual_index >= actual_length {
            return expected_index >= expected_length &&
                actual_index >= actual_length
        }
        if auditTextByte(expected_text, expected_index) !=
            auditTextByte(actual_text, actual_index) {
            return false
        }
        expected_index = expected_index + 1usize
        actual_index = actual_index + 1usize
    }
    return true
}

internal procedure outputDiagnosticActualTextEquals(
    expected_text: string@View,
    move actual_result: Outcome<unique string@Managed, IoError>
) -> bool {
    return if move actual_result is {
        @Value { value } {
            let actual_text: string@View = string::as_view(value)
            outputDiagnosticTextEqualsWithHostLineEndings(expected_text, actual_text)
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticTextFilesEqual(
    move expected_result: Outcome<unique string@Managed, IoError>,
    move actual_result: Outcome<unique string@Managed, IoError>
) -> bool {
    return if move expected_result is {
        @Value { value } {
            let expected_text: string@View = string::as_view(value)
            outputDiagnosticActualTextEquals(expected_text, move actual_result)
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticFileContains(
    authority: TestAuthority,
    path: string@View,
    required_text: string@View
) -> bool {
    let read_result: Outcome<unique string@Managed, IoError> =
        authority.io~>read_file(path)
    return if move read_result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            auditTextContains(text, required_text)
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticFileExcludes(
    authority: TestAuthority,
    path: string@View,
    forbidden_text: string@View
) -> bool {
    let read_result: Outcome<unique string@Managed, IoError> =
        authority.io~>read_file(path)
    return if move read_result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            !auditTextContains(text, forbidden_text)
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticBackendDiagnosticOwnershipMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View
) -> bool {
    return outputDiagnosticFileContains(
            authority,
            log_path,
            "\treq.24.OutputBackendDiagnosticsOwnership\t"
        ) &&
        outputDiagnosticFileContains(
            authority,
            log_path,
            "\tdiag.24.OutputBackendDiagnostics\t"
        )
}

internal procedure outputDiagnosticAppendCommandStart(
    text: unique string@Managed,
    authority: TestAuthority
) -> bool {
    var command_ready: bool = true
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        command_ready =
            diagnosticAppendText(text, "cmd.exe /C \"", authority.heap) &&
            command_ready
    }
    command_ready = diagnosticAppendQuoted(
        text,
        authority.compiler_executable_path,
        authority.heap
    ) && command_ready
    return command_ready
}

internal procedure outputDiagnosticAppendCommandFinish(
    text: unique string@Managed,
    authority: TestAuthority,
    output_path: string@View,
    error_path: string@View
) -> bool {
    var command_ready: bool =
        diagnosticAppendText(text, " > ", authority.heap)
    command_ready =
        diagnosticAppendQuoted(text, output_path, authority.heap) &&
        command_ready
    command_ready =
        diagnosticAppendText(text, " 2> ", authority.heap) &&
        command_ready
    command_ready =
        diagnosticAppendQuoted(text, error_path, authority.heap) &&
        command_ready
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        command_ready =
            diagnosticAppendText(text, "\"", authority.heap) &&
            command_ready
    }
    return command_ready
}

internal procedure outputDiagnosticRunCommand(
    authority: TestAuthority,
    command: unique string@Managed,
    output_path: string@View,
    error_path: string@View
) -> i32 {
    if !outputDiagnosticAppendCommandFinish(
        command,
        authority,
        output_path,
        error_path
    ) {
        return -1
    }
    let command_text: string@View = string::as_view(command)
    return authority.sys~>run(command_text)
}

internal procedure outputDiagnosticAppendRuntimeIncompatibleRuntimeLibPath(
    text: unique string@Managed,
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    return diagnosticAppendText(text, out_dir_path, authority.heap) &&
        diagnosticBuildPath(text, "Intermediate", authority.heap) &&
        diagnosticBuildPath(text, "Obj", authority.heap) &&
        diagnosticBuildPath(text, "Source", authority.heap) &&
        diagnosticBuildPath(text, "RuntimeIncompatible", authority.heap) &&
        diagnosticAppendText(
            text,
            outputDiagnosticObjectFileExtension(authority),
            authority.heap
        )
}

internal procedure outputDiagnosticAppendRuntimeIncompatibleRuntimeLibOverride(
    text: unique string@Managed,
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move path_result is {
        @Value { value } {
            if !outputDiagnosticAppendRuntimeIncompatibleRuntimeLibPath(
                value,
                authority,
                out_dir_path
            ) {
                false
            } else {
                let runtime_lib_path: string@View = string::as_view(value)
                diagnosticAppendText(text, " --runtime-lib ", authority.heap) &&
                    diagnosticAppendQuoted(text, runtime_lib_path, authority.heap)
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticAppendRuntimeLibOverrideForCheck(
    text: unique string@Managed,
    authority: TestAuthority,
    out_dir_path: string@View,
    conformance_check: OutputDiagnosticConformanceCheck
) -> bool {
    if conformance_check is OutputDiagnosticConformanceCheck::RuntimeIncompatible {
        return outputDiagnosticAppendRuntimeIncompatibleRuntimeLibOverride(
            text,
            authority,
            out_dir_path
        )
    }
    return true
}

internal procedure outputDiagnosticAppendAssemblyForCheck(
    text: unique string@Managed,
    authority: TestAuthority,
    conformance_check: OutputDiagnosticConformanceCheck
) -> bool {
    if conformance_check is OutputDiagnosticConformanceCheck::HostedImportGraph {
        return diagnosticAppendText(text, " --assembly ", authority.heap) &&
            diagnosticAppendText(text, "HostedImportGraph", authority.heap)
    }
    return true
}

internal procedure outputDiagnosticRunBuildCommand(
    authority: TestAuthority,
    fixture_path: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View,
    conformance_check: OutputDiagnosticConformanceCheck
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                outputDiagnosticAppendCommandStart(value, authority)
            command_ready =
                diagnosticAppendText(value, " build ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuotedProjectPath(value, authority, fixture_path) &&
                command_ready
            command_ready =
                outputDiagnosticAppendAssemblyForCheck(
                    value,
                    authority,
                    conformance_check
                ) && command_ready
            command_ready =
                diagnosticAppendText(value, " --target-profile ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, authority.target_profile, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(
                    value,
                    " --diag-json --build-progress off --out-dir ",
                    authority.heap
                ) && command_ready
            command_ready =
                diagnosticAppendQuoted(value, out_dir_path, authority.heap) &&
                command_ready
            command_ready =
                outputDiagnosticAppendRuntimeLibOverrideForCheck(
                    value,
                    authority,
                    out_dir_path,
                    conformance_check
                ) && command_ready
            if !string::is_empty(conformance_log_name) {
                command_ready =
                    diagnosticAppendText(value, " --conformance ", authority.heap) &&
                    command_ready
                command_ready =
                    diagnosticAppendText(value, conformance_log_name, authority.heap) &&
                    command_ready
            }
            if command_ready {
                outputDiagnosticRunCommand(
                    authority,
                    value,
                    output_path,
                    error_path
                )
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure outputDiagnosticRuntimeIncompatibleRuntimeLibExists(
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move path_result is {
        @Value { value } {
            if !outputDiagnosticAppendRuntimeIncompatibleRuntimeLibPath(
                value,
                authority,
                out_dir_path
            ) {
                false
            } else {
                let runtime_lib_path: string@View = string::as_view(value)
                authority.io~>exists(runtime_lib_path)
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticPrepareRuntimeIncompatibleRuntimeLibWithPaths(
    authority: TestAuthority,
    fixture_path: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View
) -> bool {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let status: i32 = outputDiagnosticRunBuildCommand(
        authority,
        fixture_path,
        output_path,
        error_path,
        out_dir_path,
        "",
        OutputDiagnosticConformanceCheck::None
    )
    let prepared: bool = status == 0 &&
        outputDiagnosticRuntimeIncompatibleRuntimeLibExists(authority, out_dir_path)
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    return prepared
}

internal procedure outputDiagnosticPrepareRuntimeIncompatibleRuntimeLibWithErrorPath(
    authority: TestAuthority,
    fixture_path: string@View,
    output_path: unique string@Managed,
    error_path: unique string@Managed,
    out_dir_path: string@View
) -> bool {
    let output_text_path: string@View = string::as_view(output_path)
    let error_text_path: string@View = string::as_view(error_path)
    return outputDiagnosticPrepareRuntimeIncompatibleRuntimeLibWithPaths(
        authority,
        fixture_path,
        output_text_path,
        error_text_path,
        out_dir_path
    )
}

internal procedure outputDiagnosticPrepareRuntimeIncompatibleRuntimeLibWithOutputPath(
    authority: TestAuthority,
    fixture_path: string@View,
    output_path: unique string@Managed,
    out_dir_path: string@View
) -> bool {
    let error_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move error_created is {
        @Value { value } {
            if !diagnosticBuildPath(
                value,
                "OutputDiagnosticRuntimeIncompatiblePrebuild.err",
                authority.heap
            ) {
                false
            } else {
                outputDiagnosticPrepareRuntimeIncompatibleRuntimeLibWithErrorPath(
                    authority,
                    fixture_path,
                    output_path,
                    value,
                    out_dir_path
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticPrepareRuntimeIncompatibleRuntimeLib(
    authority: TestAuthority,
    fixture_path: string@View,
    out_dir_path: string@View
) -> bool {
    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value } {
            if !diagnosticBuildPath(
                value,
                "OutputDiagnosticRuntimeIncompatiblePrebuild.out",
                authority.heap
            ) {
                false
            } else {
                outputDiagnosticPrepareRuntimeIncompatibleRuntimeLibWithOutputPath(
                    authority,
                    fixture_path,
                    value,
                    out_dir_path
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticPrepareRuntimeLibForBuildCase(
    authority: TestAuthority,
    fixture_path: string@View,
    out_dir_path: string@View,
    conformance_check: OutputDiagnosticConformanceCheck
) -> bool {
    if conformance_check is OutputDiagnosticConformanceCheck::RuntimeIncompatible {
        return outputDiagnosticPrepareRuntimeIncompatibleRuntimeLib(
            authority,
            fixture_path,
            out_dir_path
        )
    }
    return true
}

internal procedure outputDiagnosticRunUnknownCommand(
    authority: TestAuthority,
    output_path: string@View,
    error_path: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            let command_ready: bool =
                outputDiagnosticAppendCommandStart(value, authority) &&
                diagnosticAppendText(
                    value,
                    " definitely_unknown_command",
                    authority.heap
                )
            if command_ready {
                outputDiagnosticRunCommand(
                    authority,
                    value,
                    output_path,
                    error_path
                )
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure outputDiagnosticLlvmToolConformanceMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View
) -> bool {
    return outputDiagnosticBackendDiagnosticOwnershipMatchesAtPath(authority, log_path) &&
        outputDiagnosticFileContains(authority, log_path, "\tResolveTool-Err-IR\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tdef.EmitIRFailBC\t") &&
        outputDiagnosticFileContains(authority, log_path, "emit_ir%3Dbc") &&
        outputDiagnosticFileContains(authority, log_path, "stage%3Dresolve_tool") &&
        outputDiagnosticFileContains(authority, log_path, "\tOut-IR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOutput-Pipeline-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tEmitObj-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tEmitLLVM-Err\t")
}

internal procedure outputDiagnosticEmitLLVMConformanceMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View
) -> bool {
    return outputDiagnosticBackendDiagnosticOwnershipMatchesAtPath(authority, log_path) &&
        outputDiagnosticFileContains(authority, log_path, "\tResolveTool-Ok\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tAssembleIR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tdef.EmitIRFailBC\t") &&
        outputDiagnosticFileContains(authority, log_path, "emit_ir%3Dbc") &&
        outputDiagnosticFileContains(authority, log_path, "stage%3Dcodegen_ir") &&
        outputDiagnosticFileContains(authority, log_path, "\tEmitLLVM-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tEmit-IR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOut-IR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOutput-Pipeline-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tEmitObj-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tResolveTool-Err-IR\t")
}

internal procedure outputDiagnosticIRWriteConformanceMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View
) -> bool {
    return outputDiagnosticBackendDiagnosticOwnershipMatchesAtPath(authority, log_path) &&
        outputDiagnosticFileContains(authority, log_path, "\tOut-Dirs-Ok\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tCodegenIR-LLVM\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tdef.EmitIRFailLL\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tEmit-IR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOut-IR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOutput-Pipeline-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "assembly%3DIRWriteFailure") &&
        outputDiagnosticFileContains(authority, log_path, "module%3DIRWriteFailure") &&
        outputDiagnosticFileContains(authority, log_path, "emit_ir%3Dll") &&
        outputDiagnosticFileContains(authority, log_path, "stage%3Dwrite_file") &&
        outputDiagnosticFileContains(authority, log_path, "IRWriteFailure.ll") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tResolveTool-Err-IR\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tAssembleIR-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tEmitLLVM-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tOut-Obj-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tOut-IR-Cons-LL\t")
}

internal procedure outputDiagnosticLlvmTypeMappingConformanceMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View
) -> bool {
    return outputDiagnosticBackendDiagnosticOwnershipMatchesAtPath(authority, log_path) &&
        outputDiagnosticFileContains(authority, log_path, "\tLLVMTy-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tLLVMCall-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tLowerIR-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOut-Obj-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOutput-Pipeline-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "code%3DE-OUT-0410") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tEmitLLVM-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tResolveTool-Err-IR\t")
}

internal procedure outputDiagnosticLinkerToolConformanceMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View
) -> bool {
    return outputDiagnosticFileContains(authority, log_path, "\tResolveTool-Err-Linker\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tLink-NotFound\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOut-Final-Link-Err\t") &&
        outputDiagnosticFileContains(authority, log_path, "\tOutput-Pipeline-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tResolveTool-Err-Archiver\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tArchive-NotFound\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tOut-Final-Archive-Err\t") &&
        outputDiagnosticFileExcludes(authority, log_path, "\tLink-Ok\t") &&
