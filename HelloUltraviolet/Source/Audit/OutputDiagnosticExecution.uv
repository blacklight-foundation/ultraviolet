internal procedure outputDiagnosticMergeResult(
    first: DiagnosticFixtureExecutionResult,
    second: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    return diagnosticFixtureExecutionResult(
        first.passed && second.passed,
        first.count + second.count
    )
}

internal procedure outputDiagnosticReportNamedResult(
    authority: TestAuthority,
    name: string@View,
    result: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    if !result.passed {
        let _ = diagnosticReportFixtureFailure(
            authority,
            "output diagnostic exercise failed: ",
            name
        )
    }
    return result
}

internal procedure outputDiagnosticMergeNamedResult(
    authority: TestAuthority,
    accumulated: DiagnosticFixtureExecutionResult,
    name: string@View,
    next: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    return outputDiagnosticMergeResult(
        accumulated,
        outputDiagnosticReportNamedResult(authority, name, next)
    )
}

#test(name: "output diagnostic fixtures execute and emit expected diagnostics")
internal procedure outputDiagnosticFixturesExecuteAndEmitExpectedDiagnostics(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    var result: DiagnosticFixtureExecutionResult =
        outputDiagnosticReportNamedResult(
            authority,
            "outputDiagnosticUnknownCommand",
            outputDiagnosticUnknownCommand(authority)
        )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestParseErrorExercise",
        outputDiagnosticManifestParseErrorExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestMissingExercise",
        outputDiagnosticManifestMissingExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticDirSeqReadFailureExercise",
        outputDiagnosticDirSeqReadFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestRequiredTypesInvalidExercise",
        outputDiagnosticManifestRequiredTypesInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestOutDirTypeInvalidExercise",
        outputDiagnosticManifestOutDirTypeInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestEmitIRTypeInvalidExercise",
        outputDiagnosticManifestEmitIRTypeInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestLinkKindTypeInvalidExercise",
        outputDiagnosticManifestLinkKindTypeInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestLinkKindInvalidExercise",
        outputDiagnosticManifestLinkKindInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestLinkKindUseInvalidExercise",
        outputDiagnosticManifestLinkKindUseInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestToolchainInvalidExercise",
        outputDiagnosticManifestToolchainInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticHostedImportGraphExercise",
        outputDiagnosticHostedImportGraphExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestEmitIRInvalidExercise",
        outputDiagnosticManifestEmitIRInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticManifestOutDirPathInvalidExercise",
        outputDiagnosticManifestOutDirPathInvalidExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticLlvmToolResolveOwnershipExercise",
        outputDiagnosticLlvmToolResolveOwnershipExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticEmitLLVMRenderFailureExercise",
        outputDiagnosticEmitLLVMRenderFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticLlvmTypeMappingFailureExercise",
        outputDiagnosticLlvmTypeMappingFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticLinkerToolResolveFailureExercise",
        outputDiagnosticLinkerToolResolveFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticArchiverToolResolveFailureExercise",
        outputDiagnosticArchiverToolResolveFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticLinkerInvocationFailureExercise",
        outputDiagnosticLinkerInvocationFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticArchiverInvocationFailureExercise",
        outputDiagnosticArchiverInvocationFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticRuntimeLibMissingExercise",
        outputDiagnosticRuntimeLibMissingExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticRuntimeIncompatibleExercise",
        outputDiagnosticRuntimeIncompatibleExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticDirectoryPreparationFailureExercise",
        outputDiagnosticDirectoryPreparationFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticObjectWriteFailureExercise",
        outputDiagnosticObjectWriteFailureExercise(authority)
    )
    result = outputDiagnosticMergeNamedResult(
        authority,
        result,
        "outputDiagnosticIRWriteFailureExercise",
        outputDiagnosticIRWriteFailureExercise(authority)
    )
    return result.passed &&
        result.count == expectedOutputDiagnosticFixtureCount()
}
