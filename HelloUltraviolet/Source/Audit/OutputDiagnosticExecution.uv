        }
    }
}

internal procedure outputDiagnosticRunIcacls(
    authority: TestAuthority,
    path: string@View,
    acl_operation: string@View
) -> bool {
    if !auditTextEquals(authority.target_profile, "x86_64-win64") {
        return false
    }

    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("cmd.exe /C icacls ", authority.heap)
    return if move created is {
        @Value { value } {
            let command_ready: bool =
                diagnosticAppendQuoted(value, path, authority.heap) &&
                diagnosticAppendText(value, acl_operation, authority.heap) &&
                diagnosticAppendText(value, " > nul 2> nul", authority.heap)
            if !command_ready {
                false
            } else {
                let command_text: string@View = string::as_view(value)
                authority.sys~>run(command_text) == 0
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticRunChmod(
    authority: TestAuthority,
    path: string@View,
    mode: string@View
) -> bool {
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        return false
    }

    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("chmod ", authority.heap)
    return if move created is {
        @Value { value } {
            let command_ready: bool =
                diagnosticAppendText(value, mode, authority.heap) &&
                diagnosticAppendText(value, " ", authority.heap) &&
                diagnosticAppendQuoted(value, path, authority.heap) &&
                diagnosticAppendText(value, " > /dev/null 2> /dev/null", authority.heap)
            if !command_ready {
                false
            } else {
                let command_text: string@View = string::as_view(value)
                authority.sys~>run(command_text) == 0
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticDirSeqReadFailureDenyAccess(
    authority: TestAuthority,
    path: string@View
) -> bool {
    if !auditTextEquals(authority.target_profile, "x86_64-win64") {
        return outputDiagnosticRunChmod(authority, path, "000")
    }

    return outputDiagnosticRunIcacls(
        authority,
        path,
        " /deny \"*S-1-5-11:(RX)\" /Q"
    )
}

internal procedure outputDiagnosticDirSeqReadFailureRestoreAccess(
    authority: TestAuthority,
    path: string@View
) -> bool {
    if !auditTextEquals(authority.target_profile, "x86_64-win64") {
        return outputDiagnosticRunChmod(authority, path, "700")
    }

    return outputDiagnosticRunIcacls(
        authority,
        path,
        " /remove:d \"*S-1-5-11\" /Q"
    )
}

internal procedure outputDiagnosticWriteTextFile(
    authority: TestAuthority,
    path: string@View,
    text: string@View
) -> bool {
    let write_result: Outcome<(), IoError> =
        authority.io~>write_file(path, bytes::view_string(text))
    return diagnosticIoSucceeded(write_result)
}

internal procedure outputDiagnosticWriteDirSeqManifest(
    authority: TestAuthority,
    project_root: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(project_root, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "Ultraviolet.toml", authority.heap) {
                false
            } else {
                let manifest_path: string@View = string::as_view(value)
                outputDiagnosticWriteTextFile(
                    authority,
                    manifest_path,
                    "[[assembly]]\nname = \"DirSeqReadFailure\"\nkind = \"executable\"\nroot = \"Source\"\nemit_ir = \"ll\"\n\n[build]\nincremental = true\nprogress = false\n"
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticWriteDirSeqSource(
    authority: TestAuthority,
    source_root: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(source_root, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "Main.uv", authority.heap) {
                false
            } else {
                let source_path: string@View = string::as_view(value)
                outputDiagnosticWriteTextFile(
                    authority,
                    source_path,
                    "//! Source for the DirSeq read-error output diagnostic.\n\npublic procedure main(context: Context) -> i32 {\n    return 0\n}\n"
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticStageDirSeqReadFailureProject(
    authority: TestAuthority,
    project_root: string@View,
    blocked_dir: string@View
) -> bool {
    let _ = outputDiagnosticDirSeqReadFailureRestoreAccess(authority, blocked_dir)
    let _ = authority.io~>remove(project_root)
    let project_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(project_root)
    if !diagnosticIoSucceeded(project_ready) {
        return false
    }

    let source_result: Outcome<unique string@Managed, AllocationError> =
        string::from(project_root, authority.heap)
    return if move source_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "Source", authority.heap) {
                false
            } else {
                let source_root: string@View = string::as_view(value)
                let source_ready: Outcome<(), IoError> =
                    authority.io~>ensure_dir(source_root)
                let blocked_ready: Outcome<(), IoError> =
                    authority.io~>ensure_dir(blocked_dir)
                if !diagnosticIoSucceeded(source_ready) ||
                    !diagnosticIoSucceeded(blocked_ready) {
                    false
                } else if !outputDiagnosticWriteDirSeqManifest(
                    authority,
                    project_root
                ) || !outputDiagnosticWriteDirSeqSource(authority, source_root) {
                    false
                } else {
                    outputDiagnosticDirSeqReadFailureDenyAccess(
                        authority,
                        blocked_dir
                    )
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticPrepareFilesystem(
    authority: TestAuthority,
    out_dir_path: string@View,
    filesystem_setup: OutputDiagnosticFilesystemSetup
) -> bool {
    if filesystem_setup is OutputDiagnosticFilesystemSetup::None {
        return true
    }
    if filesystem_setup is OutputDiagnosticFilesystemSetup::DirectoryPreparationFailure {
        return outputDiagnosticPrepareDirectoryFailure(authority, out_dir_path)
    }
    if filesystem_setup is OutputDiagnosticFilesystemSetup::ObjectWriteFailure {
        return outputDiagnosticPrepareObjectWriteFailure(authority, out_dir_path)
    }
    if filesystem_setup is OutputDiagnosticFilesystemSetup::IRWriteFailure {
        return outputDiagnosticPrepareIRWriteFailure(authority, out_dir_path)
    }
    return false
}

internal procedure outputDiagnosticBuildCaseWithPaths(
    authority: TestAuthority,
    fixture_path: string@View,
    expected_path: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View,
    filesystem_setup: OutputDiagnosticFilesystemSetup,
    conformance_check: OutputDiagnosticConformanceCheck
) -> DiagnosticFixtureExecutionResult {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let out_dir_ready: Outcome<(), IoError> = authority.io~>ensure_dir(out_dir_path)
    if !diagnosticIoSucceeded(out_dir_ready) ||
        !outputDiagnosticPrepareFilesystem(
            authority,
            out_dir_path,
            filesystem_setup
        ) ||
        !outputDiagnosticPrepareRuntimeLibForBuildCase(
            authority,
            fixture_path,
            out_dir_path,
            conformance_check
        ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    let status: i32 = outputDiagnosticRunBuildCommand(
        authority,
        fixture_path,
        output_path,
        error_path,
        out_dir_path,
        conformance_log_name,
        conformance_check
    )
    if status == 0 {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let matched_count: usize =
        outputDiagnosticActualMatchesExpected(authority, expected_path, output_path)
    if matched_count == 0usize {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !outputDiagnosticConformanceMatches(
        authority,
        out_dir_path,
        conformance_check
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, matched_count)
}

internal procedure outputDiagnosticBuildCaseWithOutDirPath(
    authority: TestAuthority,
    fixture_path: string@View,
    expected_path: string@View,
    output_path: unique string@Managed,
    error_path: unique string@Managed,
    out_dir_path: unique string@Managed,
    conformance_log_name: string@View,
    filesystem_setup: OutputDiagnosticFilesystemSetup,
    conformance_check: OutputDiagnosticConformanceCheck
) -> DiagnosticFixtureExecutionResult {
    let output_text_path: string@View = string::as_view(output_path)
    let error_text_path: string@View = string::as_view(error_path)
    let out_dir_text_path: string@View = string::as_view(out_dir_path)
    return outputDiagnosticBuildCaseWithPaths(
