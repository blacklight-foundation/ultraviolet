                diagnosticBuildPath(value, "Conformance", authority.heap) &&
                diagnosticBuildPath(
                    value,
                    "RuntimeLibMissing.conformance.log",
                    authority.heap
                ) {
                let log_path: string@View = string::as_view(value)
                outputDiagnosticRuntimeMissingConformanceMatchesAtPath(
                    authority,
