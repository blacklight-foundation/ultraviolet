internal procedure outputDiagnosticConformanceCheckMatchesAtPath(
    authority: TestAuthority,
    log_path: string@View,
    conformance_check: OutputDiagnosticConformanceCheck
) -> bool {
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestMissing {
        return outputDiagnosticManifestMissingConformanceMatchesAtPath(authority, log_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::DirSeqReadFailure {
        return outputDiagnosticDirSeqReadFailureConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestRequiredTypes {
        return outputDiagnosticManifestRequiredTypesConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestOutDirType {
        return outputDiagnosticManifestOutDirTypeConformanceMatchesAtPath(authority, log_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestEmitIRType {
        return outputDiagnosticManifestEmitIRTypeConformanceMatchesAtPath(authority, log_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestLinkKindType {
        return outputDiagnosticManifestLinkKindTypeConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestLinkKindValue {
        return outputDiagnosticManifestLinkKindValueConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestLinkKindUse {
        return outputDiagnosticManifestLinkKindUseConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestToolchain {
        return outputDiagnosticManifestToolchainConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestEmitIRValue {
        return outputDiagnosticManifestEmitIRValueConformanceMatchesAtPath(
            authority,
            log_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestOutDirPath {
        return outputDiagnosticManifestOutDirPathConformanceMatchesAtPath(authority, log_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::HostedImportGraph {
        return outputDiagnosticHostedImportGraphConformanceMatchesAtPath(authority, log_path)
    }
    return false
}

internal procedure outputDiagnosticNamedConformanceMatches(
    authority: TestAuthority,
    out_dir_path: string@View,
    log_name: string@View,
    conformance_check: OutputDiagnosticConformanceCheck
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(out_dir_path, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, "Logs", authority.heap) &&
                diagnosticBuildPath(value, "Conformance", authority.heap) &&
                diagnosticBuildPath(value, log_name, authority.heap) {
                let log_path: string@View = string::as_view(value)
                outputDiagnosticConformanceCheckMatchesAtPath(
                    authority,
                    log_path,
                    conformance_check
                )
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticConformanceMatches(
    authority: TestAuthority,
    out_dir_path: string@View,
    conformance_check: OutputDiagnosticConformanceCheck
) -> bool {
    if conformance_check is OutputDiagnosticConformanceCheck::None {
        return true
    }
    if conformance_check is OutputDiagnosticConformanceCheck::LlvmTool {
        return outputDiagnosticLlvmToolConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::EmitLLVM {
        return outputDiagnosticEmitLLVMConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::LlvmTypeMapping {
        return outputDiagnosticLlvmTypeMappingConformanceMatches(
            authority,
            out_dir_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::LinkerTool {
        return outputDiagnosticLinkerToolConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ArchiverTool {
        return outputDiagnosticArchiverToolConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::LinkFailure {
        return outputDiagnosticLinkFailureConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ArchiveFailure {
        return outputDiagnosticArchiveFailureConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::RuntimeMissing {
        return outputDiagnosticRuntimeMissingConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::RuntimeIncompatible {
        return outputDiagnosticRuntimeIncompatibleConformanceMatches(
            authority,
            out_dir_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::HostedImportGraph {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "HostedImportGraph.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestMissing {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestMissing.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::DirSeqReadFailure {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "DirSeqReadFailure.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestRequiredTypes {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestRequiredTypesInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestOutDirType {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestOutDirTypeInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestEmitIRType {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestEmitIRTypeInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestLinkKindType {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestLinkKindTypeInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestLinkKindValue {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestLinkKindInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestLinkKindUse {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestLinkKindUseInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestToolchain {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestToolchainInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestEmitIRValue {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestEmitIRInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ManifestOutDirPath {
        return outputDiagnosticNamedConformanceMatches(
            authority,
            out_dir_path,
            "ManifestOutDirPathInvalid.conformance.log",
            conformance_check
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::DirectoryPreparation {
        return outputDiagnosticDirectoryPreparationConformanceMatches(
            authority,
            out_dir_path
        )
    }
    if conformance_check is OutputDiagnosticConformanceCheck::ObjectWrite {
        return outputDiagnosticObjectWriteConformanceMatches(authority, out_dir_path)
    }
    if conformance_check is OutputDiagnosticConformanceCheck::IRWrite {
        return outputDiagnosticIRWriteConformanceMatches(authority, out_dir_path)
    }
    return false
}

internal procedure outputDiagnosticPrepareDirectoryFailure(
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(out_dir_path, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "Intermediate", authority.heap) {
                false
            } else {
                let intermediate_path: string@View = string::as_view(value)
                let write_result: Outcome<(), IoError> =
                    authority.io~>write_file(
                        intermediate_path,
                        bytes::view_string("not a directory")
                    )
                diagnosticIoSucceeded(write_result)
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticEnsureManagedPath(
    authority: TestAuthority,
    path: unique string@Managed
) -> bool {
    let path_view: string@View = string::as_view(path)
    let ready: Outcome<(), IoError> = authority.io~>ensure_dir(path_view)
    return diagnosticIoSucceeded(ready)
}

internal procedure outputDiagnosticPrepareObjectWriteFailure(
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(out_dir_path, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "Intermediate", authority.heap) ||
                !outputDiagnosticEnsureManagedPath(authority, value) ||
                !diagnosticBuildPath(value, "Obj", authority.heap) ||
                !outputDiagnosticEnsureManagedPath(authority, value) ||
                !diagnosticBuildPath(value, "Source", authority.heap) ||
                !outputDiagnosticEnsureManagedPath(authority, value) ||
                !diagnosticBuildPath(
                    value,
                    "ObjectWriteFailure",
                    authority.heap
                ) ||
                !diagnosticAppendText(
                    value,
                    outputDiagnosticObjectFileExtension(authority),
                    authority.heap
                ) ||
                !outputDiagnosticEnsureManagedPath(authority, value) ||
                !diagnosticBuildPath(value, "blocked.txt", authority.heap) {
                false
            } else {
                let block_path: string@View = string::as_view(value)
                let write_result: Outcome<(), IoError> =
                    authority.io~>write_file(
                        block_path,
                        bytes::view_string("block object replacement")
                    )
                diagnosticIoSucceeded(write_result)
            }
        }
        @Error {
            false
        }
    }
}

internal procedure outputDiagnosticPrepareIRWriteFailure(
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(out_dir_path, authority.heap)
    return if move path_result is {
