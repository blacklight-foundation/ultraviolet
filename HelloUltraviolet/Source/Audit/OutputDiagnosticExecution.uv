internal procedure outputDiagnosticLlvmToolConformanceMatches(
    authority: TestAuthority,
    out_dir_path: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(out_dir_path, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, "Logs", authority.heap) &&
                diagnosticBuildPath(value, "Conformance", authority.heap) &&
                diagnosticBuildPath(
                    value,
                    "LlvmToolResolveOwnership.conformance.log",
                    authority.heap
                ) {
                let log_path: string@View = string::as_view(value)
                outputDiagnosticLlvmToolConformanceMatchesAtPath(authority, log_path)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

