internal procedure outputDiagnosticDirSeqReadFailureBuildCaseWithPaths(
    authority: TestAuthority,
    project_root: string@View,
    blocked_dir: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View
) -> DiagnosticFixtureExecutionResult {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let out_dir_ready: Outcome<(), IoError> = authority.io~>ensure_dir(out_dir_path)
    if !diagnosticIoSucceeded(out_dir_ready) ||
        !outputDiagnosticStageDirSeqReadFailureProject(
            authority,
            project_root,
            blocked_dir
        ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let status: i32 = outputDiagnosticRunBuildCommand(
        authority,
        project_root,
        output_path,
        error_path,
        out_dir_path,
        "DirSeqReadFailure.conformance.log",
        OutputDiagnosticConformanceCheck::DirSeqReadFailure
    )
    let restored: bool =
        outputDiagnosticDirSeqReadFailureRestoreAccess(authority, blocked_dir)
    if !restored || status == 0 {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let matched_count: usize =
        outputDiagnosticActualMatchesExpected(
            authority,
            "Fixtures/OutputDiagnostics/Projects/DirSeqReadFailure/Expected.uv",
            output_path
        )
    if matched_count == 0usize {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !outputDiagnosticConformanceMatches(
        authority,
        out_dir_path,
        OutputDiagnosticConformanceCheck::DirSeqReadFailure
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, matched_count)
}

