//! Root catalog accounting for generated obligation entries.

public let EXPECTED_OBLIGATION_COUNT: usize = 5019

public let BLOCKED_OBLIGATION_COUNT: usize = 1033

public procedure catalogObligationCount() -> usize {
    return EXPECTED_OBLIGATION_COUNT
}

public procedure catalogBlockedObligationCount() -> usize {
    return BLOCKED_OBLIGATION_COUNT
}

public procedure catalogAccountedObligationCount() -> usize {
    return EXPECTED_OBLIGATION_COUNT + BLOCKED_OBLIGATION_COUNT
}
