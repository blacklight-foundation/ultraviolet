//! Output-diagnostic project-loader specimens.

internal procedure outputProjectDiagnosticEntryMatches(
    specimen_name: string@View,
    fixture_path: string@View,
    manifest_path: string@View,
    expected_path: string@View,
    diagnostic_code: string@View,
    obligation_id: string@View
) -> bool {
    return diagnosticSpecimenMatches(
        diagnosticSpecimen(
            specimen_name,
            fixture_path,
            manifest_path,
            expected_path,
            expectedDiagnostic(diagnostic_code, obligation_id)
        ),
        specimen_name,
        fixture_path,
        manifest_path,
        expected_path,
        diagnostic_code,
        obligation_id
    )
}

internal procedure outputProjectDiagnosticEntryCount(
    specimen_name: string@View,
    fixture_path: string@View,
    manifest_path: string@View,
    expected_path: string@View,
    diagnostic_code: string@View,
    obligation_id: string@View
) -> usize {
    if outputProjectDiagnosticEntryMatches(
        specimen_name,
        fixture_path,
        manifest_path,
        expected_path,
        diagnostic_code,
        obligation_id
    ) {
        return 1usize
    }
    return 0usize
}

public procedure outputProjectDiagnosticFixtureCount() -> usize {
    return 39usize
}

