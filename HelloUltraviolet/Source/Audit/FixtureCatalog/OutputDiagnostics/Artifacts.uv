//! Runtime checks for output-diagnostic fixture artifacts.

using HelloUltraviolet::Audit::{ auditTextContains }
using HelloUltraviolet::Audit::{ auditTextEquals }

internal procedure outputDiagnosticFixtureArtifactsExistAtPaths(
    context: Context,
    manifest_path: string@View,
    source_path: string@View,
    expected_path: string@View
) -> bool {
    return context.io~>exists(manifest_path) &&
        context.io~>exists(source_path) &&
        context.io~>exists(expected_path)
}

internal procedure outputDiagnosticFixtureArtifactsExistWithoutManifestAtPaths(
    context: Context,
    source_path: string@View,
    expected_path: string@View
) -> bool {
    return context.io~>exists(source_path) &&
        context.io~>exists(expected_path)
}

public procedure outputDiagnosticFixtureArtifactsExist(context: Context) -> bool {
    return outputDiagnosticFixtureArtifactsExistAtPaths(
        context,
        "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmToolResolveOwnership/Ultraviolet.toml",
        "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmToolResolveOwnership/Source/Library.uv",
        "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmToolResolveOwnership/Expected.uv"
    ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/EmitLLVMRenderFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/EmitLLVMRenderFailure/Source/Library.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/EmitLLVMRenderFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmTypeMappingFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmTypeMappingFailure/Source/Library.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmTypeMappingFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestParseError/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestParseError/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestParseError/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistWithoutManifestAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestMissing/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestMissing/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestRequiredTypesInvalid/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestRequiredTypesInvalid/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestRequiredTypesInvalid/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestOutDirTypeInvalid/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestOutDirTypeInvalid/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestOutDirTypeInvalid/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestEmitIRTypeInvalid/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestEmitIRTypeInvalid/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestEmitIRTypeInvalid/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestLinkKindTypeInvalid/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestLinkKindTypeInvalid/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestLinkKindTypeInvalid/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestEmitIRInvalid/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestEmitIRInvalid/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestEmitIRInvalid/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestOutDirPathInvalid/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestOutDirPathInvalid/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/ManifestOutDirPathInvalid/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/HostedImportGraph/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/HostedImportGraph/Source/HostedImportGraph/Library.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/HostedImportGraph/Expected.uv"
        ) &&
        context.io~>exists(
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Projects/HostedImportGraph/Source/HostedImportProvider/Library.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerToolResolveFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerToolResolveFailure/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerToolResolveFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverToolResolveFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverToolResolveFailure/Source/Library.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverToolResolveFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/RuntimeLibMissing/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/RuntimeLibMissing/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/RuntimeLibMissing/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/RuntimeIncompatible/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/RuntimeIncompatible/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/RuntimeIncompatible/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerInvocationFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerInvocationFailure/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerInvocationFailure/Expected.uv"
        ) &&
        context.io~>exists(
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/LinkerInvocationFailure/Tools/lld-link.exe"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverInvocationFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverInvocationFailure/Source/Library.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverInvocationFailure/Expected.uv"
        ) &&
        context.io~>exists(
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Linking/ArchiverInvocationFailure/Tools/llvm-lib.exe"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/DirectoryPreparationFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/DirectoryPreparationFailure/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/DirectoryPreparationFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/ObjectWriteFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/ObjectWriteFailure/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/ObjectWriteFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/IRWriteFailure/Ultraviolet.toml",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/IRWriteFailure/Source/Main.uv",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/OutputPipeline/IRWriteFailure/Expected.uv"
        ) &&
        outputDiagnosticFixtureArtifactsExistAtPaths(
            context,
            "HelloUltraviolet/Fixtures/OutputDiagnostics/CommandLine/UnknownCommand/Invocation.txt",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/CommandLine/UnknownCommand/Output.txt",
            "HelloUltraviolet/Fixtures/OutputDiagnostics/CommandLine/UnknownCommand/Expected.uv"
        ) &&
        context.io~>exists(
            "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/EmitLLVMRenderFailure/Tools/llvm-as.exe"
        )
}

internal procedure outputDiagnosticExpectedFileMatches(
    context: Context,
    expected_path: string@View,
    expected_text: string@View
) -> bool {
    let read_result: Outcome<unique string@Managed, IoError> = context.io~>read_file(expected_path)
    return if move read_result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            auditTextEquals(text, expected_text)
        }
        @Error {
            false
        }
    }
}

public procedure llvmToolResolveOwnershipExpectedDiagnosticFileMatches(
    context: Context
) -> bool {
    return outputDiagnosticExpectedFileMatches(
        context,
        "HelloUltraviolet/Fixtures/OutputDiagnostics/Lowering/LlvmToolResolveOwnership/Expected.uv",
        "//! Expected diagnostic metadata for the LlvmToolResolveOwnership output-diagnostic specimen.\n\nexpectedDiagnostic(\"E-OUT-0403\", \"requirement.24.LLVMToolAcceptanceAndResolveOwnership\")\n"
    )
}

