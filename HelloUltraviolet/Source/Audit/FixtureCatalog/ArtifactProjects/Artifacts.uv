internal procedure artifactProjectExpectedFileMatches(
    context: Context,
    expected_path: string@View,
    expected_text: string@View
) -> bool {
    let read_result: Outcome<unique string@Managed, IoError> = context.io~>read_file(expected_path)
    return if move read_result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            auditTextEquals(text, expected_text)
        }
        @Error {
            false
        }
    }
}

public procedure reducedEmptyDispatchPanicExpectedArtifactMatches(context: Context) -> bool {
    return artifactProjectExpectedFileMatches(
        context,
        "HelloUltraviolet/Fixtures/ArtifactProjects/ReducedEmptyDispatchPanic/Expected.uv",
        "//! Expected runtime panic metadata for the ReducedEmptyDispatchPanic artifact specimen.\n\nexpectedDiagnostic(\"P-SEM-2862\", \"requirement.20.StructuredParallelismRuntimePanicOwnership\")\nexpectedDiagnostic(\"P-SEM-2862\", \"diagnostics.20.StructuredParallelismSupplement\")\n"
    )
}

internal procedure artifactTextContains(
    context: Context,
    artifact_path: string@View,
    required_text: string@View
) -> bool {
    let read_result: Outcome<unique string@Managed, IoError> = context.io~>read_file(artifact_path)
    return if move read_result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            auditTextContains(text, required_text)
        }
        @Error {
            false
        }
    }
}

internal procedure artifactTextExcludes(
    context: Context,
    artifact_path: string@View,
    forbidden_text: string@View
) -> bool {
    let read_result: Outcome<unique string@Managed, IoError> = context.io~>read_file(artifact_path)
    return if move read_result is {
        @Value { value } {
            let text: string@View = string::as_view(value)
            !auditTextContains(text, forbidden_text)
        }
        @Error {
            false
        }
    }
}

public procedure artifactProjectEmitLlLibrarySRetCallSiteAttrsMatch(context: Context) -> bool {
    let ir_path: string@View =
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitLlLibrary/Build/Intermediate/IR/Source/EmitLlLibrary.ll"
    return context.io~>exists(ir_path) &&
        artifactTextContains(
            context,
            ir_path,
            "call void @EmitLlLibrary_x3a_x3aemitLlSRetPair(ptr noalias noundef nonnull sret("
        )
}

public procedure artifactProjectEmitLlLibraryLLVMAlignmentAuditMatches(
    context: Context
) -> bool {
    let ir_path: string@View =
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitLlLibrary/Build/Intermediate/IR/Source/EmitLlLibrary.ll"
    return context.io~>exists(ir_path) &&
        artifactTextContains(
            context,
            ir_path,
            "EmitLlLibrary_x3a_x3aemitLlRuntimeCreateWriteCarrierProbe"
        ) &&
        artifactTextExcludes(
            context,
            ir_path,
            "ptr noundef nonnull align 16 dereferenceable(16)"
        )
}

public procedure artifactProjectEmitLlLibraryRuntimeCreateWriteCarrierMatches(
    context: Context
) -> bool {
    let ir_path: string@View =
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitLlLibrary/Build/Intermediate/IR/Source/EmitLlLibrary.ll"
    return context.io~>exists(ir_path) &&
        (
            artifactTextContains(
                context,
                ir_path,
                "call void @ultraviolet_x3a_x3aruntime_x3a_x3aio_x3a_x3acreate_x5fwrite(ptr noalias noundef nonnull sret("
            ) ||
            artifactTextContains(
                context,
                ir_path,
                "call [2 x i64] @ultraviolet_x3a_x3aruntime_x3a_x3aio_x3a_x3acreate_x5fwrite("
            ) ||
            artifactTextContains(
                context,
                ir_path,
                "call { i64, i64 } @ultraviolet_x3a_x3aruntime_x3a_x3aio_x3a_x3acreate_x5fwrite("
            )
        )
}

public procedure artifactProjectRuntimeErasureArtifactsMatch(context: Context) -> bool {
    let ir_path: string@View =
        "HelloUltraviolet/Fixtures/ArtifactProjects/FlowProofRuntimeErasure/Build/Intermediate/IR/Source/FlowProofRuntimeErasure.ll"
    return context.io~>exists(ir_path) &&
        context.io~>exists(
            "HelloUltraviolet/Fixtures/ArtifactProjects/FlowProofRuntimeErasure/Build/Intermediate/Obj/Source/FlowProofRuntimeErasure.obj"
        ) &&
        artifactTextExcludes(context, ir_path, "VerificationFact") &&
        artifactTextExcludes(context, ir_path, "FlowFactsAt") &&
        artifactTextExcludes(context, ir_path, "ProofContextAt") &&
        artifactTextExcludes(context, ir_path, "ContractFactsAt") &&
        artifactTextExcludes(context, ir_path, "ContractCheck") &&
        artifactTextExcludes(context, ir_path, "ContractViolation") &&
        artifactTextExcludes(context, ir_path, "Precondition")
}

public procedure artifactProjectAArch64DependencyObjectArtifactsExist(context: Context) -> bool {
    return context.io~>exists(
        "HelloUltraviolet/Fixtures/ArtifactProjects/AArch64DependencyObject/Build/Intermediate/Obj/Source/AArch64DependencyObject.o"
    ) &&
        context.io~>exists(
            "HelloUltraviolet/Fixtures/ArtifactProjects/AArch64DependencyObject/Build/Intermediate/Incremental/AArch64DependencyObject.manifest"
        )
}

public procedure artifactProjectEmitBcLibraryArtifactsExist(context: Context) -> bool {
    let target_profile: string@View = auditTargetProfile(context.sys)
    let object_path: string@View = if auditTargetProfileIsWindows(target_profile) {
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitBcLibrary/Build/Intermediate/Obj/Source/EmitBcLibrary.obj"
    } else {
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitBcLibrary/Build/Intermediate/Obj/Source/EmitBcLibrary.o"
    }
    let library_path: string@View = if auditTargetProfileIsWindows(target_profile) {
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitBcLibrary/Build/Library/EmitBcLibrary.lib"
    } else {
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitBcLibrary/Build/Library/libEmitBcLibrary.a"
    }
    return context.io~>exists(
        "HelloUltraviolet/Fixtures/ArtifactProjects/EmitBcLibrary/Build/Intermediate/IR/Source/EmitBcLibrary.bc"
    ) &&
        context.io~>exists(object_path) &&
        context.io~>exists(library_path)
}

