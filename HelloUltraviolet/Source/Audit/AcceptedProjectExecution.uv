//! Source-native compiler execution checks for accepted project fixtures.

internal let ACCEPTED_PROJECT_EXECUTED_OBLIGATION_COUNT: usize = 291usize

internal procedure acceptedProjectTargetIsWindows(authority: TestAuthority) -> bool {
    return auditTextEquals(authority.target_profile, "x86_64-win64")
}

internal procedure acceptedProjectTargetPath(
    authority: TestAuthority,
    windows_path: string@View,
    sysv_path: string@View
) -> string@View {
    if acceptedProjectTargetIsWindows(authority) {
        return windows_path
    }
    return sysv_path
}

internal procedure acceptedProjectTempFileExists(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    file_suffix: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, out_dir_suffix, authority.heap) &&
                diagnosticBuildPath(value, file_suffix, authority.heap) {
                let path: string@View = string::as_view(value)
                authority.io~>exists(path)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure acceptedProjectTempFileDoesNotExist(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    file_suffix: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, out_dir_suffix, authority.heap) &&
                diagnosticBuildPath(value, file_suffix, authority.heap) {
                let path: string@View = string::as_view(value)
                !authority.io~>exists(path)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure acceptedProjectTempFileContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    file_suffix: string@View,
    required_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, out_dir_suffix, authority.heap) &&
                diagnosticBuildPath(value, file_suffix, authority.heap) {
                let path: string@View = string::as_view(value)
                outputDiagnosticFileContains(authority, path, required_text)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure acceptedProjectConformanceContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    log_name: string@View,
    required_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) ||
                !diagnosticBuildPath(value, "Logs", authority.heap) ||
                !diagnosticBuildPath(value, "Conformance", authority.heap) ||
                !diagnosticBuildPath(value, log_name, authority.heap) {
                false
            } else {
                let path: string@View = string::as_view(value)
                outputDiagnosticFileContains(authority, path, required_text)
            }
        }
        @Error {
            false
        }
    }
}

internal procedure acceptedProjectConformanceTextContainsLine(
    text: string@View,
    required_marker: string@View,
    required_payload: string@View
) -> bool {
    let text_length: usize = string::length(text)
    var line_start: usize = 0usize
    var index: usize = 0usize
    loop index <= text_length {
        if index == text_length || auditTextByte(text, index) == 10u8 {
            let line: string@View = string::slice(text, line_start, index)
            if auditTextContains(line, required_marker) &&
                auditTextContains(line, required_payload) {
                return true
            }
            line_start = index + 1usize
        }
        index = index + 1usize
    }
    return false
}

internal procedure acceptedProjectConformanceLineContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    log_name: string@View,
    required_marker: string@View,
    required_payload: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) ||
                !diagnosticBuildPath(value, "Logs", authority.heap) ||
                !diagnosticBuildPath(value, "Conformance", authority.heap) ||
                !diagnosticBuildPath(value, log_name, authority.heap) {
                false
            } else {
                let path: string@View = string::as_view(value)
                let read_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(path)
                if move read_result is {
                    @Value { value: text } {
                        acceptedProjectConformanceTextContainsLine(
                            string::as_view(text),
                            required_marker,
                            required_payload
                        )
                    }
                    @Error {
                        false
                    }
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure acceptedProjectRunBuildCommand(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                outputDiagnosticAppendCommandStart(value, authority)
            command_ready =
                diagnosticAppendText(value, " build ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuotedProjectPath(value, authority, fixture_path) &&
                command_ready
            if !string::is_empty(assembly_name) {
                command_ready =
                    diagnosticAppendText(value, " --assembly ", authority.heap) &&
                    command_ready
                command_ready =
                    diagnosticAppendText(value, assembly_name, authority.heap) &&
                    command_ready
            }
            command_ready =
                diagnosticAppendText(value, " --target-profile ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, authority.target_profile, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(
                    value,
                    " --diag-json --build-progress off --incremental off --out-dir ",
                    authority.heap
                ) && command_ready
            command_ready =
                diagnosticAppendQuoted(value, out_dir_path, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --conformance ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, conformance_log_name, authority.heap) &&
                command_ready
            if command_ready {
                outputDiagnosticRunCommand(
                    authority,
                    value,
                    output_path,
                    error_path
                )
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure acceptedProjectRunCaseWithPaths(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View
) -> bool {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let _ = authority.io~>ensure_dir(out_dir_path)
    let status: i32 = acceptedProjectRunBuildCommand(
        authority,
        fixture_path,
        assembly_name,
        output_path,
        error_path,
        out_dir_path,
        conformance_log_name
    )
    if status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "accepted project build failed: ",
            fixture_path
        )
    }
    return true
}

internal procedure acceptedProjectRunCaseWithOutDir(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    output_path: unique string@Managed,
    error_path: unique string@Managed,
    out_dir_path: unique string@Managed,
    conformance_log_name: string@View
) -> bool {
    let output_text_path: string@View = string::as_view(output_path)
    let error_text_path: string@View = string::as_view(error_path)
    let out_dir_text_path: string@View = string::as_view(out_dir_path)
    return acceptedProjectRunCaseWithPaths(
        authority,
        fixture_path,
        assembly_name,
        output_text_path,
        error_text_path,
        out_dir_text_path,
        conformance_log_name
    )
}

internal procedure acceptedProjectRunCaseWithError(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    output_path: unique string@Managed,
    error_path: unique string@Managed,
    out_dir_suffix: string@View,
    conformance_log_name: string@View
) -> bool {
    let out_dir_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move out_dir_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) {
                false
            } else {
                acceptedProjectRunCaseWithOutDir(
                    authority,
                    fixture_path,
                    assembly_name,
                    output_path,
                    error_path,
                    value,
                    conformance_log_name
                )
            }
        }
        @Error {
            false
        }
    }
}

