            "AcceptedProjectHostedBuild",
            "Logs/BuildTelemetry.tsv",
            "finalize-finish\tHostedExportLibrary\tmode=link;status=ok"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectHostedBuild",
            "hosted.conformance.log",
            "\tLink-Ok\t"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectHostedBuild",
            "hosted.conformance.log",
            "\tOut-Final-Link-Ok\t"
        ) &&
        acceptedProjectHostedConformanceMatches(authority) &&
        acceptedProjectHostedMapMatches(authority)
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, 39usize)
}

#test(name: "accepted project fixtures build and exercise artifact obligations")
internal procedure acceptedProjectFixturesBuildAndExerciseArtifactObligations(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    var result: DiagnosticFixtureExecutionResult =
        acceptedProjectStaticLibraryExercise(authority)
    result = outputDiagnosticMergeResult(
        result,
        acceptedProjectExecutableExercise(authority)
    )
    result = outputDiagnosticMergeResult(
        result,
        acceptedProjectCrossAssemblyExercise(authority)
    )
    result = outputDiagnosticMergeResult(
        result,
        acceptedProjectHostedExercise(authority)
    )
    return result.passed &&
        result.count == ACCEPTED_PROJECT_EXECUTED_OBLIGATION_COUNT
}
