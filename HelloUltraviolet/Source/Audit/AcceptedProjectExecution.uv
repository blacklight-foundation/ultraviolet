internal procedure acceptedProjectCrossAssemblyExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !acceptedProjectRunCase(
        authority,
        "Fixtures/AcceptedProjects/CrossAssemblyImplementation",
        "CrossAssemblyImplementation",
        "AcceptedProjectCross.out",
        "AcceptedProjectCross.err",
        "AcceptedProjectCrossBuild",
        "cross.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let passed: bool =
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectCrossBuild",
            "Binary/CrossAssemblyImplementation.dll"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectCrossBuild",
            "Intermediate/Obj/Source/ExternalContracts/ExternalContracts.obj"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectCrossBuild",
            "Intermediate/Obj/Source/CrossAssemblyImplementation/CrossAssemblyImplementation.obj"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectCrossBuild",
            "cross.conformance.log",
            "\tT-Orphan-Rule\t"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AcceptedProjectCrossBuild",
            "Logs/BuildTelemetry.tsv",
            "obj-module\tCrossAssemblyImplementation\tmodule=ExternalContracts;status=ok"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AcceptedProjectCrossBuild",
            "Logs/BuildTelemetry.tsv",
            "obj-module\tCrossAssemblyImplementation\tmodule=CrossAssemblyImplementation;status=ok"
        )
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, 1usize)
}

