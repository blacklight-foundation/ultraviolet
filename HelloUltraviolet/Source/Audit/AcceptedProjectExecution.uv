            "AcceptedProjectExpressionSemanticsBuild",
            "expression-semantics.conformance.log",
            "\tLayout-Tuple\t"
        )
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, 229usize)
}

