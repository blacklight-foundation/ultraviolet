internal procedure acceptedProjectRunCase(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    conformance_log_name: string@View
) -> bool {
    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, output_suffix, authority.heap) {
                false
            } else {
                acceptedProjectRunCaseWithOutput(
                    authority,
                    fixture_path,
                    assembly_name,
                    value,
                    error_suffix,
                    out_dir_suffix,
                    conformance_log_name
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure acceptedProjectStaticLibraryExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !acceptedProjectRunCase(
        authority,
        "Fixtures/AcceptedProjects/StaticLibrary",
        "",
        "AcceptedProjectStatic.out",
        "AcceptedProjectStatic.err",
        "AcceptedProjectStaticBuild",
        "static.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let passed: bool =
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectStaticBuild",
            acceptedProjectTargetPath(
                authority,
                "Intermediate/Obj/Source/StaticLibrary.obj",
                "Intermediate/Obj/Source/StaticLibrary.o"
            )
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectStaticBuild",
            acceptedProjectTargetPath(
                authority,
                "Library/StaticLibrary.lib",
                "Library/libStaticLibrary.a"
            )
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectStaticBuild",
            "static.conformance.log",
            "\tArchive-Ok\t"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectStaticBuild",
            "static.conformance.log",
            "\tFinalize-Archive\t"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectStaticBuild",
            "static.conformance.log",
            "\tOut-Final-Archive-Ok\t"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AcceptedProjectStaticBuild",
            "Logs/BuildTelemetry.tsv",
            "finalize-finish\tStaticLibrary\tmode=archive;status=ok"
        )
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, 3usize)
}

