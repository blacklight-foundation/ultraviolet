internal procedure acceptedProjectHostedImportLibraryMatches(
    authority: TestAuthority
) -> bool {
    if acceptedProjectTargetIsWindows(authority) {
        return acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectHostedBuild",
            "Library/HostedExportLibrary.lib"
        )
    }

    return acceptedProjectTempFileDoesNotExist(
        authority,
        "AcceptedProjectHostedBuild",
        "Library/libHostedExportLibrary.so.import"
    )
}

internal procedure acceptedProjectHostedExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !acceptedProjectRunCase(
        authority,
        "Fixtures/AcceptedProjects/HostedExportLibrary",
        "",
        "AcceptedProjectHosted.out",
        "AcceptedProjectHosted.err",
        "AcceptedProjectHostedBuild",
        "hosted.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let passed: bool =
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectHostedBuild",
            acceptedProjectTargetPath(
                authority,
                "Binary/HostedExportLibrary.dll",
                "Binary/libHostedExportLibrary.so"
            )
        ) &&
        acceptedProjectHostedImportLibraryMatches(authority) &&
        acceptedProjectTempFileExists(
            authority,
            "AcceptedProjectHostedBuild",
            acceptedProjectTargetPath(
                authority,
                "Binary/HostedExportLibrary.map",
                "Binary/libHostedExportLibrary.so.exports.map"
            )
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AcceptedProjectHostedBuild",
            "Logs/BuildTelemetry.tsv",
            "export_symbols=12;data_export_symbols=1"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AcceptedProjectHostedBuild",
            "Logs/BuildTelemetry.tsv",
            "finalize-finish\tHostedExportLibrary\tmode=link;status=ok"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectHostedBuild",
            "hosted.conformance.log",
            "\tLink-Ok\t"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "AcceptedProjectHostedBuild",
            "hosted.conformance.log",
            "\tOut-Final-Link-Ok\t"
        ) &&
        acceptedProjectHostedConformanceMatches(authority) &&
        acceptedProjectHostedMapMatches(authority)
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, 50usize)
}

internal procedure acceptedProjectReportNamedResult(
    authority: TestAuthority,
    name: string@View,
    result: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    if !result.passed {
        let _ = diagnosticReportFixtureFailure(
            authority,
            "accepted project exercise failed: ",
            name
        )
    }
    return result
}

internal procedure acceptedProjectMergeNamedResult(
    authority: TestAuthority,
    accumulated: DiagnosticFixtureExecutionResult,
    name: string@View,
    next: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    return outputDiagnosticMergeResult(
        accumulated,
        acceptedProjectReportNamedResult(authority, name, next)
    )
}

#test(name: "accepted project lowering checks judgement set obligation")
internal procedure acceptedProjectLoweringChecksJudgementSetObligation(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    let result: DiagnosticFixtureExecutionResult =
        acceptedProjectLoweringChecksJudgementSetExercise(authority)
    return result.passed && result.count == 1usize
}

#test(name: "accepted project fixtures build and exercise artifact obligations")
internal procedure acceptedProjectFixturesBuildAndExerciseArtifactObligations(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    var result: DiagnosticFixtureExecutionResult =
        acceptedProjectReportNamedResult(
            authority,
            "acceptedProjectStaticLibraryExercise",
            acceptedProjectStaticLibraryExercise(authority)
        )
    result = acceptedProjectMergeNamedResult(
        authority,
        result,
        "acceptedProjectExecutableExercise",
        acceptedProjectExecutableExercise(authority)
    )
    result = acceptedProjectMergeNamedResult(
        authority,
        result,
        "acceptedProjectCrossAssemblyExercise",
        acceptedProjectCrossAssemblyExercise(authority)
    )
    result = acceptedProjectMergeNamedResult(
        authority,
        result,
        "acceptedProjectPtrNullReturnExercise",
        acceptedProjectPtrNullReturnExercise(authority)
    )
    result = acceptedProjectMergeNamedResult(
        authority,
        result,
        "acceptedProjectExpressionSemanticsExercise",
        acceptedProjectExpressionSemanticsExercise(authority)
    )
    result = acceptedProjectMergeNamedResult(
        authority,
        result,
        "acceptedProjectHostedExercise",
        acceptedProjectHostedExercise(authority)
    )
    return result.passed &&
        result.count == ACCEPTED_PROJECT_EXECUTED_OBLIGATION_COUNT
}
