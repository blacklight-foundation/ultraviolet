internal procedure acceptedProjectHostedTargetCarrierConformanceMatches(
    authority: TestAuthority
) -> bool {
    if !acceptedProjectTargetIsWindows(authority) {
        return acceptedProjectHostedConformanceContains(
                authority,
                "\trule.23.HostThunkParamCarrier-ByValue-Default\t"
            ) &&
            acceptedProjectHostedConformanceContains(
                authority,
                "\trule.23.HostThunkRetCarrier-Default\t"
            )
    }

    return acceptedProjectHostedConformanceContains(
            authority,
            "\trule.23.HostThunkParamCarrier-Win64-DirectAgg\t"
        ) &&
        acceptedProjectHostedConformanceContains(
            authority,
            "\trule.23.HostThunkParamCarrier-Win64-IndirectAgg\t"
        ) &&
        acceptedProjectHostedConformanceContains(
            authority,
            "\trule.23.HostThunkRetCarrier-Win64-DirectAgg\t"
        ) &&
        acceptedProjectHostedConformanceContains(
            authority,
            "\trule.23.HostThunkRetCarrier-Win64-SRetAgg\t"
        )
}

