    return acceptedProjectHostedMapFileContains(
            authority,
            "hostedReferenceTripleEcho_x3a_x3a_x5f_x5fhost_x5fbody"
        ) &&
        acceptedProjectHostedMapFileContains(authority, "uv_host_session_try_enter") &&
