//! Pattern-specific compiler conformance checks.

internal let PATTERN_LOWERING_PROJECT_PATH: string@View =
    "Fixtures/Patterns/PatternLoweringConformance"
internal let PATTERN_LOWERING_CONFORMANCE_LOG_NAME: string@View =
    "pattern-lowering.conformance.log"

internal procedure patternLoweringProjectRuns(
    authority: TestAuthority,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View
) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }
    return acceptedProjectRunCase(
        authority,
        PATTERN_LOWERING_PROJECT_PATH,
        "",
        output_suffix,
        error_suffix,
        out_dir_suffix,
        PATTERN_LOWERING_CONFORMANCE_LOG_NAME
    )
}

internal procedure patternLoweringConformanceContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    required_text: string@View
) -> bool {
    return acceptedProjectConformanceContains(
        authority,
        out_dir_suffix,
        PATTERN_LOWERING_CONFORMANCE_LOG_NAME,
        required_text
    )
}

internal procedure patternConformanceLineContainsRequiredPayload(
    line: string@View,
    required_payload: string@View
) -> bool {
    return string::is_empty(required_payload) ||
        auditTextContains(line, required_payload)
}

internal procedure patternConformanceLineMatchesEntry(
    line: string@View,
    obligation_marker: string@View,
    required_payload_one: string@View,
    required_payload_two: string@View,
    required_payload_three: string@View
) -> bool {
    return auditTextContains(line, obligation_marker) &&
        patternConformanceLineContainsRequiredPayload(line, required_payload_one) &&
        patternConformanceLineContainsRequiredPayload(line, required_payload_two) &&
        patternConformanceLineContainsRequiredPayload(line, required_payload_three)
}

internal procedure patternConformanceTextContainsEntry(
    text: string@View,
    obligation_marker: string@View,
    required_payload_one: string@View,
    required_payload_two: string@View,
    required_payload_three: string@View
) -> bool {
    let text_length: usize = string::length(text)
    var line_start: usize = 0usize
    var index: usize = 0usize
    loop index <= text_length {
        if index == text_length || auditTextByte(text, index) == 10u8 {
            let line: string@View = string::slice(text, line_start, index)
            if patternConformanceLineMatchesEntry(
                line,
                obligation_marker,
                required_payload_one,
                required_payload_two,
                required_payload_three
            ) {
                return true
            }
            line_start = index + 1usize
        }
        index = index + 1usize
    }
    return false
}

internal procedure patternLoweringConformanceContainsEntry(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    obligation_marker: string@View,
    required_payload_one: string@View,
    required_payload_two: string@View,
    required_payload_three: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        Outcome::Value(value) {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) ||
                !diagnosticBuildPath(value, "Logs", authority.heap) ||
                !diagnosticBuildPath(value, "Conformance", authority.heap) ||
                !diagnosticBuildPath(
                    value,
                    PATTERN_LOWERING_CONFORMANCE_LOG_NAME,
                    authority.heap
                ) {
                false
            } else {
                let path: string@View = string::as_view(value)
                let read_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(path)
                if move read_result is {
                    Outcome::Value(text) {
                        patternConformanceTextContainsEntry(
                            string::as_view(text),
                            obligation_marker,
                            required_payload_one,
                            required_payload_two,
                            required_payload_three
                        )
                    }
                    Outcome::Error(_) {
                        false
                    }
                }
            }
        }
        Outcome::Error(_) {
            false
        }
    }
}

internal procedure patternLoweringProjectContainsEntry(
    authority: TestAuthority,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    obligation_marker: string@View,
    required_payload_one: string@View,
    required_payload_two: string@View,
    required_payload_three: string@View
) -> bool {
    return patternLoweringProjectRuns(
            authority,
            output_suffix,
            error_suffix,
            out_dir_suffix
        ) &&
        patternLoweringConformanceContainsEntry(
            authority,
            out_dir_suffix,
            obligation_marker,
            required_payload_one,
            required_payload_two,
            required_payload_three
        )
}

internal procedure patternLoweringProjectContainsMarker(
    authority: TestAuthority,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    marker: string@View
) -> bool {
    return patternLoweringProjectRuns(
            authority,
            output_suffix,
            error_suffix,
            out_dir_suffix
        ) &&
        patternLoweringConformanceContains(authority, out_dir_suffix, marker)
}

#test(name: "pattern binding environment emits exact conformance marker")
internal procedure patternBindingEnvironmentConformanceMatches(
    authority: TestAuthority
) -> bool
|: |= @result
{
    return patternLoweringProjectContainsMarker(
        authority,
        "PatternBindingEnvironment.out",
        "PatternBindingEnvironment.err",
        "PatternBindingEnvironmentBuild",
        "\tdef.17.PatternBindingEnvironment\t"
    )
}

