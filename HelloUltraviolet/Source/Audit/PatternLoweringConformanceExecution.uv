#test(name: "pattern Lower-Pat correctness emits exact conformance marker")
internal procedure patternLowerPatCorrectnessConformanceMatches(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let out_dir: string@View = "PatternLowerPatCorrectnessBuild"
    return patternLoweringProjectContainsEntry(
        authority,
        "PatternLowerPatCorrectness.out",
        "PatternLowerPatCorrectness.err",
        out_dir,
        "\trule.17.Lower-Pat-Correctness\t",
        "operation%3DLowerBindPattern%3Bmatch_pattern%3Dtrue",
        "bind_order%3Dpattern_order%3Blower_bind_list%3Dtrue",
        "bind_count%3D"
    )
}

