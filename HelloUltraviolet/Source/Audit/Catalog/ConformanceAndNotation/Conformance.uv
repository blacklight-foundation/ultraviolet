        226usize,
        "HelloUltraviolet::Reference::Conformance",
        "runConformanceTranslationOrderingReference",
        "Source/Reference/Conformance/TranslationOrdering.uv"
    ) {
        count = count + 1usize
    }
    if acceptedObligationEntryMatches(
        "def.Phase3Order",
        245usize,
        "HelloUltraviolet::Reference::Conformance",
        "runConformanceTranslationOrderingReference",
        "Source/Reference/Conformance/TranslationOrdering.uv"
    ) {
