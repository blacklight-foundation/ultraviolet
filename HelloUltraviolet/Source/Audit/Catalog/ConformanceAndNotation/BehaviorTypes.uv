    if acceptedObligationEntryMatches(
        "def.JudgmentSubjectAndEnvironment",
        587usize,
        "HelloUltraviolet::Audit",
        "artifactProjectEmitLlExercise",
        "Source/Audit/ArtifactProjectExecution.uv"
    ) {
        count = count + 1usize
    }
    if acceptedObligationEntryMatches(
        "def.RuntimeCheck",
        784usize,
        "HelloUltraviolet::Audit",
        "artifactProjectRuntimeCheckBehaviorExercise",
        "Source/Audit/ArtifactProjectExecution.uv"
    ) {
        count = count + 1usize
    }
    return count
}
