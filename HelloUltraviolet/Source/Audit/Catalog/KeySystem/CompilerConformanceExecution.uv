            "source%3DLowerKeyBlockStmt%3Bkind%3Dordinary%3Bnew_scope%3Dtrue%3Bcanonical_sort%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.KeyCoarseningInlineMarker\t",
            "source%3DLowerKeyPaths%3Bmarked_boundary%3Dtrue%3Bacquisition_granularity%3Dmarked_position%3Bcovers_subsequent_segments%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
