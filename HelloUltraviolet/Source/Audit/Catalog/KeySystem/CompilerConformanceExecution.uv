        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.KeyPathWellFormedness\t",
            "source%3DValidateKeyPathConformance%3Bsegments_type_valid%3Dtrue%3Bmarker_count%3D0%3Bmarker_limit%3Dat_most_one"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.KeyAnalysisSharedOnly\t",
            "source%3DValidateKeyPathConformance%3Broot_permission%3Dshared%3Bconst_or_unique_roots_require_keys%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.LowerKeyPathsEmpty\t",
            "source%3DLowerKeyPaths%3Bbranch%3Dempty"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.LowerKeyPathsCons\t",
            "source%3DLowerKeyPaths%3Bbranch%3Dcons"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-Stmt-KeyBlock\t",
            "source%3DLowerKeyBlockStmt%3Bkind%3Dordinary%3Blower_key_paths%3Dtrue%3Bcanonical_sort%3Dtrue%3Bcheck_conflict_before_acquire%3Dtrue%3Bacquire_order%3Dcanonical%3Bscope_exit_registered%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.SpeculativeIR\t",
            "source%3DLowerKeyBlockStmt%3Bkind%3Dspeculative%3Bhas_snapshot%3Dtrue%3Bhas_validate%3Dtrue%3Bhas_commit%3Dtrue%3Bhas_retry%3Dtrue%3Bhas_fallback%3Dtrue%3Bfallback_conflict_acquire_release%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-Stmt-KeyBlock-Speculative\t",
