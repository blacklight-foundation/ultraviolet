            "source%3DLowerKeyBlockStmt%3Bcanonical_order%3Dtrue%3Bcanonical_sort%3Dtrue%3Bconflict_relation%3DKeyConflict"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.KeyBlockRuntimeJudgments\t",
            "source%3DLowerKeyBlockStmt%3Bjudgments%3DAcquireKeysSigma,ReleaseKeysSigma%3Bkind%3Dordinary"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.AcquireKeysSigma\t",
            "source%3DLowerKeyBlockStmt%3Bkeys%3DCanonicalOrder(KeyPath(paths))%3Bacquire_lock%3Dtrue%3Bheld_keys_update%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.ScopeExitKeyRelease\t",
            "source%3DLowerKeyBlockStmt%3Bscope_exit_registered%3Dtrue%3Brelease_before_scope_drop%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.KeyScopeBound\t",
            "source%3DLowerKeyBlockStmt%3Bscope_exit_registered%3Dtrue%3Bkey_dependent_access_bound_to_scope%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.KeyAcquisitionEvaluationOrder\t",
