        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.KeyLoweringForms\t",
            "source%3DLowerKeyPaths%3Bforms%3DLowerKeyPath,LowerKeyAccess"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-KeyPath\t",
            "source%3DLowerKeyPaths%3Bbranch%3Dcons"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-KeyAccess-Uncovered\t",
            "source%3DLowerImplicitKeyAccess%3Bcovered%3Dfalse%3Bcheck_conflict%3Dtrue%3Bacquire_key%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-KeyAccess-Covered\t",
            "source%3DLowerImplicitKeyAccess%3Bcovered%3Dtrue%3Bemits_ir%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.MemoryOrderingDefaultsAndKeySemantics\t",
            "source%3DLowerKeyBlockStmt%3Bdefault_access_order%3Drelaxed%3Bkey_acquire_order%3Dacquire%3Bkey_release_order%3Drelease%3Bkey_semantics_unchanged%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.MemoryOrderAttributeAttachment\t",
            "source%3DLowerKeyBlockStmt%3Battachment%3Dkey_block"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.MemoryOrderAttributeAttachment\t",
            "source%3DLowerAttributedExpr%3Battachment%3Dattributed_expression"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.ExpressionMemoryOrderWellFormedness\t",
            "source%3DLowerAttributedExpr%3Battachment%3Dattributed_expression%3Bcontains_keyed_or_shared_access%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.FenceEvaluation\t",
            "source%3DLowerExpr%3Bexpr%3DFenceExpr%3Bevent%3DFenceIR%3Bvalue%3DUnitVal"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.FenceOrderingConstraints\t",
            "source%3DLowerExpr%3Bexpr%3DFenceExpr%3Border%3Dacquire%3Bsequenced_before_constraints%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-Expr-Fence\t",
            "source%3DLowerExpr%3Bexpr%3DFenceExpr%3Bir%3DFenceIR%3Bvalue%3DUnitVal"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-Ordered-Access\t",
            "source%3DApplyEffectiveOrdering%3Bcontains_shared_access%3Dtrue%3Bordered_access_ir%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.NestedReleaseNoAdditionalSyntax\t",
            "source%3DParseKeyBlockStmt%3Bhead%3Drelease%3Badditional_syntax%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.NestedReleaseNoAdditionalParsingRules\t",
            "source%3DParseKeyBlockStmt%3Bhead%3Drelease%3Badditional_parsing_rules%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.DirectCalleeAccesses\t",
            "source%3DProcedureKeyAccessSummaryBuilder%3Bdirect_callee_accesses%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.NestedReleaseExecutionSequence\t",
            "source%3DLowerKeyBlockStmt%3Bkind%3DRelease%3Brelease_outer%3Dtrue%3Bacquire_inner%3Dtrue%3Brelease_inner%3Dtrue%3Breacquire_outer%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.NestedReleaseInterleavingWindow\t",
