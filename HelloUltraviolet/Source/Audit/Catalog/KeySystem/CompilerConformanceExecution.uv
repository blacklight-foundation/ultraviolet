            "source%3DLowerKeyBlockStmt%3Bdynamic_key_path%3Dtrue%3Bcanonical_order%3Dtrue%3Bno_circular_wait%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
