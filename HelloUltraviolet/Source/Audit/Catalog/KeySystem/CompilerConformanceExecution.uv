//! Key-system accepted-project compiler conformance checks.

internal let KEY_SYSTEM_CONFORMANCE_PROJECT_PATH: string@View =
    "Fixtures/AcceptedProjects/KeySystemConformance"
internal let KEY_SYSTEM_CONFORMANCE_LOG_NAME: string@View =
    "key_system.conformance.log"

internal procedure keySystemConformanceProjectRuns(
    authority: TestAuthority,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View
) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }
    return acceptedProjectRunCase(
        authority,
        KEY_SYSTEM_CONFORMANCE_PROJECT_PATH,
        "",
        output_suffix,
        error_suffix,
        out_dir_suffix,
        KEY_SYSTEM_CONFORMANCE_LOG_NAME
    )
}

internal procedure keySystemConformanceLineContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    required_marker: string@View,
    required_payload: string@View
) -> bool {
    return acceptedProjectConformanceLineContains(
        authority,
        out_dir_suffix,
        KEY_SYSTEM_CONFORMANCE_LOG_NAME,
        required_marker,
        required_payload
    )
}

internal procedure keySystemConformanceArtifactsExist(
    authority: TestAuthority,
    out_dir_suffix: string@View
) -> bool {
    return acceptedProjectTempFileExists(
            authority,
            out_dir_suffix,
            "Intermediate/Obj/Source/KeySystemConformance.obj"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            out_dir_suffix,
            "Library/KeySystemConformance.lib"
        )
}

#test(name: "key system compiler conformance artifact matches")
internal procedure keySystemCompilerConformanceArtifactMatches(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let out_dir: string@View = "KeySystemConformanceBuild"
    return keySystemConformanceProjectRuns(
            authority,
            "KeySystemConformance.out",
            "KeySystemConformance.err",
            out_dir
        ) &&
        keySystemConformanceArtifactsExist(authority, out_dir) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.ConflictDetectionNoAdditionalSyntax\t",
            "source%3DParseKeyBlockStmt%3Bsurface%3Dkey_block_stmt%3Badditional_syntax%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.ConflictDetectionNoAdditionalParsingRules\t",
            "source%3DParseKeyBlockStmt%3Bparser%3Dkey_block_stmt%3Badditional_parsing_rules%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.IndexEquivalenceConservativeSubset\t",
            "source%3DProvablyEquivalentIndexExpr%3Brecognized_subset%3Dstructural,const_eval,binding_identity,path_identity%3Bfailure_treated_as_inequivalence%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.DynamicIndexDisjointnessConservativeSubset\t",
            "source%3DProvablyDisjointIndexExpr%3Brecognized_subset%3Dconst_eval,proof_not_equal,affine_offset,dispatch_index,loop_range%3Bfailure_treated_as_possible_overlap%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.ReadThenWriteOtherWriteForms\t",
            "source%3DTypeKeyBlockStmt%3Bwrite_form%3Dordinary_write%3Bgoverned_by%3DRequiredMode,Covered,KeyCompatibility%3Brequired_mode%3Dwrite%3Bcovered_by_explicit_key%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.CanonicalOrderDynamicUse\t",
            "source%3DLowerKeyBlockStmt%3Bdynamic_key_path%3Dtrue%3Bcoarsened_runtime_path%3Dtrue%3Bcanonical_sort%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.KeyConflictRuntimeCompatibility\t",
            "source%3DLowerConflictChecks%3Bruntime_relation%3DKeyModeCompatible,KeysOverlap,KeyConflict%3Boperation%3DCheckConflict"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\tdef.19.LowerConflictChecks\t",
            "source%3DLowerConflictChecks%3Blower_key_paths%3Dtrue%3Bcanonical_sort%3Dtrue%3Boperation%3DCheckConflict"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trule.19.Lower-Key-ConflictChecks\t",
            "source%3DLowerConflictChecks%3Blower_key_paths%3Dtrue%3Bcanonical_sort%3Dtrue%3Boperation%3DCheckConflict"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.DynamicKeyVerificationNoAdditionalSyntax\t",
            "source%3DTypeKeyBlockStmt%3Battribute%3Ddynamic%3Battribute_parser%3Dgeneric%3Badditional_key_syntax%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.DynamicKeyVerificationNoAdditionalParsingRules\t",
            "source%3DTypeKeyBlockStmt%3Battribute%3Ddynamic%3Battribute_parser%3Dgeneric%3Badditional_key_parse_rules%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.StaticallySafeSoundProofRequired\t",
            "statically_safe%3Dfalse%3Bcomplete_sound_proof%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.NoRuntimeSyncMeaning\t",
            "statically_safe%3Dtrue%3Bruntime_sync_required%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.DynamicContextStaticSafeLowering\t",
            "dynamic_context%3Dtrue%3Bstatically_safe%3Dtrue%3Blowering%3Dordinary_key_lowering%3Bruntime_sync_required%3Dfalse"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.RuntimeSynchronizationRequirements\t",
            "source%3DLowerKeyBlockStmt%3Bdynamic_key_path%3Dtrue%3Bruntime_sync_emitted%3Dtrue%3Bmutual_exclusion%3DKeyConflict,KeyModeCompatible%3Bblocks_until_release%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.DynamicIndexRuntimeOrdering\t",
            "source%3DLowerKeyBlockStmt%3Bdynamic_key_path%3Dtrue%3Bordering_relation%3Dcanonical_coarsened_path%3Btotal%3Dtrue%3Bantisymmetric%3Dtrue%3Btransitive%3Dtrue%3Bcross_task_consistent%3Dtrue%3Bvalue_deterministic%3Dtrue"
        ) &&
        keySystemConformanceLineContains(
            authority,
            out_dir,
            "\trequirement.19.DynamicIndexedPathCoarsening\t",
