//! Generated catalog markers for 2. Diagnostic Infrastructure / 2.6 Diagnostic Rendering.


public procedure countDiagnosticInfrastructureDiagnosticRenderingObligations() -> usize {
    return 2usize
}

public procedure validatedDiagnosticInfrastructureDiagnosticRenderingObligations() -> usize {
    var count: usize = 0usize
    if acceptedObligationEntryMatches(
        "def.DiagnosticRender",
        1780usize,
        "HelloUltraviolet::Reference::Diagnostics",
        "runDiagnosticsRenderingInputsReference",
        "Source/Reference/Diagnostics/RenderingInputs.uv"
    ) {
        count = count + 1usize
    }
    if acceptedObligationEntryMatches(
        "def.DiagnosticRenderComponents",
        1796usize,
        "HelloUltraviolet::Reference::Diagnostics",
        "runDiagnosticsRenderingInputsReference",
        "Source/Reference/Diagnostics/RenderingInputs.uv"
    ) {
        count = count + 1usize
    }
    return count
}
