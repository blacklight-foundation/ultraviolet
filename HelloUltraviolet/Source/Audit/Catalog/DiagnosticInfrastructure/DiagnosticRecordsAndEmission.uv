//! Generated catalog markers for 2. Diagnostic Infrastructure / 2.3 Diagnostic Records and Emission.


public procedure countDiagnosticInfrastructureDiagnosticRecordsAndEmissionObligations() -> usize {
    return 4usize
}

public procedure validatedDiagnosticInfrastructureDiagnosticRecordsAndEmissionObligations() -> usize {
    var count: usize = 0usize
    if acceptedObligationEntryMatches(
        "def.DiagnosticSeverity",
        1505usize,
        "HelloUltraviolet::Reference::Diagnostics",
        "runDiagnosticsDiagnosticRecordsReference",
        "Source/Reference/Diagnostics/DiagnosticRecords.uv"
    ) {
        count = count + 1usize
    }
    if acceptedObligationEntryMatches(
        "def.DiagCodeOpt",
        1520usize,
        "HelloUltraviolet::Reference::Diagnostics",
        "runDiagnosticsDiagnosticRecordsReference",
        "Source/Reference/Diagnostics/DiagnosticRecords.uv"
    ) {
        count = count + 1usize
    }
    if acceptedObligationEntryMatches(
        "def.Diagnostic",
        1534usize,
        "HelloUltraviolet::Reference::Diagnostics",
        "runDiagnosticsDiagnosticRecordsReference",
        "Source/Reference/Diagnostics/DiagnosticRecords.uv"
    ) {
        count = count + 1usize
    }
    if acceptedObligationEntryMatches(
        "req.DiagnosticCodeOwnership",
        1548usize,
        "HelloUltraviolet::Reference::Diagnostics",
        "runDiagnosticsDiagnosticRecordsReference",
        "Source/Reference/Diagnostics/DiagnosticRecords.uv"
    ) {
        count = count + 1usize
    }
    return count
}
