//! Compile-time diagnostic fixture execution checks.

internal procedure comptimeDiagnosticFixtureMatchesExpectedDiagnostics(
    authority: TestAuthority,
    fixture_path: string@View,
    should_reject: bool,
    expected_count: usize
) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    let result =
        diagnosticExerciseProjectFixtureDirectory(authority, fixture_path, should_reject)
    return result.passed &&
        result.count == expected_count
}

#test(name: "comptime project files invalid path emits expected diagnostics")
internal procedure comptimeProjectFilesInvalidPathEmitsExpectedDiagnostics(
    authority: TestAuthority
) -> bool
|: |= @result
{
    return comptimeDiagnosticFixtureMatchesExpectedDiagnostics(
            authority,
            "Fixtures/DiagnosticSource/Comptime/ProjectFilesInvalidPath",
            false,
            1usize
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "DiagnosticFixtureBuild",
            "DiagnosticFixture.conformance.log",
            "\trequirement.22.ProjectFilesPathRestrictions\t"
        )
}

#test(name: "comptime emitter emit non-item rejects with exact diagnostics")
internal procedure comptimeEmitterEmitNonItemRejectsWithExactDiagnostics(
    authority: TestAuthority
) -> bool
|: |= @result
{
    return comptimeDiagnosticFixtureMatchesExpectedDiagnostics(
        authority,
        "Fixtures/RejectedSource/Comptime/EmitterEmitNonItem",
        true,
        3usize
    )
}

