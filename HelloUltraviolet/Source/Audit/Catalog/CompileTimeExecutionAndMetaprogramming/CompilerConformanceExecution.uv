//! Compile-time accepted-project compiler conformance checks.

internal let COMPTIME_CONFORMANCE_PROJECT_PATH: string@View =
    "Fixtures/AcceptedProjects/ComptimeConformance"
internal let COMPTIME_CONFORMANCE_LOG_NAME: string@View =
    "comptime.conformance.log"

internal procedure comptimeConformanceProjectRuns(
    authority: TestAuthority,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View
) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }
    return acceptedProjectRunCase(
        authority,
        COMPTIME_CONFORMANCE_PROJECT_PATH,
        "",
        output_suffix,
        error_suffix,
        out_dir_suffix,
        COMPTIME_CONFORMANCE_LOG_NAME
    )
}

internal procedure comptimeConformanceContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    required_text: string@View
) -> bool {
    return acceptedProjectConformanceContains(
        authority,
        out_dir_suffix,
        COMPTIME_CONFORMANCE_LOG_NAME,
        required_text
    )
}

internal procedure comptimeConformanceArtifactsExist(
    authority: TestAuthority,
    out_dir_suffix: string@View
) -> bool {
    return acceptedProjectTempFileExists(
            authority,
            out_dir_suffix,
            "Intermediate/Obj/Source/ComptimeConformance.obj"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            out_dir_suffix,
            "Library/ComptimeConformance.lib"
        )
}

#test(name: "comptime accepted project emits phase execution conformance")
internal procedure comptimeAcceptedProjectPhaseExecutionConformanceMatches(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let out_dir: string@View = "ComptimePhaseExecutionBuild"
    return comptimeConformanceProjectRuns(
            authority,
            "ComptimePhaseExecution.out",
            "ComptimePhaseExecution.err",
            out_dir
        ) &&
        comptimeConformanceArtifactsExist(authority, out_dir) &&
        comptimeConformanceContains(authority, out_dir, "\tExecuteComptime\t") &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "\tExecuteComptime-By-ComptimePass\t"
        ) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "\trequirement.22.Phase2ExecutionPosition\t"
        ) &&
        comptimeConformanceContains(authority, out_dir, "\tComptimePass\t") &&
        comptimeConformanceContains(authority, out_dir, "\tComptimePass-Cons\t") &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "\tPhase2-Deterministic-Dependency-Order\t"
        ) &&
        comptimeConformanceContains(authority, out_dir, "\tCtExecModule\t")
}

