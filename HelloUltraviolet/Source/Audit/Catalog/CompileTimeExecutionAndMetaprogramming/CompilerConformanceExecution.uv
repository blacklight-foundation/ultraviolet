#test(name: "comptime type availability conformance matches")
internal procedure comptimeTypeAvailabilityConformanceMatches(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let out_dir: string@View = "ComptimeTypeAvailabilityBuild"
    return comptimeConformanceProjectRuns(
            authority,
            "ComptimeTypeAvailability.out",
            "ComptimeTypeAvailability.err",
            out_dir
        ) &&
        comptimeConformanceArtifactsExist(authority, out_dir) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "\tdef.22.CtAvailabilityAndForbiddenTypes\t"
        ) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "source=CtAvailType;result=available"
        ) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "positive=TypePrim,TypeStringView,TypeStringManaged,TypeBytesView"
        ) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "TypePathAstExpr,TypePathAstStmt,TypePathAstItem"
        ) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "TypePathRecordFields,TypePathEnumPayloads,TypePerm"
        ) &&
        comptimeConformanceContains(
            authority,
            out_dir,
            "forbidden=Capability,ModalState,Dynamic,Ptr,RawPtr,Func,Context"
        ) &&
        comptimePointerParameterRejectsWithExactDiagnostic(authority) &&
        acceptedProjectConformanceContains(
            authority,
            "DiagnosticFixtureBuild",
            "DiagnosticFixture.conformance.log",
            "\trequirement.22.CompileTimeTypeAvailabilityRejection\t"
        )
}

