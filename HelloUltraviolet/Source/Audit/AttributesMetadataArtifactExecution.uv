#test(name: "attributes source-native harness generation emits real harness artifact")
internal procedure attributesSourceNativeHarnessGenerationExecute(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    if !attributesMetadataRunTestCase(authority) {
        return false
    }

    return acceptedProjectTempFileExists(
        authority,
        "AttributeTestHarnessRun",
        "Tests/AttributeTestHarness/Source/Main.uv"
    ) &&
        acceptedProjectTempFileContains(
            authority,
            "AttributeTestHarnessRun",
            "Tests/AttributeTestHarness/Source/Main.uv",
            "public procedure main(context: Context) -> i32"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AttributeTestHarnessRun",
            "Tests/AttributeTestHarness/Source/Main.uv",
            "let authority: TestAuthority = TestAuthority"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AttributeTestHarnessRun",
            "Tests/AttributeTestHarness/Source/Main.uv",
            "time: context.time"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "AttributeTestHarnessRun",
            "Tests/AttributeTestHarness/Source/Main.uv",
            "AttributeTestHarness::Tests::attributeHarnessRecordsAuthority(authority)"
        ) &&
        attributesSourceNativeHarnessConformanceLineContains(
            authority,
            "source%3DBuildAndRunSourceNativeTestHarness%3Bassembly%3DAttributeTestHarness"
        ) &&
        attributesSourceNativeHarnessConformanceLineContains(
            authority,
            "selected_tests%3D1%3Bharness_module%3DAttributeTestHarness::Tests::GeneratedHarness"
        ) &&
        attributesSourceNativeHarnessConformanceLineContains(
            authority,
            "ephemeral%3Dtrue%3Bcompiled_with_harness_entrypoint%3Dtrue"
        )
}

