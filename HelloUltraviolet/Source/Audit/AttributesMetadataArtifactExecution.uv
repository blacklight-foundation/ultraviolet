    ) &&
        attributesSourceNativeDiagnosticsRejectedFixturePasses(
            authority,
            "Fixtures/RejectedSource/Attributes/TestMalformedArgument",
            "Fixtures/RejectedSource/Attributes/TestMalformedArgument/Expected.uv",
            "E-TST-0101"
        ) &&
        attributesSourceNativeDiagnosticsRejectedFixturePasses(
            authority,
            "Fixtures/RejectedSource/Attributes/TestDuplicateName",
            "Fixtures/RejectedSource/Attributes/TestDuplicateName/Expected.uv",
            "E-TST-0102"
        ) &&
        attributesSourceNativeDiagnosticsRejectedFixturePasses(
