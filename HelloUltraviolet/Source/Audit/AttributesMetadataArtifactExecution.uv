internal procedure attributesSourceNativeDiagnosticsRunUnknownTargetCommand(
    authority: TestAuthority,
    output_path: string@View,
    error_path: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                outputDiagnosticAppendCommandStart(value, authority)
            command_ready =
                diagnosticAppendText(
                    value,
                    " test DefinitelyMissing --target-profile ",
                    authority.heap
                ) && command_ready
            command_ready =
                diagnosticAppendText(value, authority.target_profile, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --build-progress off", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --diag-json", authority.heap) &&
                command_ready
            if command_ready {
                outputDiagnosticRunCommand(
                    authority,
                    value,
                    output_path,
                    error_path
                )
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure attributesSourceNativeDiagnosticsUnknownTargetWithPaths(
    authority: TestAuthority,
    output_path: string@View,
    error_path: string@View
) -> bool {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let status: i32 = attributesSourceNativeDiagnosticsRunUnknownTargetCommand(
        authority,
        output_path,
        error_path
    )
    if status == 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "source-native diagnostics unknown target command succeeded: ",
            "Fixtures/OutputDiagnostics/CommandLine/UnknownTestTarget"
        )
    }

    return outputDiagnosticActualMatchesExpected(
        authority,
        "Fixtures/OutputDiagnostics/CommandLine/UnknownTestTarget/Expected.uv",
        output_path
    ) == 1usize &&
        attributesSourceNativeDiagnosticsExpectedFileContains(
            authority,
            "Fixtures/OutputDiagnostics/CommandLine/UnknownTestTarget/Expected.uv",
            "expectedDiagnostic(\"E-TST-0108\", \"diagnostics.TestAttributes\")"
        )
}

internal procedure attributesSourceNativeDiagnosticsUnknownTargetPasses(
    authority: TestAuthority
) -> bool {
    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value: output_path } {
            let error_created: Outcome<unique string@Managed, AllocationError> =
                string::from(authority.temporary_directory, authority.heap)
            if move error_created is {
                @Value { value: error_path } {
                    if !diagnosticBuildPath(
                        output_path,
                        "AttributeUnknownTestTarget.out",
                        authority.heap
                    ) ||
                        !diagnosticBuildPath(
                            error_path,
                            "AttributeUnknownTestTarget.err",
                            authority.heap
                        ) {
                        false
                    } else {
                        attributesSourceNativeDiagnosticsUnknownTargetWithPaths(
                            authority,
                            string::as_view(output_path),
                            string::as_view(error_path)
                        )
                    }
                }
                @Error {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure attributesMetadataRunAuthorityShapeCaseWithPaths(
    authority: TestAuthority,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View
) -> bool {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let _ = authority.io~>ensure_dir(out_dir_path)
    let status: i32 = attributesMetadataRunAllTestsCommand(
        authority,
        "Fixtures/ArtifactProjects/AttributeTestAuthorityAndShape",
        authority.target_profile,
        output_path,
        error_path,
        out_dir_path,
        "attributes_authority_shape.conformance.log"
    )
    if status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute authority and shape run failed: ",
            "Fixtures/ArtifactProjects/AttributeTestAuthorityAndShape"
        )
    }
    return true
}

internal procedure attributesMetadataRunAuthorityShapeCase(
    authority: TestAuthority
) -> bool {
    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value: output_path } {
            let error_created: Outcome<unique string@Managed, AllocationError> =
                string::from(authority.temporary_directory, authority.heap)
            if move error_created is {
                @Value { value: error_path } {
                    let out_dir_created: Outcome<unique string@Managed, AllocationError> =
                        string::from(authority.temporary_directory, authority.heap)
                    if move out_dir_created is {
                        @Value { value: out_dir_path } {
                            if !diagnosticBuildPath(
                                output_path,
                                "AttributeTestAuthorityAndShape.out",
                                authority.heap
                            ) ||
                                !diagnosticBuildPath(
                                    error_path,
                                    "AttributeTestAuthorityAndShape.err",
                                    authority.heap
                                ) ||
                                !diagnosticBuildPath(
                                    out_dir_path,
                                    "AttributeTestAuthorityAndShapeRun",
                                    authority.heap
                                ) {
                                false
                            } else {
                                attributesMetadataRunAuthorityShapeCaseWithPaths(
                                    authority,
                                    string::as_view(output_path),
                                    string::as_view(error_path),
                                    string::as_view(out_dir_path)
                                )
                            }
                        }
                        @Error {
                            false
                        }
                    }
                }
                @Error {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

