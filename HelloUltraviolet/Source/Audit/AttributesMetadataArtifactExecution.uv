internal procedure attributesMetadataRejectedArgumentFixturePasses(
    authority: TestAuthority,
    fixture_path: string@View
) -> bool {
    let result: DiagnosticFixtureExecutionResult =
        diagnosticExerciseProjectFixtureDirectory(authority, fixture_path, true)
    if !result.passed {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute metadata argument rejected fixture failed: ",
            fixture_path
        )
    }
    return result.count == 2usize
}

internal procedure attributesMetadataRejectedArgumentFixturesPass(
    authority: TestAuthority
) -> bool {
    return attributesMetadataRejectedArgumentFixturePasses(
        authority,
        "Fixtures/RejectedSource/Attributes/TestMalformedArgument"
    ) &&
        attributesMetadataRejectedArgumentFixturePasses(
            authority,
            "Fixtures/RejectedSource/Attributes/TestDuplicateName"
        ) &&
        attributesMetadataRejectedArgumentFixturePasses(
            authority,
            "Fixtures/RejectedSource/Attributes/TestMalformedCoverage"
        ) &&
        attributesMetadataRejectedArgumentFixturePasses(
            authority,
            "Fixtures/RejectedSource/Attributes/TestUnknownCoverageReference"
        )
}

internal procedure attributesSourceNativeDiagnosticsExpectedFileContains(
    authority: TestAuthority,
    expected_path: string@View,
    required_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticAppendProjectPath(value, authority, expected_path) {
                false
            } else {
                outputDiagnosticFileContains(
                    authority,
                    string::as_view(value),
                    required_text
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure attributesSourceNativeDiagnosticsRejectedFixturePasses(
    authority: TestAuthority,
    fixture_path: string@View,
    expected_path: string@View,
    expected_code: string@View
) -> bool {
    let result: DiagnosticFixtureExecutionResult =
        diagnosticExerciseProjectFixtureDirectory(authority, fixture_path, true)
    if !result.passed {
        return diagnosticReportFixtureFailure(
            authority,
            "source-native diagnostics rejected fixture failed: ",
            fixture_path
        )
    }

    let expected_line_created: Outcome<unique string@Managed, AllocationError> =
        string::from("expectedDiagnostic(\"", authority.heap)
    return if move expected_line_created is {
        @Value { value } {
            if !diagnosticAppendText(value, expected_code, authority.heap) ||
                !diagnosticAppendText(
                    value,
                    "\", \"diagnostics.TestAttributes\")",
                    authority.heap
                ) {
                false
            } else {
                attributesSourceNativeDiagnosticsExpectedFileContains(
                    authority,
                    expected_path,
                    string::as_view(value)
                )
            }
        }
        @Error {
            false
        }
    }
}

