internal procedure attributesMetadataRunMetadataDiscoveryCaseWithPaths(
    authority: TestAuthority,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View
) -> bool {
    let fixture_path: string@View =
        "Fixtures/ArtifactProjects/AttributeMetadataDiscovery"
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let _ = authority.io~>ensure_dir(out_dir_path)

    let all_status: i32 = attributesMetadataRunAllTestsCommand(
        authority,
        fixture_path,
        authority.target_profile,
        output_path,
        error_path,
        out_dir_path,
        "attributes_metadata_discovery_all.conformance.log"
    )
    if all_status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute metadata discovery all-test run failed: ",
            fixture_path
        )
    }

    let explicit_status: i32 = attributesMetadataRunTestCommand(
        authority,
        fixture_path,
        authority.target_profile,
        "attribute metadata explicit display",
        output_path,
        error_path,
        out_dir_path,
        "attributes_metadata_discovery_explicit.conformance.log"
    )
    if explicit_status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute metadata discovery explicit-name run failed: ",
            fixture_path
        )
    }

    let fallback_status: i32 = attributesMetadataRunTestCommand(
        authority,
        fixture_path,
        authority.target_profile,
        "AttributeMetadataDiscovery::Tests::attributeMetadataBareFallback",
        output_path,
        error_path,
        out_dir_path,
        "attributes_metadata_discovery_fallback.conformance.log"
    )
    if fallback_status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute metadata discovery fallback-name run failed: ",
            fixture_path
        )
    }

    let name_coverage_status: i32 = attributesMetadataRunCoverageCommand(
        authority,
        fixture_path,
        authority.target_profile,
        "def.TestName@L28776",
        output_path,
        error_path,
        out_dir_path,
        "attributes_metadata_discovery_coverage_name.conformance.log"
    )
    if name_coverage_status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute metadata discovery name-coverage run failed: ",
            fixture_path
        )
    }

    let coverage_coverage_status: i32 = attributesMetadataRunCoverageCommand(
        authority,
        fixture_path,
        authority.target_profile,
        "def.TestCoverage@L28791",
        output_path,
        error_path,
        out_dir_path,
        "attributes_metadata_discovery_coverage_coverage.conformance.log"
    )
    if coverage_coverage_status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "attribute metadata discovery coverage-filter run failed: ",
            fixture_path
        )
    }

    return true
}

