//! Artifact checks for runtime interface symbol and declaration coverage.

internal let RUNTIME_INTERFACE_SYMBOL_EXECUTED_OBLIGATION_COUNT: usize = 110usize

internal procedure artifactProjectRuntimeInterfaceIrContains(
    authority: TestAuthority,
    required_text: string@View
) -> bool {
    return acceptedProjectTempFileContains(
        authority,
        "ArtifactProjectRuntimeInterfaceBuild",
        "Intermediate/IR/Source/RuntimeInterfaceSymbols.ll",
        required_text
    )
}

