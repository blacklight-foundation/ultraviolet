internal procedure artifactProjectRuntimeInterfaceSymbolsExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !artifactProjectRunCase(
        authority,
        "Fixtures/ArtifactProjects/RuntimeInterfaceSymbols",
        authority.target_profile,
        "off",
        "ArtifactProjectRuntimeInterface.out",
        "ArtifactProjectRuntimeInterface.err",
        "ArtifactProjectRuntimeInterfaceBuild",
        "runtimeinterface.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let passed: bool =
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectRuntimeInterfaceBuild",
            "Intermediate/IR/Source/RuntimeInterfaceSymbols.ll"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectRuntimeInterfaceBuild",
            artifactProjectTargetText(
                authority,
                "Intermediate/Obj/Source/RuntimeInterfaceSymbols.obj",
                "Intermediate/Obj/Source/RuntimeInterfaceSymbols.o"
            )
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectRuntimeInterfaceBuild",
            artifactProjectTargetText(
                authority,
                "Library/RuntimeInterfaceSymbols.lib",
                "Library/libRuntimeInterfaceSymbols.a"
            )
        ) &&
        artifactProjectArchiveConformanceMatches(
            authority,
            "ArtifactProjectRuntimeInterfaceBuild",
            "runtimeinterface.conformance.log"
        ) &&
        artifactProjectRuntimeInterfaceConformanceMatches(authority) &&
        artifactProjectRuntimeInterfaceRegionRuntimeConformanceMatches(authority) &&
        artifactProjectRuntimeInterfaceCapabilityClassConformanceMatches(authority) &&
        acceptedProjectTempFileContains(
            authority,
            "ArtifactProjectRuntimeInterfaceBuild",
            "Logs/BuildTelemetry.tsv",
            artifactProjectTargetProfileText(
                authority,
                "output-start\tRuntimeInterfaceSymbols\tkind=library;modules=1;emit_ir=ll;target=x86_64-win64",
                "output-start\tRuntimeInterfaceSymbols\tkind=library;modules=1;emit_ir=ll;target=x86_64-sysv",
                "output-start\tRuntimeInterfaceSymbols\tkind=library;modules=1;emit_ir=ll;target=aarch64-darwin"
            )
        ) &&
        artifactProjectRuntimeInterfaceSymbolsMatch(authority) &&
        artifactProjectRuntimeInterfaceSignaturesMatch(authority) &&
        artifactProjectRuntimeInterfaceRuntimeValueDomainMatch(authority) &&
        artifactProjectRuntimeInterfaceAddressTagRuntimeMatch(authority) &&
        artifactProjectRuntimeInterfaceRuntimeHostCallsMatch(authority)
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(
        true,
        RUNTIME_INTERFACE_SYMBOL_EXECUTED_OBLIGATION_COUNT
    )
}
