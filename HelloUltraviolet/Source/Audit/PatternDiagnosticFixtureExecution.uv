//! Pattern-specific diagnostic fixture execution checks.

internal procedure patternRejectedFixtureMatchesExpectedDiagnostics(
    authority: TestAuthority,
    fixture_path: string@View,
    expected_count: usize
) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    let result: DiagnosticFixtureExecutionResult =
        diagnosticExerciseProjectFixtureDirectory(
            authority,
            fixture_path,
            true
        )
    return result.passed &&
        result.count == expected_count
}

internal procedure patternConformancePathContains(
    authority: TestAuthority,
    conformance_path: string@View,
    obligation_id: string@View
) -> bool {
    return diagnosticConformancePathContainsExpectedObligation(
        authority,
        conformance_path,
        obligation_id
    )
}

internal procedure patternRejectedFixtureMatchesExpectedAndRecordsObligation(
    authority: TestAuthority,
    fixture_path: string@View,
    expected_path: string@View,
    expected_count: usize,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    obligation_id: string@View
) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    let output_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_result is {
        @Value { value: output_path } {
            if !diagnosticBuildPath(output_path, output_suffix, authority.heap) {
                false
            } else {
                let error_result: Outcome<unique string@Managed, AllocationError> =
                    string::from(authority.temporary_directory, authority.heap)
                return if move error_result is {
                    @Value { value: error_path } {
                        if !diagnosticBuildPath(error_path, error_suffix, authority.heap) {
                            false
                        } else {
                            let out_dir_result: Outcome<unique string@Managed, AllocationError> =
                                string::from(authority.temporary_directory, authority.heap)
                            return if move out_dir_result is {
                                @Value { value: out_dir_path } {
                                    if !diagnosticBuildPath(
                                        out_dir_path,
                                        out_dir_suffix,
                                        authority.heap
                                    ) {
                                        false
                                    } else {
                                        let conformance_result: Outcome<unique string@Managed, AllocationError> =
                                            string::from(
                                                string::as_view(out_dir_path),
                                                authority.heap
                                            )
                                        return if move conformance_result is {
                                            @Value { value: conformance_path } {
                                                if !diagnosticBuildPath(
                                                    conformance_path,
                                                    "Logs",
                                                    authority.heap
                                                ) ||
                                                    !diagnosticBuildPath(
                                                        conformance_path,
                                                        "Conformance",
                                                        authority.heap
                                                    ) ||
                                                    !diagnosticBuildPath(
                                                        conformance_path,
                                                        DIAGNOSTIC_CONFORMANCE_LOG_NAME,
                                                        authority.heap
                                                    ) {
                                                    false
                                                } else {
                                                    let result: DiagnosticFixtureExecutionResult =
                                                        diagnosticExerciseFixtureWithPaths(
                                                            authority,
                                                            fixture_path,
                                                            expected_path,
                                                            true,
                                                            string::as_view(output_path),
                                                            string::as_view(error_path),
                                                            string::as_view(out_dir_path),
                                                            string::as_view(conformance_path)
                                                        )
                                                    result.passed &&
                                                        result.count == expected_count &&
                                                        patternConformancePathContains(
                                                            authority,
                                                            string::as_view(conformance_path),
                                                            obligation_id
                                                        )
                                                }
                                            }
                                            @Error {
                                                false
                                            }
                                        }
                                    }
                                }
                                @Error {
                                    false
                                }
                            }
                        }
                    }
                    @Error {
                        false
                    }
                }
            }
        }
        @Error {
            false
        }
    }
}

#test(name: "pattern duplicate binding emits Pat-Dup diagnostic")
internal procedure patternDuplicatePatternBindingRejectsWithPatDupDiagnostic(
    authority: TestAuthority
) -> bool
|: |= @result
{
    return patternRejectedFixtureMatchesExpectedDiagnostics(
        authority,
        "Fixtures/RejectedSource/Patterns/DuplicatePatternBinding",
        1usize
    )
}

