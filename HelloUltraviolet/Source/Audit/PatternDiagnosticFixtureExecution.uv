#test(name: "pattern exhaustiveness diagnostics emit exact obligation diagnostic")
internal procedure patternExhaustivenessDiagnosticRejectsWithExactDiagnostic(
    authority: TestAuthority
) -> bool
|: |= @result
{
    return patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/IfCaseModalNonExhaustive",
            "Fixtures/RejectedSource/Patterns/IfCaseModalNonExhaustive/Expected.uv",
            2usize,
            "PatternExhaustivenessModalOutput.json",
            "PatternExhaustivenessModalError.txt",
            "PatternExhaustivenessModalBuild",
            "diag.17.ExhaustivenessAndReachability"
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/IfCaseUnionNonExhaustive",
            "Fixtures/RejectedSource/Patterns/IfCaseUnionNonExhaustive/Expected.uv",
            1usize,
            "PatternExhaustivenessUnionOutput.json",
            "PatternExhaustivenessUnionError.txt",
            "PatternExhaustivenessUnionBuild",
            "diag.17.ExhaustivenessAndReachability"
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/IfCaseEnumNonExhaustive",
            "Fixtures/RejectedSource/Patterns/IfCaseEnumNonExhaustive/Expected.uv",
            1usize,
            "PatternExhaustivenessEnumOutput.json",
            "PatternExhaustivenessEnumError.txt",
            "PatternExhaustivenessEnumBuild",
            "diag.17.ExhaustivenessAndReachability"
        ) &&
        patternRejectedFixtureMatchesExpectedDiagnostics(
            authority,
            "Fixtures/RejectedSource/Patterns/ExhaustivenessAndReachabilityDiagnostic",
            2usize
        )
}

#test(name: "pattern diagnostics supplement emits exact obligation diagnostic")
internal procedure patternDiagnosticsSupplementRejectsWithExactDiagnostic(
    authority: TestAuthority
) -> bool
|: |= @result
{
    return patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/IfCaseUnionNonExhaustive",
            "Fixtures/RejectedSource/Patterns/IfCaseUnionNonExhaustive/Expected.uv",
            1usize,
            "PatternSupplementUnionOutput.json",
            "PatternSupplementUnionError.txt",
            "PatternSupplementUnionBuild",
            "diag.17.PatternDiagnosticsSupplement"
        ) &&
        patternRejectedFixtureMatchesExpectedDiagnostics(
            authority,
            "Fixtures/Patterns/PatternDiagnosticsSupplementLetRefutable",
            1usize
        ) &&
        patternRejectedFixtureMatchesExpectedDiagnostics(
            authority,
            "Fixtures/RejectedSource/Patterns/PatternDiagnosticsSupplement",
            1usize
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/RangePatternNonConst",
            "Fixtures/RejectedSource/Patterns/RangePatternNonConst/Expected.uv",
            1usize,
            "PatternSupplementRangeNonConstOutput.json",
            "PatternSupplementRangeNonConstError.txt",
            "PatternSupplementRangeNonConstBuild",
            "diag.17.PatternDiagnosticsSupplement"
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/RangePatternEmpty",
            "Fixtures/RejectedSource/Patterns/RangePatternEmpty/Expected.uv",
            1usize,
            "PatternSupplementRangeEmptyOutput.json",
            "PatternSupplementRangeEmptyError.txt",
            "PatternSupplementRangeEmptyBuild",
            "diag.17.PatternDiagnosticsSupplement"
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/RecordPatternUnknownField",
            "Fixtures/RejectedSource/Patterns/RecordPatternUnknownField/Expected.uv",
            1usize,
            "PatternSupplementRecordFieldOutput.json",
            "PatternSupplementRecordFieldError.txt",
            "PatternSupplementRecordFieldBuild",
            "diag.17.PatternDiagnosticsSupplement"
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/IfCaseEnumNonExhaustive",
            "Fixtures/RejectedSource/Patterns/IfCaseEnumNonExhaustive/Expected.uv",
            1usize,
            "PatternSupplementEnumOutput.json",
            "PatternSupplementEnumError.txt",
            "PatternSupplementEnumBuild",
            "diag.17.PatternDiagnosticsSupplement"
        ) &&
        patternRejectedFixtureMatchesExpectedAndRecordsObligation(
            authority,
            "Fixtures/RejectedSource/Patterns/IfCaseUnreachable",
            "Fixtures/RejectedSource/Patterns/IfCaseUnreachable/Expected.uv",
            1usize,
            "PatternSupplementUnreachableOutput.json",
            "PatternSupplementUnreachableError.txt",
            "PatternSupplementUnreachableBuild",
            "diag.17.PatternDiagnosticsSupplement"
        ) &&
        patternRejectedFixtureMatchesExpectedDiagnostics(
            authority,
            "Fixtures/Patterns/PatternDiagnosticsSupplementBareType",
            1usize
        ) &&
        patternRejectedFixtureMatchesExpectedDiagnostics(
            authority,
            "Fixtures/Patterns/PatternDiagnosticsSupplementTypedIncompatible",
            1usize
        )
}

