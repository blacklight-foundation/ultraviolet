internal procedure asyncArtifactAsyncKeyIrEvidenceMatches(
    conformance_text: string@View
) -> bool {
    return asyncArtifactConformanceTextContains(conformance_text,
        "component%3DSnapshotHeldKeysIR"
    ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "component%3DReleaseHeldKeysIR"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "component%3DReacquireHeldKeysIR"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "component%3DStaleValueMarkIR"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "operation%3DClosureYieldReleaseShared"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "captured_key_snapshot%3Dclosure_async_frame"
        )
}

internal procedure asyncArtifactIrEvidenceMatches(
    authority: TestAuthority,
    conformance_text: string@View
) -> bool {
    return asyncArtifactIrContains(authority, "yield.resume.") &&
        asyncArtifactIrContains(authority, "yield_from.loop") &&
        asyncArtifactIrContains(authority, "async.resume.") &&
        asyncArtifactIrContains(
            authority,
            "call void @ultraviolet_x3a_x3aruntime_x3a_x3aasync_x3a_x3aresume("
        ) &&
        asyncArtifactIrContains(authority, "call ptr @uv_key_release_all(") &&
        asyncArtifactIrContains(authority, "call void @uv_key_reacquire(") &&
        asyncArtifactIrContains(authority, "call ptr @uv_spawn_create(") &&
        asyncArtifactIrContains(authority, "call ptr @uv_spawn_wait(") &&
        asyncArtifactAsyncKeyIrEvidenceMatches(conformance_text) &&
        asyncArtifactCompositionIrEvidenceMatches(authority) &&
        asyncArtifactReactorIrEvidenceMatches(authority)
}

internal procedure asyncFailedSpawnedWaitPanicMatches(authority: TestAuthority) -> bool {
    if !artifactProjectRunCase(
        authority,
        "Fixtures/ArtifactProjects/AsyncFailedSpawnedWaitPanic",
        authority.target_profile,
        "off",
        "ArtifactProjectAsyncFailedSpawnedWaitPanic.out",
        "ArtifactProjectAsyncFailedSpawnedWaitPanic.err",
        "ArtifactProjectAsyncFailedSpawnedWaitPanicBuild",
        "async_failed_spawned_wait_panic.conformance.log"
    ) {
        return false
    }

    return acceptedProjectTempFileExists(
        authority,
        "ArtifactProjectAsyncFailedSpawnedWaitPanicBuild",
        "Intermediate/IR/Source/AsyncFailedSpawnedWaitPanic.ll"
    ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAsyncFailedSpawnedWaitPanicBuild",
            asyncArtifactExecutablePath(
                authority,
                "Binary/AsyncFailedSpawnedWaitPanic.exe",
                "Binary/AsyncFailedSpawnedWaitPanic"
            )
        ) &&
        asyncFailedSpawnedWaitPanicConformanceContains(
            authority,
            "\trequirement.21.FailedSpawnedWaitHandledByParallelPanic\t"
        ) &&
        asyncFailedSpawnedWaitPanicArtifactContains(
            authority,
            "Intermediate/IR/Source/AsyncFailedSpawnedWaitPanic.ll",
            "call ptr @uv_spawn_wait("
        ) &&
        asyncFailedSpawnedWaitPanicMapEvidenceMatches(authority) &&
        artifactProjectRunExecutableNonZero(
            authority,
            "ArtifactProjectAsyncFailedSpawnedWaitPanicBuild",
            asyncArtifactExecutablePath(
                authority,
                "Binary/AsyncFailedSpawnedWaitPanic.exe",
                "Binary/AsyncFailedSpawnedWaitPanic"
            )
        )
}

internal procedure asyncArtifactObligationsExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !artifactProjectRunCase(
        authority,
        "Fixtures/ArtifactProjects/AsyncObligations",
        authority.target_profile,
        "off",
        "ArtifactProjectAsyncObligations.out",
        "ArtifactProjectAsyncObligations.err",
        "ArtifactProjectAsyncObligationsBuild",
        "asyncobligations.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let artifacts_exist: bool =
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAsyncObligationsBuild",
            "Intermediate/IR/Source/AsyncObligations.ll"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAsyncObligationsBuild",
            asyncArtifactObjectPath(
                authority,
                "Intermediate/Obj/Source/AsyncObligations.obj",
                "Intermediate/Obj/Source/AsyncObligations.o"
            )
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAsyncObligationsBuild",
            asyncArtifactExecutablePath(
                authority,
                "Binary/AsyncObligations.exe",
                "Binary/AsyncObligations"
            )
        )
    if !artifacts_exist {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(
                value,
                "ArtifactProjectAsyncObligationsBuild",
                authority.heap
            ) ||
                !diagnosticBuildPath(value, "Logs", authority.heap) ||
                !diagnosticBuildPath(value, "Conformance", authority.heap) ||
                !diagnosticBuildPath(
                    value,
                    "asyncobligations.conformance.log",
                    authority.heap
                ) {
                diagnosticFixtureExecutionResult(false, 0usize)
            } else {
                let path: string@View = string::as_view(value)
                let read_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(path)
                return if move read_result is {
                    @Value { value: conformance_text } {
                        let conformance_view: string@View =
                            string::as_view(conformance_text)
                        let passed: bool =
                            asyncArtifactObligationIdsMatch(conformance_view) &&
                            asyncArtifactIrEvidenceMatches(
                                authority,
                                conformance_view
                            ) &&
                            asyncFailedSpawnedWaitPanicMatches(authority) &&
                            artifactProjectRunExecutable(
                                authority,
                                "ArtifactProjectAsyncObligationsBuild",
                                asyncArtifactExecutablePath(
                                    authority,
                                    "Binary/AsyncObligations.exe",
                                    "Binary/AsyncObligations"
                                ),
                                0
                            )
                        if !passed {
                            diagnosticFixtureExecutionResult(false, 0usize)
                        } else {
                            diagnosticFixtureExecutionResult(
                                true,
                                ASYNC_ARTIFACT_EXECUTED_OBLIGATION_COUNT
                            )
                        }
                    }
                    @Error {
                        diagnosticFixtureExecutionResult(false, 0usize)
                    }
                }
            }
        }
        @Error {
            diagnosticFixtureExecutionResult(false, 0usize)
        }
    }
}

internal procedure asyncArtifactObligationsExecute(authority: TestAuthority) -> bool {
    let result: DiagnosticFixtureExecutionResult =
        asyncArtifactObligationsExercise(authority)
    return result.passed &&
        result.count == ASYNC_ARTIFACT_EXECUTED_OBLIGATION_COUNT
}
