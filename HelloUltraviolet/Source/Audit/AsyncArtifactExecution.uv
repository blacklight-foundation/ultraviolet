        "\trequirement.21.AsyncFailedUninhabitedForNeverError\t"
    ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\tdef.21.AsyncTypeLoweringForms\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.AsyncNeverErrorLowering\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trule.21.Lower-Async-Type\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trule.21.Lower-Async-Alias\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.AsyncTypeNoAdditionalConcreteGrammar\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.ReservedAsyncTypeConstructors\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.AsyncParameterDefaults\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.ReservedAsyncStates\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.AsyncTypeDynamicSemanticsReference\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trequirement.21.WaitRuntimeSemantics\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trule.20.Lower-Expr-Spawn\t"
        ) &&
        asyncArtifactConformanceTextContains(conformance_text, "\tdef.21.WaitRuntimeHelpers\t") &&
        asyncArtifactConformanceTextContains(conformance_text,
            "\trule.21.EvalSigma-Wait-Spawned-Ready\t"
