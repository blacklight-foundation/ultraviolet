//! Source-native execution checks for async artifact obligations.

internal let ASYNC_ARTIFACT_EXECUTED_OBLIGATION_COUNT: usize = 132usize

internal procedure asyncArtifactConformanceContains(
    authority: TestAuthority,
    required_text: string@View
) -> bool {
    return acceptedProjectConformanceContains(
        authority,
        "ArtifactProjectAsyncObligationsBuild",
        "asyncobligations.conformance.log",
        required_text
    )
}

internal procedure asyncArtifactConformanceTextContains(
    conformance_text: string@View,
    required_text: string@View
) -> bool {
    return auditTextContains(conformance_text, required_text)
}

internal procedure asyncArtifactIrContains(
    authority: TestAuthority,
    required_text: string@View
) -> bool {
    return acceptedProjectTempFileContains(
        authority,
        "ArtifactProjectAsyncObligationsBuild",
        "Intermediate/IR/Source/AsyncObligations.ll",
        required_text
    )
}

internal procedure asyncArtifactObjectPath(
    authority: TestAuthority,
    windows_path: string@View,
    native_path: string@View
) -> string@View {
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        return windows_path
    }
    return native_path
}

internal procedure asyncArtifactExecutablePath(
    authority: TestAuthority,
    windows_path: string@View,
    native_path: string@View
) -> string@View {
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        return windows_path
    }
    return native_path
}

internal procedure asyncFailedSpawnedWaitPanicConformanceContains(
    authority: TestAuthority,
    required_text: string@View
) -> bool {
    return acceptedProjectConformanceContains(
        authority,
        "ArtifactProjectAsyncFailedSpawnedWaitPanicBuild",
        "async_failed_spawned_wait_panic.conformance.log",
        required_text
    )
}

internal procedure asyncFailedSpawnedWaitPanicArtifactContains(
    authority: TestAuthority,
    required_path: string@View,
    required_text: string@View
) -> bool {
    return acceptedProjectTempFileContains(
        authority,
        "ArtifactProjectAsyncFailedSpawnedWaitPanicBuild",
        required_path,
        required_text
    )
}

internal procedure asyncFailedSpawnedWaitPanicMapEvidenceMatches(
    authority: TestAuthority
) -> bool {
    if !auditTextEquals(authority.target_profile, "x86_64-win64") {
        return true
    }

    return asyncFailedSpawnedWaitPanicArtifactContains(
        authority,
        "Binary/AsyncFailedSpawnedWaitPanic.map",
        "uv_parallel_raise_panic"
    ) &&
        asyncFailedSpawnedWaitPanicArtifactContains(
            authority,
            "Binary/AsyncFailedSpawnedWaitPanic.map",
            "uv_parallel_work_panic"
        ) &&
        asyncFailedSpawnedWaitPanicArtifactContains(
            authority,
            "Binary/AsyncFailedSpawnedWaitPanic.map",
            "uv_panic"
        )
}

internal procedure asyncArtifactObligationIdsMatch(
