internal procedure artifactProjectSharedLinkSemanticsImportLibraryMatches(
    authority: TestAuthority
) -> bool {
    if acceptedProjectTargetIsWindows(authority) {
        return acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectSharedLinkSemanticsBuild",
            "Library/HostedExportLibrary.lib"
        )
    }

    return acceptedProjectTempFileDoesNotExist(
        authority,
        "ArtifactProjectSharedLinkSemanticsBuild",
        "Library/libHostedExportLibrary.so.import"
    )
}

internal procedure artifactProjectAssemblyAndLinkKindsExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !artifactProjectRunDumpCase(
        authority,
        "Fixtures/ArtifactProjects/ExecutableOutput",
        authority.target_profile,
        "off",
        "ArtifactProjectKindsExecutable.out",
        "ArtifactProjectKindsExecutable.err",
        "ArtifactProjectKindsExecutableDumpBuild",
        "kind_executable.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !artifactProjectRunDumpCase(
        authority,
        "Fixtures/ArtifactProjects/StaticLibraryArchive",
        authority.target_profile,
        "off",
        "ArtifactProjectKindsStatic.out",
        "ArtifactProjectKindsStatic.err",
        "ArtifactProjectKindsStaticDumpBuild",
        "kind_static.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !artifactProjectRunDumpCase(
        authority,
        "Fixtures/ArtifactProjects/EmitLlDependency",
        authority.target_profile,
        "off",
        "ArtifactProjectKindsDependency.out",
        "ArtifactProjectKindsDependency.err",
        "ArtifactProjectKindsDependencyDumpBuild",
        "kind_dependency.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !artifactProjectRunDumpCase(
        authority,
        "Fixtures/ArtifactProjects/MacOSHostedSharedLibrary",
        "",
        "off",
        "ArtifactProjectKindsShared.out",
        "ArtifactProjectKindsShared.err",
        "ArtifactProjectKindsSharedDumpBuild",
        "kind_shared.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !artifactProjectRunCase(
        authority,
        "Fixtures/ArtifactProjects/ExecutableOutput",
        authority.target_profile,
        "off",
        "ArtifactProjectLinkSemantics.out",
        "ArtifactProjectLinkSemantics.err",
        "ArtifactProjectLinkSemanticsBuild",
        "link_semantics.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !artifactProjectRunCase(
        authority,
        "Fixtures/ArtifactProjects/StaticLibraryArchive",
        authority.target_profile,
        "off",
        "ArtifactProjectArchiveSemantics.out",
        "ArtifactProjectArchiveSemantics.err",
        "ArtifactProjectArchiveSemanticsBuild",
        "archive_semantics.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    if !artifactProjectRunCase(
        authority,
        "Fixtures/AcceptedProjects/HostedExportLibrary",
        authority.target_profile,
        "off",
        "ArtifactProjectSharedLinkSemantics.out",
        "ArtifactProjectSharedLinkSemantics.err",
        "ArtifactProjectSharedLinkSemanticsBuild",
        "shared_link_semantics.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let passed: bool =
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsExecutable.out",
            "<assembly_kind, executable>"
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsExecutable.out",
            "<link_kind, <bottom>>"
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsExecutable.out",
            artifactProjectTargetText(
                authority,
                "Binary/ExecutableOutput.exe, import_lib, <bottom>>",
                "Binary/ExecutableOutput, import_lib, <bottom>>"
            )
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsStatic.out",
            "<assembly_kind, library>"
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsStatic.out",
            "<link_kind, static>"
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsStatic.out",
            artifactProjectTargetText(
                authority,
                "Library/StaticLibraryArchive.lib, import_lib, <bottom>>",
                "Library/libStaticLibraryArchive.a, import_lib, <bottom>>"
            )
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
