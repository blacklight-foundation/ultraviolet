internal procedure artifactProjectRunCaseWithRuntimeLogPath(
    authority: TestAuthority,
    fixture_path: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    conformance_log_name: string@View,
    runtime_log_suffix: string@View
) -> bool {
    if !artifactProjectTemporaryDirectoryReady(authority) {
        return false
    }

    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, output_suffix, authority.heap) {
                false
            } else {
                artifactProjectRunCaseWithRuntimeLogOutput(
                    authority,
                    fixture_path,
                    target_profile,
                    incremental_mode,
                    value,
                    error_suffix,
                    out_dir_suffix,
                    conformance_log_name,
                    runtime_log_suffix
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRunDumpCase(
    authority: TestAuthority,
    fixture_path: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    conformance_log_name: string@View
) -> bool {
    if !artifactProjectTemporaryDirectoryReady(authority) {
        return false
    }

    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, output_suffix, authority.heap) {
                false
            } else {
                artifactProjectRunDumpCaseWithOutput(
                    authority,
                    fixture_path,
                    target_profile,
                    incremental_mode,
                    value,
                    error_suffix,
                    out_dir_suffix,
                    conformance_log_name
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRunExecutablePath(
    authority: TestAuthority,
    executable_path: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                artifactProjectAppendShellStart(value, authority)
            command_ready =
                diagnosticAppendQuoted(value, executable_path, authority.heap) &&
                command_ready
            if auditTextEquals(authority.target_profile, "x86_64-win64") {
                command_ready =
                    diagnosticAppendText(value, "\"", authority.heap) &&
                    command_ready
            }
            if command_ready {
                let command_text: string@View = string::as_view(value)
                authority.sys~>run(command_text)
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure artifactProjectRunExecutablePathWithTwoArgs(
    authority: TestAuthority,
    executable_path: string@View,
    first_arg_path: string@View,
    second_arg_path: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                artifactProjectAppendShellStart(value, authority)
            command_ready =
                diagnosticAppendQuoted(value, executable_path, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuoted(value, first_arg_path, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuoted(value, second_arg_path, authority.heap) &&
                command_ready
            if auditTextEquals(authority.target_profile, "x86_64-win64") {
                command_ready =
                    diagnosticAppendText(value, "\"", authority.heap) &&
                    command_ready
            }
            if command_ready {
                let command_text: string@View = string::as_view(value)
                authority.sys~>run(command_text)
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure artifactProjectRunExecutable(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    executable_suffix: string@View,
    expected_status: i32
) -> bool {
    let executable_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move executable_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) ||
                !diagnosticBuildPath(value, executable_suffix, authority.heap) {
                false
            } else {
                let executable_text_path: string@View = string::as_view(value)
                artifactProjectRunExecutablePath(
                    authority,
                    executable_text_path
                ) == expected_status
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRunExecutableWithTwoArgs(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    executable_suffix: string@View,
    first_arg_suffix: string@View,
    second_arg_suffix: string@View,
    expected_status: i32
) -> bool {
    let executable_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move executable_created is {
        @Value { value: executable_path } {
            let first_arg_created: Outcome<unique string@Managed, AllocationError> =
                string::from(authority.temporary_directory, authority.heap)
            if move first_arg_created is {
                @Value { value: first_arg_path } {
                    let second_arg_created: Outcome<unique string@Managed, AllocationError> =
                        string::from(authority.temporary_directory, authority.heap)
                    if move second_arg_created is {
                        @Value { value: second_arg_path } {
                            if !diagnosticBuildPath(
                                executable_path,
                                out_dir_suffix,
                                authority.heap
                            ) ||
                                !diagnosticBuildPath(
                                    executable_path,
                                    executable_suffix,
                                    authority.heap
                                ) ||
                                !diagnosticBuildPath(
                                    first_arg_path,
                                    out_dir_suffix,
                                    authority.heap
                                ) ||
                                !diagnosticBuildPath(
                                    first_arg_path,
                                    first_arg_suffix,
                                    authority.heap
                                ) ||
                                !diagnosticBuildPath(
                                    second_arg_path,
                                    out_dir_suffix,
                                    authority.heap
                                ) ||
                                !diagnosticBuildPath(
                                    second_arg_path,
                                    second_arg_suffix,
                                    authority.heap
                                ) {
                                false
                            } else {
                                artifactProjectRunExecutablePathWithTwoArgs(
                                    authority,
                                    string::as_view(executable_path),
                                    string::as_view(first_arg_path),
                                    string::as_view(second_arg_path)
                                ) == expected_status
                            }
                        }
                        @Error {
                            false
                        }
                    }
                }
                @Error {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRunExecutableNonZero(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    executable_suffix: string@View
) -> bool {
    let executable_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move executable_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) ||
                !diagnosticBuildPath(value, executable_suffix, authority.heap) {
                false
            } else {
                let executable_text_path: string@View = string::as_view(value)
                artifactProjectRunExecutablePath(
                    authority,
                    executable_text_path
                ) != 0
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectArchiveConformanceMatches(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    log_name: string@View
) -> bool {
    return acceptedProjectConformanceContains(
        authority,
        out_dir_suffix,
        log_name,
        "\tArchive-Ok\t"
    ) &&
        acceptedProjectConformanceContains(
            authority,
            out_dir_suffix,
            log_name,
            "\tOut-Final-Archive-Ok\t"
        )
}

internal procedure artifactProjectLinkConformanceMatches(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    log_name: string@View
) -> bool {
    return acceptedProjectConformanceContains(
        authority,
        out_dir_suffix,
        log_name,
        "\tLink-Ok\t"
    ) &&
        acceptedProjectConformanceContains(
            authority,
            out_dir_suffix,
            log_name,
        "\tOut-Final-Link-Ok\t"
    )
}

