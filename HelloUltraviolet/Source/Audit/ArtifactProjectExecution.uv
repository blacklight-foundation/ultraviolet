internal procedure artifactProjectRunCase(
    authority: TestAuthority,
    fixture_path: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    conformance_log_name: string@View
) -> bool {
    if !artifactProjectTemporaryDirectoryReady(authority) {
        return false
    }

    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, output_suffix, authority.heap) {
                false
            } else {
                artifactProjectRunCaseWithOutput(
                    authority,
                    fixture_path,
                    target_profile,
                    incremental_mode,
                    value,
                    error_suffix,
                    out_dir_suffix,
                    conformance_log_name
                )
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRunAssemblyCase(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    conformance_log_name: string@View
) -> bool {
    if !artifactProjectTemporaryDirectoryReady(authority) {
        return false
    }

    let output_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move output_created is {
        @Value { value: output_path } {
            let error_created: Outcome<unique string@Managed, AllocationError> =
                string::from(authority.temporary_directory, authority.heap)
            if move error_created is {
                @Value { value: error_path } {
                    let out_dir_created: Outcome<unique string@Managed, AllocationError> =
                        string::from(authority.temporary_directory, authority.heap)
                    if move out_dir_created is {
                        @Value { value: out_dir_path } {
                            if !diagnosticBuildPath(
                                output_path,
                                output_suffix,
                                authority.heap
                            ) ||
                                !diagnosticBuildPath(
                                    error_path,
                                    error_suffix,
                                    authority.heap
                                ) ||
                                !diagnosticBuildPath(
                                    out_dir_path,
                                    out_dir_suffix,
                                    authority.heap
                                ) {
                                false
                            } else {
                                artifactProjectRunAssemblyCaseWithPaths(
                                    authority,
                                    fixture_path,
                                    assembly_name,
                                    target_profile,
                                    incremental_mode,
                                    string::as_view(output_path),
                                    string::as_view(error_path),
                                    string::as_view(out_dir_path),
                                    conformance_log_name
                                )
                            }
                        }
                        @Error {
                            false
                        }
                    }
                }
                @Error {
                    false
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRunCaseWithRuntimeLogOutDir(
    authority: TestAuthority,
    fixture_path: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_path: unique string@Managed,
    error_path: unique string@Managed,
    out_dir_path: unique string@Managed,
    out_dir_suffix: string@View,
    conformance_log_name: string@View,
    runtime_log_suffix: string@View
) -> bool {
    let runtime_log_created: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move runtime_log_created is {
        @Value { value } {
            if !diagnosticBuildPath(value, out_dir_suffix, authority.heap) ||
                !diagnosticBuildPath(value, runtime_log_suffix, authority.heap) {
                false
            } else {
                artifactProjectRunCaseWithRuntimeLog(
                    authority,
                    fixture_path,
                    target_profile,
                    incremental_mode,
                    string::as_view(output_path),
                    string::as_view(error_path),
                    string::as_view(out_dir_path),
                    conformance_log_name,
                    string::as_view(value)
                )
            }
        }
        @Error {
            false
        }
    }
}

