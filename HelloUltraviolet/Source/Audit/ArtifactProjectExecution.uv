internal procedure artifactProjectReportNamedResult(
    authority: TestAuthority,
    name: string@View,
    result: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    if !result.passed {
        let _ = diagnosticReportFixtureFailure(
            authority,
            "artifact project exercise failed: ",
            name
        )
    }
    return result
}

internal procedure artifactProjectMergeNamedResult(
    authority: TestAuthority,
    accumulated: DiagnosticFixtureExecutionResult,
    name: string@View,
    next: DiagnosticFixtureExecutionResult
) -> DiagnosticFixtureExecutionResult {
    return outputDiagnosticMergeResult(
        accumulated,
        artifactProjectReportNamedResult(authority, name, next)
    )
}

#test(name: "artifact project fixtures build and exercise output obligations")
internal procedure artifactProjectFixturesBuildAndExerciseOutputObligations(
    authority: TestAuthority
) -> bool
|: |= @result
{
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    if !diagnosticIoSucceeded(temp_ready) {
        return false
    }

    var result: DiagnosticFixtureExecutionResult =
        artifactProjectReportNamedResult(
            authority,
            "artifactProjectAssemblyAndLinkKindsExercise",
            artifactProjectAssemblyAndLinkKindsExercise(authority)
        )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectLibraryArtifactInputsExercise",
        artifactProjectLibraryArtifactInputsExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectRawDylibExercise",
        artifactProjectRawDylibExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectSharedLibraryImageLifecycleExercise",
        artifactProjectSharedLibraryImageLifecycleExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectStaticLibraryExercise",
        artifactProjectStaticLibraryExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectEmitLlExercise",
        artifactProjectEmitLlExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectIrLoweringFormsExercise",
        artifactProjectIrLoweringFormsExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectEmitBcExercise",
        artifactProjectEmitBcExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectEmitLlDependencyExercise",
        artifactProjectEmitLlDependencyExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectEmptyDependencyObjectExercise",
        artifactProjectEmptyDependencyObjectExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectRuntimeInterfaceSymbolsExercise",
        artifactProjectRuntimeInterfaceSymbolsExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectFlowProofRuntimeErasureExercise",
        artifactProjectFlowProofRuntimeErasureExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectExecutableExercise",
        artifactProjectExecutableExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectArrayIndexOOBPanicExercise",
        artifactProjectArrayIndexOOBPanicExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectRawPointerNullReadPanicExercise",
        artifactProjectRawPointerNullReadPanicExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectRawPointerNullWritePanicExercise",
        artifactProjectRawPointerNullWritePanicExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectRuntimeCheckBehaviorExercise",
        artifactProjectRuntimeCheckBehaviorExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectDynamicReceiverExpiredPanicExercise",
        artifactProjectDynamicReceiverExpiredPanicExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectRefinementStaticDefaultDynamicFallbackExercise",
        artifactProjectRefinementStaticDefaultDynamicFallbackExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectGpuRuntimeEvidenceExercise",
        artifactProjectGpuRuntimeEvidenceExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectReducedEmptyDispatchPanicExercise",
        artifactProjectReducedEmptyDispatchPanicExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectSystemExitExecutableExercise",
        artifactProjectSystemExitExecutableExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectLexerTokenizerOutputExercise",
        artifactProjectLexerTokenizerOutputExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectModalSpecialLoweringExercise",
        artifactProjectModalSpecialLoweringExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectAArch64DependencyExercise",
        artifactProjectAArch64DependencyExercise(authority)
    )
    result = artifactProjectMergeNamedResult(
        authority,
        result,
        "artifactProjectModuleDiscoveryOrderingExercise",
        artifactProjectModuleDiscoveryOrderingExercise(authority)
    )
    if !result.passed {
        return false
    }
    if result.count != artifactProjectExpectedExecutedObligationCount(authority) {
        return diagnosticReportFixtureFailure(
            authority,
            "artifact project executed obligation count mismatch: ",
            "ARTIFACT_PROJECT_EXECUTED_OBLIGATION_COUNT"
        )
    }
    return true
}
