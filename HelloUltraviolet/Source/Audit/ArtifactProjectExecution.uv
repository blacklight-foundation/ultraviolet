//! Source-native compiler execution checks for artifact project fixtures.

internal let ARTIFACT_PROJECT_EXECUTED_OBLIGATION_COUNT: usize = 689usize

internal procedure artifactProjectTargetText(
    authority: TestAuthority,
    windows_text: string@View,
    sysv_text: string@View
) -> string@View {
    return acceptedProjectTargetPath(authority, windows_text, sysv_text, sysv_text)
}

internal procedure artifactProjectTargetStatus(
    authority: TestAuthority,
    windows_status: i32,
    sysv_status: i32
) -> i32 {
    if acceptedProjectTargetIsWindows(authority) {
        return windows_status
    }
    return sysv_status
}

internal procedure artifactProjectWindowsMapFileExists(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    map_suffix: string@View
) -> bool {
    if !acceptedProjectTargetIsWindows(authority) {
        return true
    }
    return acceptedProjectTempFileExists(authority, out_dir_suffix, map_suffix)
}

internal procedure artifactProjectWindowsMapFileContains(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    map_suffix: string@View,
    required_text: string@View
) -> bool {
    if !acceptedProjectTargetIsWindows(authority) {
        return true
    }
    return acceptedProjectTempFileContains(
        authority,
        out_dir_suffix,
        map_suffix,
        required_text
    )
}

internal procedure artifactProjectExpectedExecutedObligationCount(
    authority: TestAuthority
) -> usize {
    if acceptedProjectTargetIsWindows(authority) {
        return ARTIFACT_PROJECT_EXECUTED_OBLIGATION_COUNT
    }
    return ARTIFACT_PROJECT_EXECUTED_OBLIGATION_COUNT - 7usize
}

internal procedure artifactProjectTemporaryDirectoryReady(authority: TestAuthority) -> bool {
    let temp_ready: Outcome<(), IoError> =
        authority.io~>ensure_dir(authority.temporary_directory)
    return diagnosticIoSucceeded(temp_ready)
}

internal procedure artifactProjectTemporaryFileContains(
    authority: TestAuthority,
    file_suffix: string@View,
    required_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, file_suffix, authority.heap) {
                let path: string@View = string::as_view(value)
                outputDiagnosticFileContains(authority, path, required_text)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectSourceFileContains(
    authority: TestAuthority,
    file_suffix: string@View,
    required_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticAppendProjectPath(value, authority, file_suffix) {
                let path: string@View = string::as_view(value)
                outputDiagnosticFileContains(authority, path, required_text)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectTemporaryFileExcludes(
    authority: TestAuthority,
    file_suffix: string@View,
    forbidden_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, file_suffix, authority.heap) {
                let path: string@View = string::as_view(value)
                outputDiagnosticFileExcludes(authority, path, forbidden_text)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectTempFileExcludes(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    file_suffix: string@View,
    forbidden_text: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if diagnosticBuildPath(value, out_dir_suffix, authority.heap) &&
                diagnosticBuildPath(value, file_suffix, authority.heap) {
                let path: string@View = string::as_view(value)
                outputDiagnosticFileExcludes(authority, path, forbidden_text)
            } else {
                false
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectAppendShellStart(
    text: unique string@Managed,
    authority: TestAuthority
) -> bool {
    if auditTextEquals(authority.target_profile, "x86_64-win64") {
        return diagnosticAppendText(text, "cmd.exe /C \"", authority.heap)
    }
    return true
}

internal procedure artifactProjectRunBuildCommand(
    authority: TestAuthority,
    fixture_path: string@View,
    assembly_name: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View,
    runtime_log_path: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                outputDiagnosticAppendCommandStart(value, authority)
            command_ready =
                diagnosticAppendText(value, " build ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuotedProjectPath(value, authority, fixture_path) &&
                command_ready
            if !string::is_empty(assembly_name) {
                command_ready =
                    diagnosticAppendText(value, " --assembly ", authority.heap) &&
                    command_ready
                command_ready =
                    diagnosticAppendText(value, assembly_name, authority.heap) &&
                    command_ready
            }
            if !string::is_empty(target_profile) {
                command_ready =
                    diagnosticAppendText(value, " --target-profile ", authority.heap) &&
                    command_ready
                command_ready =
                    diagnosticAppendText(value, target_profile, authority.heap) &&
                    command_ready
            }
            command_ready =
                diagnosticAppendText(
                    value,
                    " --diag-json --build-progress off --incremental ",
                    authority.heap
                ) && command_ready
            command_ready =
                diagnosticAppendText(value, incremental_mode, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --out-dir ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuoted(value, out_dir_path, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --conformance ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, conformance_log_name, authority.heap) &&
                command_ready
            if !string::is_empty(runtime_log_path) {
                command_ready =
                    diagnosticAppendText(
                        value,
                        " --trace-filter runtime --log-file ",
                        authority.heap
                    ) && command_ready
                command_ready =
                    diagnosticAppendQuoted(value, runtime_log_path, authority.heap) &&
                    command_ready
            }
            if command_ready {
                outputDiagnosticRunCommand(
                    authority,
                    value,
                    output_path,
                    error_path
                )
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure artifactProjectRunDumpCommand(
    authority: TestAuthority,
    fixture_path: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View
) -> i32 {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from("", authority.heap)
    return if move created is {
        @Value { value } {
            var command_ready: bool =
                outputDiagnosticAppendCommandStart(value, authority)
            command_ready =
                diagnosticAppendText(value, " build ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuotedProjectPath(value, authority, fixture_path) &&
                command_ready
            if !string::is_empty(target_profile) {
                command_ready =
                    diagnosticAppendText(value, " --target-profile ", authority.heap) &&
                    command_ready
                command_ready =
                    diagnosticAppendText(value, target_profile, authority.heap) &&
                    command_ready
            }
            command_ready =
                diagnosticAppendText(
                    value,
                    " --dump --build-progress off --incremental ",
                    authority.heap
                ) && command_ready
            command_ready =
                diagnosticAppendText(value, incremental_mode, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --out-dir ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendQuoted(value, out_dir_path, authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, " --conformance ", authority.heap) &&
                command_ready
            command_ready =
                diagnosticAppendText(value, conformance_log_name, authority.heap) &&
                command_ready
            if command_ready {
                outputDiagnosticRunCommand(
                    authority,
                    value,
                    output_path,
                    error_path
                )
            } else {
                -1
            }
        }
        @Error {
            -1
        }
    }
}

internal procedure artifactProjectRunCaseWithPaths(
    authority: TestAuthority,
    fixture_path: string@View,
    target_profile: string@View,
    incremental_mode: string@View,
    output_path: string@View,
    error_path: string@View,
    out_dir_path: string@View,
    conformance_log_name: string@View
) -> bool {
    let _ = authority.io~>remove(output_path)
    let _ = authority.io~>remove(error_path)
    let _ = authority.io~>ensure_dir(out_dir_path)
    let status: i32 = artifactProjectRunBuildCommand(
        authority,
        fixture_path,
        "",
        target_profile,
        incremental_mode,
        output_path,
        error_path,
        out_dir_path,
        conformance_log_name,
        ""
    )
    if status != 0 {
        return diagnosticReportFixtureFailure(
            authority,
            "artifact project build failed: ",
            fixture_path
        )
    }
    return true
}

