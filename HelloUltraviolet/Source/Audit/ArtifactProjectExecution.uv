internal procedure artifactProjectRuntimePanicArtifactsMatch(
    authority: TestAuthority,
    fixture_path: string@View,
    output_suffix: string@View,
    error_suffix: string@View,
    out_dir_suffix: string@View,
    conformance_log_name: string@View,
    binary_suffix: string@View,
    map_suffix: string@View,
    object_suffix: string@View,
    lowering_rule: string@View
) -> bool {
    if !artifactProjectRunCase(
        authority,
        fixture_path,
        authority.target_profile,
        "off",
        output_suffix,
        error_suffix,
        out_dir_suffix,
        conformance_log_name
    ) {
        return false
    }

    let matched: bool =
        acceptedProjectTempFileExists(authority, out_dir_suffix, binary_suffix) &&
        artifactProjectWindowsMapFileExists(authority, out_dir_suffix, map_suffix) &&
        acceptedProjectTempFileExists(authority, out_dir_suffix, object_suffix) &&
        artifactProjectLinkConformanceMatches(
            authority,
            out_dir_suffix,
            conformance_log_name
        ) &&
        acceptedProjectConformanceContains(
            authority,
            out_dir_suffix,
            conformance_log_name,
            lowering_rule
        ) &&
        acceptedProjectConformanceContains(
            authority,
            out_dir_suffix,
            conformance_log_name,
            "\tPanicCheck\t"
        ) &&
        artifactProjectWindowsMapFileContains(
            authority,
            out_dir_suffix,
            map_suffix,
            "uv_panic"
        )
    return matched
}

