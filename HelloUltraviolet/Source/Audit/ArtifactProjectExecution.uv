internal procedure artifactProjectAArch64DependencyExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !artifactProjectRunCase(
        authority,
        "Fixtures/ArtifactProjects/AArch64DependencyObject",
        "",
        "on",
        "ArtifactProjectAArch64.out",
        "ArtifactProjectAArch64.err",
        "ArtifactProjectAArch64Build",
        "aarch64.conformance.log"
    ) {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }

    let passed: bool =
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAArch64Build",
            "Intermediate"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAArch64Build",
            "Logs"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAArch64Build",
            "Intermediate/Obj"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAArch64Build",
            "Intermediate/Obj/Source/AArch64DependencyObject.o"
        ) &&
        acceptedProjectTempFileExists(
            authority,
            "ArtifactProjectAArch64Build",
            "Intermediate/Incremental/AArch64DependencyObject.manifest"
        ) &&
        acceptedProjectTempFileDoesNotExist(
            authority,
            "ArtifactProjectAArch64Build",
            "Binary"
        ) &&
        acceptedProjectTempFileDoesNotExist(
            authority,
            "ArtifactProjectAArch64Build",
            "Library"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "ArtifactProjectAArch64Build",
            "aarch64.conformance.log",
            "\tEmit-IR-None\t"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "ArtifactProjectAArch64Build",
            "aarch64.conformance.log",
            "\tOut-IR-None-NoFinalize\t"
        ) &&
        acceptedProjectConformanceContains(
            authority,
            "ArtifactProjectAArch64Build",
            "aarch64.conformance.log",
            "\tOutput-Pipeline-Dependency\t"
        ) &&
        artifactProjectTempFileExcludes(
            authority,
            "ArtifactProjectAArch64Build",
            "Logs/Conformance/aarch64.conformance.log",
            "\tFinalize-"
        ) &&
        artifactProjectTempFileExcludes(
            authority,
            "ArtifactProjectAArch64Build",
            "Logs/Conformance/aarch64.conformance.log",
            "\tOut-Final-"
        ) &&
        acceptedProjectTempFileContains(
            authority,
            "ArtifactProjectAArch64Build",
            "Logs/BuildTelemetry.tsv",
            "output-start\tAArch64DependencyObject\tkind=dependency;modules=1;emit_ir=none;target=aarch64-aapcs64"
        )
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, 3usize)
}

internal procedure artifactProjectModuleDiscoveryOrderingExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    if !artifactProjectRunDumpCase(
        authority,
        "Fixtures/ArtifactProjects/ModuleDiscoveryOrdering",
        authority.target_profile,
        "off",
        "ArtifactProjectModuleDiscoveryOrderingDump.out",
        "ArtifactProjectModuleDiscoveryOrderingDump.err",
        "ArtifactProjectModuleDiscoveryOrderingDumpBuild",
