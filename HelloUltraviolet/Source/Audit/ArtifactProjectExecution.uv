internal procedure artifactProjectRuntimeCheckLogMatches(
    authority: TestAuthority,
    out_dir_suffix: string@View,
    conformance_log_name: string@View,
    runtime_check: string@View
) -> bool {
    let payload_result: Outcome<unique string@Managed, AllocationError> =
        string::from("runtime_check%3D", authority.heap)
    return if move payload_result is {
        @Value { value: payload } {
            diagnosticAppendText(payload, runtime_check, authority.heap) &&
                diagnosticAppendText(
                    payload,
                    "%3Bbehavior%3DPanic%3Bpanic_symbol%3D",
                    authority.heap
                ) &&
                diagnosticAppendText(
                    payload,
                    "ultraviolet_x3a_x3aruntime_x3a_x3apanic",
                    authority.heap
                ) &&
                acceptedProjectConformanceContains(
                    authority,
                    out_dir_suffix,
                    conformance_log_name,
                    "\tdef.RuntimeCheck\t"
                ) &&
                acceptedProjectConformanceContains(
                    authority,
                    out_dir_suffix,
                    conformance_log_name,
                    "\tdef.RuntimeCheckBehavior\t"
                ) &&
                acceptedProjectConformanceContains(
                    authority,
                    out_dir_suffix,
                    conformance_log_name,
                    string::as_view(payload)
                )
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectRuntimeCheckBehaviorExercise(
    authority: TestAuthority
) -> DiagnosticFixtureExecutionResult {
    var result: DiagnosticFixtureExecutionResult =
        artifactProjectIntegerOverflowPanicExercise(authority)
    result = outputDiagnosticMergeResult(
        result,
        artifactProjectSliceRangeOOBPanicExercise(authority)
    )
    result = outputDiagnosticMergeResult(
        result,
        artifactProjectOperatorUndefinedPanicExercise(authority)
    )

    let passed: bool = result.passed &&
        artifactProjectRuntimeCheckLogMatches(
            authority,
            "ArtifactProjectIntegerOverflowPanicBuild",
            "integer_overflow.conformance.log",
            "IntegerOverflow"
        ) &&
        artifactProjectRuntimeCheckLogMatches(
            authority,
            "ArtifactProjectSliceRangeOOBPanicBuild",
            "slice_range_oob.conformance.log",
            "SliceBounds"
        ) &&
        artifactProjectRuntimeCheckLogMatches(
            authority,
            "ArtifactProjectOperatorUndefinedPanicBuild",
            "operator_undefined.conformance.log",
            "IntDivisionByZero"
        )
    if !passed {
        return diagnosticFixtureExecutionResult(false, 0usize)
    }
    return diagnosticFixtureExecutionResult(true, result.count + 2usize)
}

