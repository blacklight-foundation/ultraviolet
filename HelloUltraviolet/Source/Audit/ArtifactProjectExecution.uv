internal procedure artifactProjectEmitLlBackendHeaderMatches(
    authority: TestAuthority
) -> bool {
    return artifactProjectEmitLlIrContains(
        authority,
        artifactProjectTargetText(
            authority,
            "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128\"",
            "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i128:128-n8:16:32:64-S128\""
        )
    ) &&
        artifactProjectEmitLlIrContains(
            authority,
            artifactProjectTargetText(
                authority,
                "target triple = \"x86_64-pc-windows-msvc\"",
                "target triple = \"x86_64-unknown-linux-gnu\""
            )
        ) &&
        artifactProjectEmitLlConformanceContains(
            authority,
            "\tdef.LLVMTargetConstants\t"
