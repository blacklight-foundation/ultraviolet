internal procedure artifactProjectFindTextFrom(
    text: string@View,
    needle: string@View,
    start: usize
) -> usize {
    let text_length: usize = string::length(text)
    let needle_length: usize = string::length(needle)
    if needle_length == 0usize {
        return start
    }
    if start >= text_length || needle_length > text_length {
        return text_length
    }

    let last_start: usize = text_length - needle_length
    var index: usize = start
    loop index <= last_start {
        if auditTextStartsAt(text, needle, index) {
            return index
        }
        index = index + 1usize
    }
    return text_length
}

internal procedure artifactProjectFindTextWithin(
    text: string@View,
    needle: string@View,
    start: usize,
    limit: usize
) -> usize {
    let found: usize = artifactProjectFindTextFrom(text, needle, start)
    if found >= limit {
        return string::length(text)
    }
    return found
}

internal procedure artifactProjectLineContainsRequiredText(
    line: string@View,
    required_text: string@View
) -> bool {
    return string::is_empty(required_text) ||
        auditTextContains(line, required_text)
}

internal procedure artifactProjectTextLineContainsAll(
    text: string@View,
    required_one: string@View,
    required_two: string@View,
    required_three: string@View
) -> bool {
    let text_length: usize = string::length(text)
    var line_start: usize = 0usize
    var index: usize = 0usize
    loop index <= text_length {
        if index == text_length || auditTextByte(text, index) == 10u8 {
            let line: string@View = string::slice(text, line_start, index)
            if artifactProjectLineContainsRequiredText(line, required_one) &&
                artifactProjectLineContainsRequiredText(line, required_two) &&
                artifactProjectLineContainsRequiredText(line, required_three) {
                return true
            }
            line_start = index + 1usize
        }
        index = index + 1usize
    }
    return false
}

internal procedure artifactProjectEmitLlIrLineContains(
    authority: TestAuthority,
    required_one: string@View,
    required_two: string@View,
    required_three: string@View
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "ArtifactProjectEmitLlBuild", authority.heap) ||
                !diagnosticBuildPath(value, "Intermediate", authority.heap) ||
                !diagnosticBuildPath(value, "IR", authority.heap) ||
                !diagnosticBuildPath(value, "Source", authority.heap) ||
                !diagnosticBuildPath(value, "EmitLlLibrary.ll", authority.heap) {
                false
            } else {
                let path: string@View = string::as_view(value)
                let read_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(path)
                if move read_result is {
                    @Value { value: text } {
                        artifactProjectTextLineContainsAll(
                            string::as_view(text),
                            required_one,
                            required_two,
                            required_three
                        )
                    }
                    @Error {
                        false
                    }
                }
            }
        }
        @Error {
            false
        }
    }
}

internal procedure artifactProjectLineResultBeforeMarker(
    text: string@View,
    marker_start: usize
) -> string@View {
    var line_start: usize = marker_start
    loop line_start > 0usize {
        if auditTextByte(text, line_start - 1usize) == 10u8 {
            break
        }
        line_start = line_start - 1usize
    }

    var result_start: usize = line_start
    loop result_start < marker_start {
        if auditTextByte(text, result_start) == 37u8 {
            return string::slice(text, result_start, marker_start)
        }
        result_start = result_start + 1usize
    }
    return ""
}

internal procedure artifactProjectFindIrUseWithin(
    authority: TestAuthority,
    text: string@View,
    prefix: string@View,
    value: string@View,
    suffix: string@View,
    start: usize,
    limit: usize
) -> usize {
    let created: Outcome<unique string@Managed, AllocationError> =
        string::from(prefix, authority.heap)
    return if move created is {
        @Value { value: needle } {
            if diagnosticAppendText(needle, value, authority.heap) &&
                diagnosticAppendText(needle, suffix, authority.heap) {
                artifactProjectFindTextWithin(text, string::as_view(needle), start, limit)
            } else {
                string::length(text)
            }
        }
        @Error {
            string::length(text)
        }
    }
}

internal procedure artifactProjectEmitLlReferenceCaptureIrTextMatches(
    authority: TestAuthority,
    text: string@View
) -> bool {
    let text_length: usize = string::length(text)
    let closure_start: usize = artifactProjectFindTextFrom(
        text,
        "define internal i32 @EmitLlLibrary_x5fx3a_x5fx3aemitLlClosureEnvReferenceCaptureProbe_x3a_x3a_x5fclosure0(ptr %__env",
        0usize
    )
    if closure_start >= text_length {
        return false
    }

    var closure_end: usize =
        artifactProjectFindTextFrom(text, "\ndefine ", closure_start + 1usize)
    if closure_end >= text_length {
        closure_end = text_length
    }

    let enabled_gep_marker: string@View = " = getelementptr i8, ptr %__env, i64 0"
    let enabled_gep: usize =
        artifactProjectFindTextWithin(text, enabled_gep_marker, closure_start, closure_end)
    if enabled_gep >= text_length {
        return false
    }
    let enabled_field: string@View =
        artifactProjectLineResultBeforeMarker(text, enabled_gep)
    if string::is_empty(enabled_field) {
        return false
    }

    let enabled_load_ptr: usize = artifactProjectFindIrUseWithin(
        authority,
        text,
        " = load ptr, ptr ",
        enabled_field,
        ", align 8",
        enabled_gep,
        closure_end
    )
    if enabled_load_ptr >= text_length {
        return false
    }
    let enabled_ptr: string@View =
        artifactProjectLineResultBeforeMarker(text, enabled_load_ptr)
    if string::is_empty(enabled_ptr) {
        return false
    }

    let enabled_load_value: usize = artifactProjectFindIrUseWithin(
        authority,
        text,
        " = load i8, ptr ",
        enabled_ptr,
        ", align 1",
        enabled_load_ptr,
        closure_end
    )
    if enabled_load_value >= text_length {
        return false
    }

    let left_bias_gep_marker: string@View = " = getelementptr i8, ptr %__env, i64 8"
    let left_bias_gep: usize =
        artifactProjectFindTextWithin(text, left_bias_gep_marker, enabled_load_value, closure_end)
    if left_bias_gep >= text_length {
        return false
    }
    let left_bias_field: string@View =
        artifactProjectLineResultBeforeMarker(text, left_bias_gep)
    if string::is_empty(left_bias_field) {
        return false
    }

    let left_bias_load_ptr: usize = artifactProjectFindIrUseWithin(
        authority,
        text,
        " = load ptr, ptr ",
        left_bias_field,
        ", align 8",
        left_bias_gep,
        closure_end
    )
    if left_bias_load_ptr >= text_length {
        return false
    }
    let left_bias_ptr: string@View =
        artifactProjectLineResultBeforeMarker(text, left_bias_load_ptr)
    if string::is_empty(left_bias_ptr) {
        return false
    }

    let left_bias_load_value: usize = artifactProjectFindIrUseWithin(
        authority,
        text,
        " = load i32, ptr ",
        left_bias_ptr,
        ", align 4",
        left_bias_load_ptr,
        closure_end
    )
    return left_bias_load_value < text_length
}

internal procedure artifactProjectEmitLlReferenceCaptureIrMatches(
    authority: TestAuthority
) -> bool {
    let path_result: Outcome<unique string@Managed, AllocationError> =
        string::from(authority.temporary_directory, authority.heap)
    return if move path_result is {
        @Value { value } {
            if !diagnosticBuildPath(value, "ArtifactProjectEmitLlBuild", authority.heap) ||
                !diagnosticBuildPath(value, "Intermediate", authority.heap) ||
                !diagnosticBuildPath(value, "IR", authority.heap) ||
                !diagnosticBuildPath(value, "Source", authority.heap) ||
                !diagnosticBuildPath(value, "EmitLlLibrary.ll", authority.heap) {
                false
            } else {
                let path: string@View = string::as_view(value)
                let read_result: Outcome<unique string@Managed, IoError> =
                    authority.io~>read_file(path)
                if move read_result is {
                    @Value { value: text } {
                        artifactProjectEmitLlReferenceCaptureIrTextMatches(
                            authority,
                            string::as_view(text)
                        )
                    }
                    @Error {
                        false
                    }
                }
            }
        }
        @Error {
            false
        }
    }
}

