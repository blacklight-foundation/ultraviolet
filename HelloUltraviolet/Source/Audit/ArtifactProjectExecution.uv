            "<assembly_kind, dependency>"
        ) &&
        artifactProjectTemporaryFileContains(
            authority,
            "ArtifactProjectKindsDependency.out",
            "<link_kind, <bottom>>"
        ) &&
        artifactProjectTemporaryFileExcludes(
            authority,
