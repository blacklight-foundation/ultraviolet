public procedure emitLlRawPointerWriteProbe(pointer: *mut i32, value: i32) -> i32 {
    unsafe {
        *pointer = value
    }
    return value
}

public procedure emitLlConstFunctionArgAttrsProbe(callback: const () -> i32) -> usize {
    return sizeof(const () -> i32)
}

public procedure emitLlSRetPair(left: string@View, right: string@View) -> EmitLlSRetPair {
    return EmitLlSRetPair {
        left: left,
        right: right
    }
}

public procedure emitLlSRetCallSiteProbe() -> usize {
    let pair: EmitLlSRetPair = emitLlSRetPair(
        "E-HUV-LLVM-SRET",
        "regression.24.LLVMCallSRetAttrs"
    )
    return string::length(pair.left) + string::length(pair.right)
}

public record EmitLlLibraryIOContext {
    public io: $IO
}

public procedure emitLlRuntimeCreateWriteCarrierProbe(
    context: EmitLlLibraryIOContext,
    path: string@View
) -> bool {
    let created: Outcome<unique File@Write, IoError> = context.io~>create_write(path)
    return if move created is {
        Outcome::Value(value) {
            let closed: File@Closed = value~>close()
            let _ = closed
            true
        }
        Outcome::Error(_) {
            false
        }
    }
}
