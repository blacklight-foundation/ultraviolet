public procedure emitLlFoundationalDiscreteIntrinsicProbe(value: i32) -> i32 {
    let successor: i32 | () = value~>successor()
    let predecessor: i32 | () = value~>predecessor()
    let successor_value: i32 = if successor is {
        next_value: i32 {
            next_value
        }
        empty_value: () {
            value
        }
    }
    let predecessor_value: i32 = if predecessor is {
        previous_value: i32 {
            previous_value
        }
        empty_value: () {
            value
        }
    }
    return successor_value - predecessor_value
}

