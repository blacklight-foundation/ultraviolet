public procedure emitLlHashRequiresEqProbe(value: i32) -> bool {
    let left: EmitLlHashLawValue = EmitLlHashLawValue { value: value }
    let right: EmitLlHashLawValue = EmitLlHashLawValue { value: value }
    let first_hasher_owner: unique EmitLlFnvHasher =
        EmitLlFnvHasher { state: 14695981039346656037u64 }
    let second_hasher_owner: unique EmitLlFnvHasher =
        EmitLlFnvHasher { state: 14695981039346656037u64 }
    left~>hash(first_hasher_owner)
    right~>hash(second_hasher_owner)
    return left~>eq(right) &&
        first_hasher_owner~>finish() == second_hasher_owner~>finish()
}

