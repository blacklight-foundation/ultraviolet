public procedure emitLlConstBytesEncodingProbe() -> i32 {
    let empty_value: () = EMIT_LL_CONST_BYTES_UNIT
    let empty_size: usize = sizeof(())
    let empty_text: bytes@View = bytes::view_string("")
    let empty_text_size: usize = bytes::length(empty_text)
    if EMIT_LL_CONST_BYTES_NULL == null && EMIT_LL_CONST_BYTES_FLOAT > 6.0f64 {
        return EMIT_LL_CONST_BYTES_INT
    }
    return (empty_size + empty_text_size) as i32
}

