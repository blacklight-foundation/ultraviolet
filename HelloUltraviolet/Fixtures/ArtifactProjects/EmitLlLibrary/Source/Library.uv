    public procedure hash(~, hasher: unique $Hasher) -> () {
        hasher~>write(bytes::view_string("EmitLlHashLawValue"))
        return ()
    }
}

public record EmitLlFnvHasher <: Hasher {
    public state: u64

    public procedure write(~!, data: bytes@View) -> () {
        let data_slice: const [u8] = bytes::as_slice(data)
        var index: usize = 0usize
        loop index < bytes::length(data) {
            self.state = (self.state ^ (data_slice[index] as u64)) * 1099511628211u64
            index = index + 1usize
        }
        return ()
    }

    public procedure finish(~) -> u64 {
        return self.state
    }
}

