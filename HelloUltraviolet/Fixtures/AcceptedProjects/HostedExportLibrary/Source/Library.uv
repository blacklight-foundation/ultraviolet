//! Accepted hosted-export library fixture.

public record HostedSystemContext {
    public sys: $System
}

public record HostedIOContext {
    public io: $IO
}

#layout(C)
public record HostedPair {
    public left: i32
    public right: i32
}

#layout(C)
public record HostedTriple {
    public first: i32
    public second: i32
    public third: i32
}

#layout(C)
public record HostedLarge {
    public first: i64
    public second: i64
    public third: i64
}

private var _HOSTED_STATE_REFERENCE: i32 = 5

#host_export("C")
#mangle("uv_hosted_reference_increment")
public procedure hostedReferenceIncrement(context: HostedSystemContext, value: i32) -> i32 {
    return value + 1
}

#host_export("C")
#mangle("uv_hosted_reference_pair_sum")
public procedure hostedReferencePairSum(
    context: HostedSystemContext,
    pair: HostedPair
) -> i32 {
    return pair.left + pair.right
}

#host_export("C")
#mangle("uv_hosted_reference_pair_echo")
public procedure hostedReferencePairEcho(
    context: HostedSystemContext,
    pair: HostedPair
) -> HostedPair {
    return HostedPair {
        left: pair.left,
        right: pair.right
    }
}

#host_export("C")
#mangle("uv_hosted_reference_triple_sum")
public procedure hostedReferenceTripleSum(
    context: HostedSystemContext,
    triple: HostedTriple
) -> i32 {
    return triple.first + triple.second + triple.third
}

#host_export("C")
#mangle("uv_hosted_reference_triple_echo")
public procedure hostedReferenceTripleEcho(
    context: HostedSystemContext,
    triple: HostedTriple
) -> HostedTriple {
    return HostedTriple {
        first: triple.first,
        second: triple.second,
        third: triple.third
    }
}

#host_export("C")
#mangle("uv_hosted_reference_large_echo")
public procedure hostedReferenceLargeEcho(
    context: HostedSystemContext,
    large: HostedLarge
) -> HostedLarge {
    return HostedLarge {
        first: large.first,
        second: large.second,
        third: large.third
    }
}

#host_export("C")
#mangle("uv_hosted_reference_io_probe")
public procedure hostedReferenceIOProbe(
    context: HostedIOContext,
    fallback: i32
) -> i32 {
    if context.io~>exists("HelloUltraviolet") {
        return fallback + 1
    }
    return fallback
}

#host_export("C")
#mangle("uv_hosted_reference_state_increment")
public procedure hostedReferenceStateIncrement(
    context: HostedSystemContext,
    value: i32
) -> i32 {
    _HOSTED_STATE_REFERENCE = _HOSTED_STATE_REFERENCE + value
    return _HOSTED_STATE_REFERENCE
}

#host_export("C-unwind")
#unwind("catch")
#mangle("uv_hosted_reference_catch_value")
public procedure hostedReferenceCatchValue(context: HostedSystemContext) -> i32 {
    return 7
}
