internal record AsyncCompositionArtifactCell {
    internal value: i32
}

internal procedure asyncCompositionArtifactCompletes(
    value: i32
) -> Async<(), (), i32, bool> {
    return value
}

internal procedure asyncCompositionArtifactMayFail(
    should_fail: bool,
    value: i32
) -> Async<(), (), i32, bool> {
    let result: i32 = effectfulLoweringOutcome(should_fail, value)?
    return result
}

internal procedure asyncCompositionArtifactStreamMayFail(
    should_fail: bool,
    value: i32
) -> Async<i32, (), i32, bool> {
    let result: i32 = effectfulLoweringOutcome(should_fail, value)?
    yield result
    return result
}

internal procedure asyncCompositionArtifactSingleOutput(
    value: i32
) -> Async<i32, (), (), bool> {
    yield value
    return ()
}

internal procedure asyncCompositionArtifactUnitSuspends(
    value: i32
) -> Async<(), (), i32, bool> {
    yield ()
    return value
}

internal procedure asyncKeyArtifactSuspends(
    value: i32
) -> Async<i32, i32, i32, bool> {
    let resumed: i32 = yield value
    return resumed
}

internal procedure asyncKeyArtifactFails(
    value: i32
) -> Async<i32, i32, i32, bool> {
    let result: i32 = effectfulLoweringOutcome(true, value)?
    yield result
    return result
}

public procedure asyncCompositionSyncArtifactReference() -> Outcome<i32, bool> {
    return sync asyncCompositionArtifactUnitSuspends(101)
}

public procedure asyncCompositionAllArtifactReference() -> Outcome<(i32, i32), bool> {
    return all {
        asyncCompositionArtifactMayFail(false, 102),
        asyncCompositionArtifactMayFail(false, 103),
    }
}

public procedure asyncCompositionRaceReturnArtifactReference() -> Outcome<i32, bool> {
    return race {
        asyncCompositionArtifactMayFail(false, 104) -> |value| value + 1,
        asyncCompositionArtifactMayFail(false, 105) -> |value| value + 1
    }
}

public procedure asyncCompositionRaceStreamArtifactReference() ->
    Async<(), (), Stream<i32, bool>, !> {
    return race {
        asyncCompositionArtifactStreamMayFail(false, 106) -> |output| yield output,
        asyncCompositionArtifactStreamMayFail(false, 107) -> |output| yield output,
    }
}

public procedure asyncCompositionCombinatorArtifactReference() -> bool {
    let mapped: Stream<i32, bool> =
        asyncCompositionArtifactSingleOutput(108)~>map(|value: i32| -> i32 value + 1)
    let filtered: Stream<i32, bool> =
        asyncCompositionArtifactSingleOutput(109)~>filter(
            |value: const i32| -> bool value == 109
        )
    let taken: Stream<i32, bool> =
        asyncCompositionArtifactSingleOutput(110)~>take(1usize)
    let folded: Async<(), (), i32, bool> =
        asyncCompositionArtifactSingleOutput(111)~>fold(
            10,
            |acc: i32, value: i32| -> i32 acc + value
        )
    let folded_result: Outcome<i32, bool> = sync folded
    let chained: Async<(), (), i32, bool> =
        asyncCompositionArtifactCompletes(112)~>chain(
            |value: i32| -> Async<(), (), i32, bool> asyncCompositionArtifactCompletes(value + 1)
        )
    let chained_result: Outcome<i32, bool> = sync chained
    return true
}

public procedure asyncCompositionUntilArtifactReference() -> Outcome<i32, !> {
    var cell: shared AsyncCompositionArtifactCell =
        AsyncCompositionArtifactCell { value: 113 }
    let completed: Async<(), (), i32, !> = cell~>until(
        |value: const AsyncCompositionArtifactCell| -> bool value.value == 113,
        |value: unique AsyncCompositionArtifactCell| -> i32 value.value + 1
    )
    return sync completed
}

public procedure asyncKeyYieldReleaseArtifactReference(
    value: i32
) -> Async<i32, i32, i32, bool> {
    var shared_value: shared i32 = value
    %read shared_value {
        let resumed: i32 = yield release value
        return resumed
    }
}

public procedure asyncKeyYieldReleaseFromArtifactReference(
    value: i32
) -> Async<i32, i32, i32, bool> {
    var shared_value: shared i32 = value
    %read shared_value {
        let resumed: i32 = yield release from asyncKeyArtifactSuspends(value)
        return resumed + 1
    }
}

public procedure asyncKeyYieldReleaseFailureArtifactReference(
    value: i32
) -> Async<i32, i32, i32, bool> {
    var shared_value: shared i32 = value
    %read shared_value {
        let result: i32 = yield release from asyncKeyArtifactFails(value)
        return result
    }
}

