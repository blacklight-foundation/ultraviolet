public procedure statementLoweringEvidenceReference() -> i32 {
    var total: i32 = 0
    let let_value: i32 = 1
    var var_value: i32 = 2
    var_value += let_value
    total = total + var_value

    using total as total_alias
    total_alias = total_alias + 1

    statementLoweringEvidenceSink(total)

    if total >= 0 {
    }

    let valued_break: i32 = loop true {
        break 4
    }
    total = total + valued_break

    var loop_index: i32 = 0
    loop {
        loop_index = loop_index + 1
        if loop_index == 2 {
            continue
        }
        total = total + loop_index
        if loop_index >= 3 {
            break
        }
    }

    {
        defer {
            total = total + 5
        }
        total = total + 1
    }

    region as scratch {
        frame {
            total = total + 1
        }
        scratch.frame {
            total = total + 1
        }
    }

    unsafe {
        total = total + 1
    }

    return total
}

