public procedure controlLoweringReference(
    flag: bool,
    input: ControlLoweringUnion
) -> i32 {
    let if_value: i32 = if flag {
        1
    } else {
        2
    }

    let if_is_value: i32 = if input is value: i32 {
        value
    } else {
        3
    }

    let if_cases_value: i32 = if input is {
        value: i32 {
            value
        }
        case_flag: bool {
            if case_flag {
                4
            } else {
                5
            }
        }
    }

    var infinite_count: i32 = 0
    loop {
        infinite_count = infinite_count + 1
        if infinite_count == 1 {
            break
        }
    }

    var conditional_count: i32 = 0
    loop conditional_count < 1 {
        conditional_count = conditional_count + 1
    }

    let iter_values: [i32; 2] = [1, 2]
    var iter_total: i32 = 0
    loop value: i32 in iter_values {
        iter_total = iter_total + value
    }

    let block_value: i32 = {
        let local_value: i32 = 6
        local_value + 1
    }

    return if_value +
        if_is_value +
        if_cases_value +
        infinite_count +
        conditional_count +
        iter_total +
        block_value
}

public procedure operatorUnaryTypingReference(
    flag: bool,
    value: i32,
    float_value: f64
) -> bool {
    let logical_not: bool = !flag
    let bitwise_not: i32 = !value
    let negative_int: i32 = -value
    let negative_float: f64 = -float_value

    return logical_not ||
        bitwise_not == negative_int ||
        negative_float < 0.0f64
}

public procedure operatorBinaryTypingReference(
    left: i32,
    right: i32,
    shift_count: u32,
    left_flag: bool,
    right_flag: bool
) -> bool {
    let arithmetic: i32 = left + right
    let bitwise: i32 = left & right
    let shifted: i32 = left << shift_count
    let equal: bool = left == right
    let ordered: bool = left < right
    let logical: bool = left_flag && right_flag

    return arithmetic != bitwise ||
        shifted == left ||
        equal ||
        ordered ||
        logical
}
