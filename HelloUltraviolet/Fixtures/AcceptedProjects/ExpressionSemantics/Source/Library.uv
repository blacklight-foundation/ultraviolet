public procedure operatorRangeTypingReference() -> i32 {
    let values: [i32; 5] = [10, 20, 30, 40, 50]
    let full: [i32] = values[..]
    let to: [i32] = values[..3usize]
    let to_inclusive: [i32] = values[..=2usize]
    let from_slice: [i32] = values[2usize..]
    let exclusive: [i32] = values[1usize..3usize]
    let inclusive: [i32] = values[1usize..=3usize]

    return full[0usize] +
        to[1usize] +
        to_inclusive[2usize] +
        from_slice[0usize] +
        exclusive[1usize] +
        inclusive[2usize]
}

